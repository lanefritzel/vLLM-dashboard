# vLLM Dashboard — environment file
# Copy to .env (never commit .env). All values have defaults shown.

COMPOSE_PROJECT_NAME=vllm-dashboard

# Dashboard published port
DASHBOARD_PORT=8080

# PostgreSQL (internal, not published)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=dashboard
DB_USER=dashboard
DB_PASSWORD=<change-me>

# Default Docker Engine API host for hot-swap (per-source override in Settings)
# e.g. tcp://tes.home:2375  (unauthenticated) or tcp://tes.home:2376 (TLS)
DOCKER_HOST=

# First-run seed defaults (editable later in Settings)
VLLM_URL=http://tes.home:9999
VLLM_INFERENCE_URL=http://tes.home:9999
OLLAMA_URL=http://serenity.home:11434

# Runtime
ASPNETCORE_ENVIRONMENT=Production
