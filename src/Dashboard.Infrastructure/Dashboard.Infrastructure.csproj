<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- For the DeploymentHub SignalR hub (P10b), which lives here instead of
         Dashboard.Application since it's broadcast from DeploymentEventApplier. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- DependencyInjection/Hosting/Http/Logging Abstractions are all already
         carried by the Microsoft.AspNetCore.App FrameworkReference above. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dashboard.Core\Dashboard.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets Dashboard.Core.Tests unit-test internal, pure helpers (e.g.
         DockerOrchestrator.BuildCreatePayload) without a live Docker daemon. -->
    <InternalsVisibleTo Include="Dashboard.Core.Tests" />
    <!-- P01b's golden test needs BuildCreatePayload as the oracle, alongside the
         (DB-backed) conversion routine tests that already live in this project. -->
    <InternalsVisibleTo Include="Dashboard.Infrastructure.Tests" />
  </ItemGroup>

</Project>
