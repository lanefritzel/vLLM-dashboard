@* UiSelect — native select with the themed chevron from tokens.css (Style
   Refactor P1.2). ChildContent is the <option> list. Supports @bind-Value. *@
<select class="ui-select"
        id="@Id"
        value="@Value"
        disabled="@Disabled"
        aria-invalid="@(Invalid ? "true" : null)"
        aria-describedby="@(Invalid ? $"{Id}-error" : null)"
        @onchange="@(e => ValueChanged.InvokeAsync(e.Value?.ToString() ?? ""))"
        @attributes="AdditionalAttributes">
    @ChildContent
</select>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Invalid { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object> AdditionalAttributes { get; set; } = new();
}
