@* Toolbar — search/filters/actions band above content (Style Refactor P1.2).
   Set Attached when it sits directly above a table, for the bottom border. *@
<div class="ui-toolbar @(Attached ? "ui-toolbar-attached" : "")">
    @if (Search is not null)
    {
        <div class="ui-toolbar-search">@Search</div>
    }
    @if (Filters is not null)
    {
        <div class="ui-toolbar-filters">@Filters</div>
    }
    <div class="ui-toolbar-spacer"></div>
    @if (Actions is not null)
    {
        <div class="ui-toolbar-actions">@Actions</div>
    }
</div>

@code {
    [Parameter] public RenderFragment? Search { get; set; }
    [Parameter] public RenderFragment? Filters { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public bool Attached { get; set; }
}
