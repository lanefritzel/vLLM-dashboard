@using Dashboard.Core.Abstractions
@using Dashboard.Core.Models
@inject ISourceCatalog Sources
@inject ILaunchSpecStore LaunchSpecs
@inject IPhysicalServerCatalog Servers
@inject IJSRuntime JS

@if (_addingNewServer)
{
    <Dashboard.Web.Components.Wizards.PhysicalServerSetupWizard
        OnCancelled="@(() => _addingNewServer = false)"
        OnSaved="@OnNewPhysicalServerSavedAsync" />
}
else
{
    <div class="modal-overlay" @onclick="@RequestCancel">
        <div class="modal-dialog-custom" @onclick:stopPropagation="true">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <div class="card-title mb-0">vLLM Instance Setup Wizard — step @_step of 3</div>
                <button type="button" class="modal-close-btn" @onclick="@RequestCancel" aria-label="Close">✕</button>
            </div>
            <div class="text-muted small mb-2">
                New to this? See the <a href="help" target="_blank">Help page</a> for a full walkthrough with example values.
            </div>

            <div class="wizard-steps mb-3 text-muted small">
                @for (var i = 1; i <= 3; i++)
                {
                    var label = i switch { 1 => "Physical server", 2 => "Image", _ => "Review" };
                    <span class="@(i == _step ? "fw-bold text-body" : "")">@i. @label</span>
                    @if (i < 3) { <text> &nbsp;→&nbsp; </text> }
                }
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger py-2">@_error</div>
            }

            @if (_step == 1)
            {
                <p class="text-muted small">
                    Which physical (or virtual) machine will run this vLLM instance's container? Its Docker
                    host, GPU, and Hugging Face cache directory come from there — shared with any other vLLM
                    instance already on that same machine.
                </p>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Label</label>
                        <input class="form-control" @bind="_label" placeholder="e.g. Qwen instance" />
                        <div class="form-text">A friendly name for this vLLM instance, shown throughout the dashboard. Just for your own reference.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Physical server</label>
                        @if (_physicalServers.Count == 0)
                        {
                            <div class="alert alert-warning py-2 mb-0">
                                No physical servers configured yet.
                                <button type="button" class="btn btn-link btn-sm p-0" @onclick="@(() => _addingNewServer = true)">Add one now</button>
                            </div>
                        }
                        else
                        {
                            <select class="form-select" @bind="_physicalServerId">
                                <option value="">-- choose a physical server --</option>
                                @foreach (var p in _physicalServers)
                                {
                                    <option value="@p.Id">@p.Label (@p.DockerHost)</option>
                                }
                            </select>
                            <div class="form-text">
                                <button type="button" class="btn btn-link btn-sm p-0" @onclick="@(() => _addingNewServer = true)">Or add a new physical server</button>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (_step == 2)
            {
                <p class="text-muted small">
                    This instance's own container settings — the image, port, and how the dashboard reaches
                    it. A model on this instance can override the image, but this default must still be valid.
                </p>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Image</label>
                        <input class="form-control" @bind="_image" placeholder="vllm/vllm-openai:latest" />
                        <div class="form-text">The Docker image that runs the inference backend itself (e.g. vLLM) — not a specific model's weights.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Container name <span class="text-muted">(optional)</span></label>
                        <input class="form-control" @bind="_containerName" placeholder="(default: label)" />
                        <div class="form-text">The name Docker gives this container. Leave blank and one is generated from the Label above.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Serving port</label>
                        <input class="form-control" type="number" min="1" @bind="_servingPort" @bind:after="@SuggestInferenceUrl" />
                        <div class="form-text">The port the backend listens on inside the container for API requests (commonly 8000 for vLLM).</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Inference URL <span class="text-muted">(vLLM /v1 base)</span></label>
                        <input class="form-control" @bind="_inferenceUrl" placeholder="http://servername-or-ip:8000" />
                        <div class="form-text">Where the dashboard actually reaches this instance's API — usually the physical server's address with the serving port above.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Metrics URL <span class="text-muted">(/metrics endpoint)</span></label>
                        <input class="form-control" @bind="_metricsUrl" placeholder="http://servername-or-ip:8000" />
                        <div class="form-text">Usually the same as the inference URL.</div>
                    </div>
                </div>
            }
            else if (_step == 3)
            {
                <p class="text-muted small">Review before saving. You can go back and change anything.</p>
                <ul class="list-unstyled small">
                    <li><strong>Label:</strong> @NoneIfBlank(_label)</li>
                    <li><strong>Physical server:</strong> @(SelectedServer?.Label ?? "(not set)")</li>
                    <li><strong>Image:</strong> @NoneIfBlank(_image)</li>
                    <li><strong>Container name:</strong> @(string.IsNullOrWhiteSpace(_containerName) ? "(defaults to label)" : _containerName)</li>
                    <li><strong>Serving port:</strong> @(_servingPort?.ToString() ?? "(none)")</li>
                    <li><strong>Inference URL:</strong> @NoneIfBlank(_inferenceUrl)</li>
                    <li><strong>Metrics URL:</strong> @NoneIfBlank(_metricsUrl)</li>
                </ul>

                @if (MissingItems().Count > 0)
                {
                    <div class="alert alert-warning py-2">
                        <div class="mb-1">This setup isn't complete yet:</div>
                        <ul class="mb-0">
                            @foreach (var m in MissingItems())
                            {
                                <li>@m</li>
                            }
                        </ul>
                    </div>
                }
            }

            <div class="mt-3 d-flex justify-content-between align-items-center">
                <div>
                    @if (_step > 1)
                    {
                        <button type="button" class="btn btn-secondary btn-sm me-2" @onclick="@(() => _step--)">Back</button>
                    }
                    <button type="button" class="btn btn-link btn-sm text-muted p-0" disabled="@_busy" @onclick="@SwitchToAdvancedAsync">
                        Switch to Advanced
                    </button>
                </div>
                <div>
                    <button type="button" class="btn btn-secondary btn-sm me-2" @onclick="@RequestCancel">Cancel</button>
                    @if (_step < 3)
                    {
                        <button type="button" class="btn btn-primary btn-sm" @onclick="@(() => _step++)">Next</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="@SaveAsync">
                            @(_busy ? "Saving…" : "Save")
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnCancelled { get; set; }
    [Parameter] public EventCallback<SourceInfo> OnSaved { get; set; }
    [Parameter] public EventCallback<SourceInfo> OnSwitchToAdvanced { get; set; }

    private int _step = 1;
    private bool _busy;
    private string? _error;
    private bool _addingNewServer;

    private List<PhysicalServerInfo> _physicalServers = new();
    private string _physicalServerId = "";

    private string _label = "";
    private string _image = "vllm/vllm-openai:latest";
    private string _containerName = "";
    private int? _servingPort = 8000;
    private string _inferenceUrl = "";
    private string _metricsUrl = "";

    private PhysicalServerInfo? SelectedServer => _physicalServers.FirstOrDefault(p => p.Id == _physicalServerId);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _physicalServers = (await Servers.GetAllAsync()).ToList();
        }
        catch (Exception ex)
        {
            _error = "Could not load physical servers: " + ex.Message;
        }
    }

    private async Task OnNewPhysicalServerSavedAsync(PhysicalServerInfo saved)
    {
        _addingNewServer = false;
        _physicalServers = (await Servers.GetAllAsync()).ToList();
        _physicalServerId = saved.Id;
        SuggestInferenceUrl();
        _step = 2;
    }

    private static string NoneIfBlank(string s) => string.IsNullOrWhiteSpace(s) ? "(not set)" : s;

    /// <summary>Best-effort default so the instance isn't silently left with no working
    /// inference/metrics URL — the Docker API port and the vLLM serving port are
    /// different things, so this is a starting guess, not a substitute for
    /// confirmation. Never overwrites a value the user already typed.</summary>
    private void SuggestInferenceUrl()
    {
        if (!string.IsNullOrWhiteSpace(_inferenceUrl) || SelectedServer is not { } server)
            return;

        var host = server.DockerHost.Trim();
        foreach (var scheme in new[] { "tcp://", "http://", "https://" })
        {
            if (host.StartsWith(scheme, StringComparison.OrdinalIgnoreCase))
                host = host[scheme.Length..];
        }
        var hostname = host.Split(':', '/')[0];
        if (string.IsNullOrWhiteSpace(hostname)) return;

        var suggested = $"http://{hostname}:{_servingPort ?? 8000}";
        _inferenceUrl = suggested;
        if (string.IsNullOrWhiteSpace(_metricsUrl))
            _metricsUrl = suggested;
    }

    private List<string> MissingItems()
    {
        var missing = new List<string>();
        if (string.IsNullOrWhiteSpace(_label)) missing.Add("Label");
        if (string.IsNullOrWhiteSpace(_physicalServerId)) missing.Add("Physical server — hot-swap won't work without one");
        if (string.IsNullOrWhiteSpace(_image)) missing.Add("Image");
        if (string.IsNullOrWhiteSpace(_inferenceUrl)) missing.Add("Inference URL — without this the dashboard can't reach this instance's API at all");
        return missing;
    }

    private async Task RequestCancel()
    {
        await OnCancelled.InvokeAsync();
    }

    /// <summary>Creates the source + launch spec from whatever's been entered so far.
    /// Shared by the normal Save flow and by Switch-to-Advanced — both write exactly
    /// the same record, so the advanced form that opens afterward reflects precisely
    /// what the wizard had, with no separate field-mapping code path to drift.</summary>
    private async Task<SourceInfo> PersistAsync()
    {
        var source = new SourceInfo
        {
            Id = Guid.NewGuid().ToString(),
            Label = _label.Trim(),
            Slug = Slug.From(_label),
            Type = SourceType.Vllm,
            MetricsUrl = _metricsUrl.Trim(),
            InferenceUrl = _inferenceUrl.Trim(),
            PhysicalServerId = string.IsNullOrWhiteSpace(_physicalServerId) ? null : _physicalServerId,
            ContainerName = string.IsNullOrWhiteSpace(_containerName) ? null : _containerName.Trim(),
            ScrapeIntervalSeconds = 5,
            Active = true,
        };
        var saved = await Sources.CreateAsync(source);

        var spec = new LaunchSpec
        {
            Id = Guid.NewGuid().ToString(),
            SourceId = saved.Id,
            Image = _image.Trim(),
            ServingPort = _servingPort,
        };
        await LaunchSpecs.SaveAsync(spec);

        return saved;
    }

    private async Task SaveAsync()
    {
        if (_busy) return;
        if (string.IsNullOrWhiteSpace(_label))
        {
            _error = "Label is required.";
            _step = 1;
            return;
        }

        var missing = MissingItems();
        if (missing.Count > 0)
        {
            var proceed = await JS.InvokeAsync<bool>("confirm",
                "This setup isn't complete yet:\n\n" + string.Join("\n", missing.Select(m => "- " + m)) +
                "\n\nSave anyway? You can come back and finish it later.");
            if (!proceed) return;
        }

        _busy = true;
        _error = null;
        try
        {
            var saved = await PersistAsync();
            await OnSaved.InvokeAsync(saved);
        }
        catch (Exception ex)
        {
            _error = "Save failed: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Persists whatever's been entered so far (no completeness confirm —
    /// choosing Advanced already means "let me finish this myself") and hands off to
    /// the real Edit form loaded from that record.</summary>
    private async Task SwitchToAdvancedAsync()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            var saved = await PersistAsync();
            await OnSwitchToAdvanced.InvokeAsync(saved);
        }
        catch (Exception ex)
        {
            _error = "Could not switch to the advanced form: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
