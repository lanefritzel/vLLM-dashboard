@using Dashboard.Core.Abstractions
@using Dashboard.Core.Models
@inject ISourceCatalog Sources
@inject IModelCatalog Models
@inject IPhysicalServerCatalog Servers
@inject IHuggingFaceModelLookup HfLookup
@inject IJSRuntime JS

<div class="modal-overlay" @onclick="@RequestCancel">
    <div class="modal-dialog-custom" @onclick:stopPropagation="true">
        <div class="d-flex align-items-center justify-content-between mb-1">
            <div class="card-title mb-0">Model Setup Wizard — step @DisplayStep of @DisplayTotalSteps</div>
            <button type="button" class="modal-close-btn" @onclick="@RequestCancel" aria-label="Close">✕</button>
        </div>
        <div class="text-muted small mb-2">
            New to this? See the <a href="help" target="_blank">Help page</a> for a full walkthrough with example values.
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger py-2">@_error</div>
        }

        @if (_loading)
        {
            <p class="text-muted">Loading…</p>
        }
        else if (_step == StepPickServer)
        {
            <p class="text-muted small">
                Which vLLM instance is this for? The model gets registered on that instance's physical
                server — shared with any other instance on the same server — and becomes this instance's
                active model if it doesn't have one yet.
            </p>
            @if (_sources.Count == 0)
            {
                <div class="alert alert-warning py-2">
                    No vLLM instances configured yet. Use the vLLM Instance Setup Wizard first.
                </div>
            }
            else
            {
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">vLLM instance</label>
                        <select class="form-select" @bind="_sourceId">
                            <option value="">-- choose an instance --</option>
                            @foreach (var s in _sources)
                            {
                                <option value="@s.Id">@s.Label</option>
                            }
                        </select>
                    </div>
                </div>
            }
        }
        else if (_step == StepRepo)
        {
            <p class="text-muted small">
                Where do this model's weights come from? For a Hugging Face repo, we'll look up what it
                actually is before you commit to any settings.
            </p>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Source</label>
                    <select class="form-select" @bind="_modelSource">
                        <option value="@ModelSource.HuggingFace">Hugging Face repo</option>
                        <option value="@ModelSource.LocalPath">Local path</option>
                    </select>
                    <div class="form-text">"Hugging Face repo" downloads the model's weights automatically the first time it's loaded. "Local path" uses weights you've already placed on the server's disk.</div>
                </div>
                <div class="col-md-8">
                    <label class="form-label">@(_modelSource == ModelSource.HuggingFace ? "Repo id" : "Host path")</label>
                    <input class="form-control" @bind="_repoOrPath" @bind:event="oninput" @bind:after="@DebouncedLookupAsync"
                        placeholder="@(_modelSource == ModelSource.HuggingFace ? "org/repo-name" : "/path/to/weights")" />
                    <div class="form-text">
                        @if (_modelSource == ModelSource.HuggingFace)
                        {
                            <span>The Hugging Face repo id exactly as it appears in the model's URL, e.g. "meta-llama/Llama-3.1-8B-Instruct".</span>
                        }
                        else
                        {
                            <span>The folder on the server's own disk (not this dashboard's disk) where the model's weight files already live.</span>
                        }
                    </div>
                </div>
                <div class="col-md-8">
                    <label class="form-label">Served model name</label>
                    <input class="form-control" @bind="_name" @bind:event="oninput" placeholder="e.g. my-model" />
                    <div class="form-text">The name API clients will request this model by.</div>
                </div>
            </div>

            @if (_modelSource == ModelSource.HuggingFace && !string.IsNullOrWhiteSpace(_repoOrPath))
            {
                @if (_lookupBusy)
                {
                    <div class="text-muted small mt-2">Looking up @_repoOrPath on Hugging Face…</div>
                }
                else if (_lookupFailed)
                {
                    <div class="text-warning small mt-2">Couldn't look this repo up — you can still continue and set everything manually.</div>
                }
                else if (_lookup is not null)
                {
                    <div class="card mt-2" style="border-left: 3px solid var(--green);">
                        <div class="card-body py-2 small">
                            <div><strong>Parameters:</strong> @FormatParamCount(_lookup.ParameterCount)</div>
                            <div>
                                <strong>Quantized:</strong>
                                @(_lookup.IsQuantized ? $"Yes ({_lookup.QuantizationMethod ?? "method unspecified"})" : "No — full precision")
                            </div>
                            <div><strong>Default context length:</strong> @(_lookup.DefaultMaxContextLength?.ToString("N0") ?? "unknown") tokens</div>
                        </div>
                    </div>
                }
            }
        }
        else if (_step == StepRecommend)
        {
            <p class="text-muted small">
                Suggestions based on the lookup and this server's stated VRAM. Everything here is editable —
                these are recommendations, not requirements.
            </p>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Context length (max-model-len)</label>
                    <input class="form-control" type="number" min="1" @bind="_maxModelLen" />
                    <div class="form-text">
                        @if (_lookup?.DefaultMaxContextLength is { } def)
                        {
                            <span>This model's own default is @def.ToString("N0") tokens. Leaving this unset means vLLM uses that default — the exact gap that let a 262,144-token context silently load and help exhaust a host's memory. Set an explicit, smaller value unless you actually need the full window.</span>
                        }
                        else
                        {
                            <span>Leave blank to use the model's own built-in default (unknown here — couldn't be looked up).</span>
                        }
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">GPU memory utilization</label>
                    <input class="form-control" type="number" min="0" max="1" step="0.05" @bind="_gpuMemUtil" />
                    <div class="form-text">
                        @if (_sourceVramGb is { } vram)
                        {
                            <span>Fraction of this server's stated @vram GB VRAM vLLM may claim. Leave blank and vLLM defaults to 0.90 (@((vram * 0.9).ToString("0.#")) GB) on its own.</span>
                        }
                        else
                        {
                            <span>Fraction of GPU VRAM vLLM may claim (0-1). Leave blank for vLLM's own default of 0.90. This server has no VRAM total on record, so no size warning can be shown here.</span>
                        }
                    </div>
                </div>
                <div class="col-md-12">
                    @if (_modelSource == ModelSource.HuggingFace && _lookup is not null && !_lookup.IsQuantized)
                    {
                        <div class="alert alert-warning py-2">
                            This repo isn't already quantized. Either set a Quantization method on the Advanced
                            page after saving, or
                            <a href="@HfQuantizedSearchUrl()" target="_blank" rel="noopener">search Hugging Face for a quantized variant</a>
                            of this model instead.
                        </div>
                    }
                    else if (_modelSource == ModelSource.HuggingFace && _lookup is { IsQuantized: true })
                    {
                        <div class="alert alert-success py-2">
                            Already quantized (@(_lookup.QuantizationMethod ?? "method unspecified")) — no extra quantization flag needed.
                        </div>
                    }
                </div>
            </div>
        }
        else if (_step == StepReview)
        {
            <p class="text-muted small">Review before saving. You can go back and change anything.</p>
            <ul class="list-unstyled small">
                <li><strong>vLLM instance:</strong> @(_sources.FirstOrDefault(s => s.Id == _sourceId)?.Label ?? "(not set)")</li>
                <li><strong>Served model name:</strong> @NoneIfBlank(_name)</li>
                <li><strong>Source:</strong> @_modelSource — @NoneIfBlank(_repoOrPath)</li>
                <li><strong>Context length:</strong> @(_maxModelLen?.ToString("N0") ?? "(model default)")</li>
                <li><strong>GPU memory utilization:</strong> @(_gpuMemUtil?.ToString("0.##") ?? "(vLLM default 0.90)")</li>
            </ul>

            @if (MissingItems().Count > 0)
            {
                <div class="alert alert-warning py-2">
                    <div class="mb-1">This setup isn't complete yet:</div>
                    <ul class="mb-0">
                        @foreach (var m in MissingItems())
                        {
                            <li>@m</li>
                        }
                    </ul>
                </div>
            }
        }

        <div class="mt-3 d-flex justify-content-between align-items-center">
            <div>
                @if (_step > FirstStep)
                {
                    <button type="button" class="btn btn-secondary btn-sm me-2" @onclick="@Back">Back</button>
                }
                @if (_step != StepPickServer)
                {
                    <button type="button" class="btn btn-link btn-sm text-muted p-0" disabled="@_busy" @onclick="@SwitchToAdvancedAsync">
                        Switch to Advanced
                    </button>
                }
            </div>
            <div>
                <button type="button" class="btn btn-secondary btn-sm me-2" @onclick="@RequestCancel">Cancel</button>
                @if (_step < StepReview)
                {
                    <button type="button" class="btn btn-primary btn-sm" disabled="@(!CanAdvance())" @onclick="@Next">Next</button>
                }
                else
                {
                    <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="@SaveAsync">
                        @(_busy ? "Saving…" : "Save")
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? PreselectedSourceId { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }
    [Parameter] public EventCallback<ModelInfo> OnSaved { get; set; }
    [Parameter] public EventCallback<ModelInfo> OnSwitchToAdvanced { get; set; }

    private const int StepPickServer = 0;
    private const int StepRepo = 1;
    private const int StepRecommend = 2;
    private const int StepReview = 3;

    private int FirstStep => string.IsNullOrWhiteSpace(PreselectedSourceId) ? StepPickServer : StepRepo;
    private int _step;
    private bool _loading = true;
    private bool _busy;
    private string? _error;

    private List<SourceInfo> _sources = new();
    private string _sourceId = "";
    private int? _sourceVramGb;

    private ModelSource _modelSource = ModelSource.HuggingFace;
    private string _repoOrPath = "";
    private string _name = "";

    private HuggingFaceModelInfo? _lookup;
    private bool _lookupBusy;
    private bool _lookupFailed;

    private int? _maxModelLen;
    private double? _gpuMemUtil;

    private int DisplayStep => _step - FirstStep + 1;
    private int DisplayTotalSteps => StepReview - FirstStep + 1;

    protected override async Task OnInitializedAsync()
    {
        _step = FirstStep;
        try
        {
            _sources = (await Sources.GetAllAsync()).Where(s => s.Type == SourceType.Vllm).ToList();
        }
        catch (Exception ex)
        {
            _error = "Could not load servers: " + ex.Message;
        }

        if (!string.IsNullOrWhiteSpace(PreselectedSourceId))
        {
            _sourceId = PreselectedSourceId;
            await LoadSourceVramAsync();
        }
        _loading = false;
    }

    private async Task LoadSourceVramAsync()
    {
        _sourceVramGb = null;
        var server = _sources.FirstOrDefault(s => s.Id == _sourceId)?.PhysicalServerId;
        if (string.IsNullOrWhiteSpace(server)) return;
        try
        {
            var info = await Servers.GetByIdAsync(server);
            _sourceVramGb = info?.GpuVramTotalGb;
        }
        catch
        {
            _sourceVramGb = null;
        }
    }

    private static string NoneIfBlank(string s) => string.IsNullOrWhiteSpace(s) ? "(not set)" : s;

    private static string FormatParamCount(long? count) => count switch
    {
        null => "unknown",
        >= 1_000_000_000 => $"{count.Value / 1_000_000_000.0:0.#}B",
        >= 1_000_000 => $"{count.Value / 1_000_000.0:0.#}M",
        _ => count.Value.ToString("N0"),
    };

    private string HfQuantizedSearchUrl() =>
        $"https://huggingface.co/models?search={Uri.EscapeDataString(_repoOrPath.Trim())}+quantized";

    private bool CanAdvance() => _step switch
    {
        StepPickServer => !string.IsNullOrWhiteSpace(_sourceId),
        StepRepo => !string.IsNullOrWhiteSpace(_repoOrPath) && !string.IsNullOrWhiteSpace(_name),
        _ => true,
    };

    private List<string> MissingItems()
    {
        var missing = new List<string>();
        if (string.IsNullOrWhiteSpace(_sourceId)) missing.Add("Server");
        if (string.IsNullOrWhiteSpace(_name)) missing.Add("Served model name");
        if (string.IsNullOrWhiteSpace(_repoOrPath)) missing.Add(_modelSource == ModelSource.HuggingFace ? "Repo id" : "Local path");
        if (_modelSource == ModelSource.HuggingFace && _maxModelLen is null)
            missing.Add("Context length not set — will inherit this model's own (possibly huge) default");
        if (_modelSource == ModelSource.HuggingFace && _lookup is { IsQuantized: false })
            missing.Add("This repo isn't quantized and no quantization method is set");
        return missing;
    }

    private async Task Next()
    {
        if (_step == StepPickServer)
            await LoadSourceVramAsync();
        _step++;
    }

    private void Back() => _step--;

    private CancellationTokenSource? _lookupDebounce;

    /// <summary>The repo id field updates on every keystroke (so the Next button's
    /// CanAdvance check reacts immediately, matching the served-model-name field) but
    /// the Hugging Face lookup itself still waits for a short pause in typing rather
    /// than firing per keystroke.</summary>
    private async Task DebouncedLookupAsync()
    {
        _lookupDebounce?.Cancel();
        var cts = new CancellationTokenSource();
        _lookupDebounce = cts;
        try
        {
            await Task.Delay(400, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        if (cts.IsCancellationRequested) return;
        await TriggerLookupAsync();
    }

    private async Task TriggerLookupAsync()
    {
        if (_modelSource != ModelSource.HuggingFace || string.IsNullOrWhiteSpace(_repoOrPath))
        {
            _lookup = null;
            _lookupFailed = false;
            return;
        }

        var repoId = _repoOrPath.Trim();
        if (_lookup?.RepoId == repoId) return;

        _lookupBusy = true;
        _lookupFailed = false;
        StateHasChanged();
        try
        {
            _lookup = await HfLookup.LookupAsync(repoId);
            _lookupFailed = _lookup is null;
            if (_lookup?.DefaultMaxContextLength is { } def && _maxModelLen is null)
            {
                // Prefill with a sane suggestion, not the raw (possibly huge) default —
                // the whole point is never silently inheriting an oversized window again.
                _maxModelLen = Math.Min(def, 16384);
            }
        }
        catch
        {
            _lookup = null;
            _lookupFailed = true;
        }
        finally
        {
            _lookupBusy = false;
            StateHasChanged();
        }
    }

    private async Task RequestCancel() => await OnCancelled.InvokeAsync();

    /// <summary>Creates the model from whatever's been entered so far. Shared by the
    /// normal Save flow and by Switch-to-Advanced, so the advanced form that opens
    /// afterward reflects precisely what the wizard had. Models are registered on the
    /// picked instance's physical server (shared by every instance on it); the picked
    /// instance itself only matters for deciding whether to auto-activate on save.</summary>
    private async Task<ModelInfo> PersistAsync()
    {
        var options = new Dictionary<string, string>();
        if (_maxModelLen is > 0) options["max-model-len"] = _maxModelLen.Value.ToString();
        if (_gpuMemUtil is > 0) options["gpu-memory-utilization"] = _gpuMemUtil.Value.ToString("0.##");

        var source = _sources.FirstOrDefault(s => s.Id == _sourceId);
        var physicalServerId = source?.PhysicalServerId ?? "";
        var existing = string.IsNullOrWhiteSpace(physicalServerId)
            ? new List<ModelInfo>()
            : (await Models.GetByPhysicalServerAsync(physicalServerId)).ToList();
        var model = new ModelInfo
        {
            PhysicalServerId = physicalServerId,
            Name = _name.Trim(),
            ModelSource = _modelSource,
            ModelPathOrRepoId = _repoOrPath.Trim(),
            Options = options,
            SortOrder = existing.Count,
        };
        var saved = await Models.CreateAsync(model);

        // Auto-activate on save, same as before, but now judged per-instance: if the
        // instance this wizard was launched from has nothing active yet, this new
        // model becomes it — regardless of how many other models already exist on
        // the shared server catalog.
        if (source is { ActiveModelId: null })
            await Models.ActivateAsync(source.Id, saved.Id);

        return saved;
    }

    private async Task SaveAsync()
    {
        if (_busy) return;

        var missing = MissingItems();
        if (missing.Count > 0)
        {
            var proceed = await JS.InvokeAsync<bool>("confirm",
                "This setup isn't complete yet:\n\n" + string.Join("\n", missing.Select(m => "- " + m)) +
                "\n\nSave anyway? You can come back and finish it later.");
            if (!proceed) return;
        }

        _busy = true;
        _error = null;
        try
        {
            var saved = await PersistAsync();
            await OnSaved.InvokeAsync(saved);
        }
        catch (Exception ex)
        {
            _error = "Save failed: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Persists whatever's been entered so far (no completeness confirm) and
    /// hands off to the real Edit form loaded from that record. Only reachable once a
    /// server is chosen (hidden on StepPickServer), since the advanced Model form is
    /// scoped to the page's currently selected source.</summary>
    private async Task SwitchToAdvancedAsync()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            var saved = await PersistAsync();
            await OnSwitchToAdvanced.InvokeAsync(saved);
        }
        catch (Exception ex)
        {
            _error = "Could not switch to the advanced form: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
