@using Dashboard.Core.Abstractions
@using Dashboard.Core.Models
@inject ISourceCatalog Sources

@if (_loading)
{
    <div class="modal-overlay">
        <div class="modal-dialog-custom">
            <p class="text-muted">Loading…</p>
        </div>
    </div>
}
else if (_phase == Phase.Server)
{
    <ServerSetupWizard OnCancelled="@OnCancelledAsync" OnSaved="@OnServerSavedAsync" OnSwitchToAdvanced="@OnSwitchToAdvancedSourceAsync" />
}
else if (_phase == Phase.Model)
{
    <ModelSetupWizard PreselectedSourceId="@_preselectedSourceId" OnCancelled="@OnCancelledAsync" OnSaved="@OnModelSavedAsync" OnSwitchToAdvanced="@OnSwitchToAdvancedModelAsync" />
}

@code {
    // The full wizard is just the Server and Model wizards run back to back —
    // it skips the Server step only when a usable vLLM source already exists.
    private enum Phase { Server, Model }

    [Parameter] public EventCallback OnCancelled { get; set; }
    [Parameter] public EventCallback<ModelInfo> OnSaved { get; set; }

    /// <summary>Forwarded straight through from whichever sub-wizard is currently
    /// showing — the Server phase's hand-off stays on Settings (the same shape as the
    /// standalone Server wizard), the Model phase's needs the caller to navigate to
    /// the Models page since that's where the advanced Model form lives.</summary>
    [Parameter] public EventCallback<SourceInfo> OnSwitchToAdvancedSource { get; set; }
    [Parameter] public EventCallback<ModelInfo> OnSwitchToAdvancedModel { get; set; }

    private bool _loading = true;
    private Phase _phase;
    private string? _preselectedSourceId;

    protected override async Task OnInitializedAsync()
    {
        var hasServer = false;
        try
        {
            hasServer = (await Sources.GetAllAsync()).Any(s => s.Type == SourceType.Vllm);
        }
        catch
        {
            hasServer = false;
        }
        _phase = hasServer ? Phase.Model : Phase.Server;
        _loading = false;
    }

    private async Task OnCancelledAsync() => await OnCancelled.InvokeAsync();

    private void OnServerSavedAsync(SourceInfo saved)
    {
        _preselectedSourceId = saved.Id;
        _phase = Phase.Model;
    }

    private async Task OnModelSavedAsync(ModelInfo saved) => await OnSaved.InvokeAsync(saved);

    private async Task OnSwitchToAdvancedSourceAsync(SourceInfo saved) => await OnSwitchToAdvancedSource.InvokeAsync(saved);

    private async Task OnSwitchToAdvancedModelAsync(ModelInfo saved) => await OnSwitchToAdvancedModel.InvokeAsync(saved);
}
