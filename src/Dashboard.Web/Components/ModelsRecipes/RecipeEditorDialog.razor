@using Dashboard.Core.Models
@using Dashboard.Infrastructure.Persistence.V2
@inject IRecipeService Recipes

<Dialog Title="@($"{(IsNew ? "New recipe" : "Edit recipe")} — {Model.Name}")" Size="lg"
        Open="true" OpenChanged="@(open => { if (!open) _ = RequestCancel(); })"
        Footer="@DialogFooter">
    @if (!string.IsNullOrEmpty(_error))
    {
        <Callout Tone="danger">@_error</Callout>
    }

    @if (_hardBlocks.Count > 0)
    {
        <Callout Tone="danger">
            <ul style="margin:0; padding-left: 1.1em;">
                @foreach (var issue in _hardBlocks)
                {
                    <li>@issue</li>
                }
            </ul>
        </Callout>
    }
    @if (_softWarnings.Count > 0)
    {
        <Callout Tone="warn">
            <ul style="margin:0; padding-left: 1.1em;">
                @foreach (var issue in _softWarnings)
                {
                    <li>@issue</li>
                }
            </ul>
        </Callout>
    }

    <form id="recipe-form" @onsubmit="SaveAsync" @onsubmit:preventDefault="true" class="row g-3">
        <div class="col-md-12"><div class="card-title mb-0">Identity</div></div>
        <div class="col-md-4">
            <UiField Label="Name" For="rc-name">
                <UiInput Id="rc-name" Value="@_name" ValueChanged="@(v => { _name = v; _ = RevalidateAsync(); })" />
            </UiField>
        </div>
        <div class="col-md-8">
            <UiField Label="Description" For="rc-description">
                <UiInput Id="rc-description" Value="@(_description ?? "")" ValueChanged="@(v => _description = v)" />
            </UiField>
        </div>
        <div class="col-md-6">
            <UiField Label="Served model name" For="rc-served-name"
                     Hint="@ServedNameHint">
                <UiInput Id="rc-served-name" Value="@_servedModelName" ValueChanged="@(v => { _servedModelName = v; _ = RevalidateAsync(); })" />
            </UiField>
        </div>

        <div class="col-md-12"><div class="card-title mb-0">@(EngineCapabilities.HasTuningDials(Engine) ? "Sizing & memory" : "Sizing")</div></div>
        <div class="col-md-4">
            <UiField Label="@MaxLenLabel" For="rc-max-len">
                <UiInput Id="rc-max-len" Type="number" Value="@_maxModelLen.ToString()" ValueChanged="@(v => { _maxModelLen = int.TryParse(v, out var n) ? n : _maxModelLen; _ = RevalidateAsync(); })" />
            </UiField>
        </div>
        @if (EngineCapabilities.HasTuningDials(Engine))
        {
            <div class="col-md-4">
                <UiField Label="GPU memory utilization" For="rc-gpu-mem">
                    <UiInput Id="rc-gpu-mem" Type="number" step="0.01" min="0" max="1" Value="@_gpuMemoryUtilization.ToString()" ValueChanged="@(v => { _gpuMemoryUtilization = float.TryParse(v, out var n) ? n : _gpuMemoryUtilization; _ = RevalidateAsync(); })" />
                </UiField>
            </div>
            <div class="col-md-4">
                <UiField Label="KV cache dtype" For="rc-kv-dtype">
                    <UiSelect Id="rc-kv-dtype" Value="@_kvCacheDtype" ValueChanged="@(v => { _kvCacheDtype = v; _ = RevalidateAsync(); })">
                        <option value="auto">auto</option>
                        <option value="fp8_e4m3">fp8_e4m3</option>
                        <option value="float16">float16</option>
                        <option value="bfloat16">bfloat16</option>
                    </UiSelect>
                </UiField>
            </div>
            <div class="col-md-4">
                <UiField Label="Data type (--dtype)" For="rc-dtype" Hint="On the Intel stack, bfloat16 is blocked and auto warns — the reason shows above if so.">
                    <UiSelect Id="rc-dtype" Value="@_dtype" ValueChanged="@(v => { _dtype = v; _ = RevalidateAsync(); })">
                        <option value="auto">auto</option>
                        <option value="float16">float16</option>
                        <option value="bfloat16">bfloat16</option>
                    </UiSelect>
                </UiField>
            </div>

            <div class="col-md-12"><div class="card-title mb-0">Performance</div></div>
            <div class="col-md-3">
                <label class="ui-label" style="display:flex; align-items:center; gap: var(--ui-space-2);">
                    <input type="checkbox" @bind="_enforceEager" /> Enforce eager
                </label>
            </div>
            <div class="col-md-3">
                <UiField Label="Max batched tokens" For="rc-max-batched">
                    <UiInput Id="rc-max-batched" Type="number" Value="@_maxNumBatchedTokens.ToString()" ValueChanged="@(v => { _maxNumBatchedTokens = int.TryParse(v, out var n) ? n : _maxNumBatchedTokens; _ = RevalidateAsync(); })" />
                </UiField>
            </div>
            <div class="col-md-3">
                <UiField Label="Block size" For="rc-block-size">
                    <UiInput Id="rc-block-size" Type="number" Value="@_blockSize.ToString()" ValueChanged="@(v => { _blockSize = int.TryParse(v, out var n) ? n : _blockSize; _ = RevalidateAsync(); })" />
                </UiField>
            </div>
            <div class="col-md-3">
                <label class="ui-label" style="display:flex; align-items:center; gap: var(--ui-space-2); margin-bottom: 6px;">
                    <input type="checkbox" @bind="_speculativeDecoding" /> Speculative decoding
                </label>
                @if (_speculativeDecoding)
                {
                    <UiInput Id="rc-speculative-tokens" Type="number" Value="@_speculativeTokens?.ToString()" ValueChanged="@(v => _speculativeTokens = int.TryParse(v, out var n) ? n : null)" Placeholder="token count" />
                }
            </div>

            <div class="col-md-12"><div class="card-title mb-0">Tools &amp; reasoning</div></div>
            <div class="col-md-3">
                <label class="ui-label" style="display:flex; align-items:center; gap: var(--ui-space-2);">
                    <input type="checkbox" @bind="_enableAutoToolChoice" /> Auto tool choice
                </label>
            </div>
            <div class="col-md-4">
                <UiField Label="Tool call parser" For="rc-tool-parser">
                    <UiInput Id="rc-tool-parser" Value="@(_toolCallParser ?? "")" ValueChanged="@(v => _toolCallParser = v)" />
                </UiField>
            </div>
            <div class="col-md-4">
                <UiField Label="Reasoning parser" For="rc-reasoning-parser">
                    <UiInput Id="rc-reasoning-parser" Value="@(_reasoningParser ?? "")" ValueChanged="@(v => _reasoningParser = v)" />
                </UiField>
            </div>
        }

        @if (Engine == SourceType.LlamaCpp)
        {
            <div class="col-md-12"><div class="card-title mb-0">Hardware</div></div>
            <div class="col-md-4">
                <UiField Label="GPU layers (--gpu-layers)" For="rc-gpu-layers"
                         Hint="Auto lets llama.cpp decide (its own default) -- omits the flag entirely.">
                    <UiSelect Id="rc-gpu-layers" Value="@Dashboard.Core.Recipes.LlamaCppGpuLayersExtensions.ToStorage(_gpuLayers)"
                              ValueChanged="@(v => { _gpuLayers = Dashboard.Core.Recipes.LlamaCppGpuLayersExtensions.FromStorage(v); _ = RevalidateAsync(); })">
                        <option value="auto">Auto</option>
                        <option value="all">All (GPU)</option>
                        <option value="cpu">CPU only</option>
                    </UiSelect>
                </UiField>
            </div>
        }

        <div class="col-md-12">
            <details>
                <summary style="cursor:pointer" class="card-title d-inline">Advanced</summary>
                <div class="row g-2 mt-2">
                    <div class="col-md-6">
                        <div class="d-flex align-items-center justify-content-between">
                            <label class="ui-label" style="margin-bottom:4px;">Extra args</label>
                            <UiButton Variant="secondary" Size="sm" OnClick="@(() => _extraArgs.Add(("", "")))">+ Row</UiButton>
                        </div>
                        @foreach (var (row, i) in _extraArgs.Select((r, i) => (r, i)))
                        {
                            <div class="kv-row">
                                <UiInput Id="@($"rc-extra-arg-key-{i}")" Value="@row.Key" ValueChanged="@(v => _extraArgs[i] = (v, row.Value))" Placeholder="key (no --)" />
                                <UiInput Id="@($"rc-extra-arg-value-{i}")" Value="@row.Value" ValueChanged="@(v => _extraArgs[i] = (row.Key, v))" Placeholder="value (blank = flag)" />
                                <UiButton Variant="danger" Size="sm" OnClick="@(() => _extraArgs.RemoveAt(i))">✕</UiButton>
                            </div>
                        }
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-center justify-content-between">
                            <label class="ui-label" style="margin-bottom:4px;">Environment vars</label>
                            <UiButton Variant="secondary" Size="sm" OnClick="@(() => _extraEnv.Add(("", "")))">+ Row</UiButton>
                        </div>
                        @foreach (var (row, i) in _extraEnv.Select((r, i) => (r, i)))
                        {
                            <div class="kv-row">
                                <UiInput Id="@($"rc-extra-env-key-{i}")" Value="@row.Key" ValueChanged="@(v => _extraEnv[i] = (v, row.Value))" Placeholder="key" />
                                <UiInput Id="@($"rc-extra-env-value-{i}")" Value="@row.Value" ValueChanged="@(v => _extraEnv[i] = (row.Key, v))" Placeholder="value" />
                                <UiButton Variant="danger" Size="sm" OnClick="@(() => _extraEnv.RemoveAt(i))">✕</UiButton>
                            </div>
                        }
                    </div>
                </div>
            </details>
        </div>
    </form>
</Dialog>

@code {
    [Parameter, EditorRequired] public Recipe Model { get; set; } = null!;
    [Parameter] public bool IsNew { get; set; }

    /// <summary>The engine this recipe is being edited for (the selected instance's). One form for every
    /// engine: sections for dials the engine doesn't have are hidden, and validation uses its rules.</summary>
    [Parameter] public SourceType Engine { get; set; } = SourceType.Vllm;

    private string MaxLenLabel => EngineCapabilities.HasTuningDials(Engine)
        ? "Max model length"
        : $"Context size ({EngineCapabilities.ContextLengthFlag(Engine)})";

    private string ServedNameHint =>
        "Pre-filled from the instance's currently-active served name (or \"main\" when nothing is active). A different value here changes what API clients request this model by once swapped in — you'll be asked to confirm that at swap time."
        + (EngineCapabilities.HasTuningDials(Engine) ? "" : $" Passed to {EngineCapabilities.DisplayName(Engine)} as {EngineCapabilities.ServedNameFlag(Engine)}.");

    /// <summary>The model picked for validation context (model-dependent rules) --
    /// null skips those, same as a recipe being model-agnostic at save time.</summary>
    [Parameter] public int? ModelIdForValidation { get; set; }

    [Parameter] public EventCallback<Recipe> OnSaved { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    private string _name = "";
    private string? _description;
    private string _servedModelName = "main";
    private int _maxModelLen;
    private float _gpuMemoryUtilization;
    private string _kvCacheDtype = "auto";
    private string _dtype = "auto";
    private bool _enforceEager;
    private int _maxNumBatchedTokens;
    private int _blockSize;
    private bool _speculativeDecoding;
    private int? _speculativeTokens;
    private bool _enableAutoToolChoice;
    private string? _toolCallParser;
    private string? _reasoningParser;
    private Dashboard.Core.Recipes.LlamaCppGpuLayers _gpuLayers;
    private List<(string Key, string Value)> _extraArgs = new();
    private List<(string Key, string Value)> _extraEnv = new();

    private bool _busy;
    private string? _error;
    private List<string> _hardBlocks = new();
    private List<string> _softWarnings = new();

    private RenderFragment DialogFooter => @<text>
        <UiButton Variant="secondary" Size="sm" OnClick="RequestCancel">Cancel</UiButton>
        <UiButton Variant="primary" Size="sm" Type="submit" form="recipe-form" Disabled="@(_busy || _hardBlocks.Count > 0)">@(_busy ? "Saving…" : "Save")</UiButton>
    </text>;

    protected override async Task OnInitializedAsync()
    {
        _name = Model.Name;
        _description = Model.Description;
        _servedModelName = Model.ServedModelName;
        _maxModelLen = Model.MaxModelLen;
        _gpuMemoryUtilization = Model.GpuMemoryUtilization;
        _kvCacheDtype = Model.KvCacheDtype;
        _dtype = Model.Dtype;
        _enforceEager = Model.EnforceEager;
        _maxNumBatchedTokens = Model.MaxNumBatchedTokens;
        _blockSize = Model.BlockSize;
        _speculativeDecoding = Model.SpeculativeDecoding;
        _speculativeTokens = Model.SpeculativeTokens;
        _enableAutoToolChoice = Model.EnableAutoToolChoice;
        _toolCallParser = Model.ToolCallParser;
        _reasoningParser = Model.ReasoningParser;
        _gpuLayers = Dashboard.Core.Recipes.LlamaCppGpuLayersExtensions.FromStorage(Model.GpuLayers);
        _extraArgs = ParseRows(Model.ExtraArgs);
        _extraEnv = ParseRows(Model.ExtraEnv);

        await RevalidateAsync();
    }

    private static List<(string Key, string Value)> ParseRows(string json)
    {
        try
        {
            var raw = System.Text.Json.JsonSerializer.Deserialize<List<Dictionary<string, string?>>>(json) ?? new();
            return raw
                .Where(d => d.ContainsKey("key"))
                .Select(d => (d.GetValueOrDefault("key") ?? "", d.GetValueOrDefault("value") ?? ""))
                .ToList();
        }
        catch
        {
            return new();
        }
    }

    private static string SerializeRows(List<(string Key, string Value)> rows) =>
        System.Text.Json.JsonSerializer.Serialize(
            rows.Where(r => !string.IsNullOrWhiteSpace(r.Key)).Select(r => new { key = r.Key, value = r.Value }));

    private Recipe BuildDraft() => new()
    {
        Id = Model.Id,
        ServerId = Model.ServerId,
        Name = _name,
        Description = _description,
        ServedModelName = _servedModelName,
        MaxModelLen = _maxModelLen,
        GpuMemoryUtilization = _gpuMemoryUtilization,
        KvCacheDtype = _kvCacheDtype,
        Dtype = _dtype,
        EnforceEager = _enforceEager,
        MaxNumBatchedTokens = _maxNumBatchedTokens,
        BlockSize = _blockSize,
        SpeculativeDecoding = _speculativeDecoding,
        SpeculativeTokens = _speculativeTokens,
        EnableAutoToolChoice = _enableAutoToolChoice,
        ToolCallParser = _toolCallParser,
        ReasoningParser = _reasoningParser,
        GpuLayers = Dashboard.Core.Recipes.LlamaCppGpuLayersExtensions.ToStorage(_gpuLayers),
        ExtraArgs = SerializeRows(_extraArgs),
        ExtraEnv = SerializeRows(_extraEnv),
    };

    private async Task RevalidateAsync()
    {
        try
        {
            var result = await Recipes.ValidateDraftAsync(BuildDraft(), ModelIdForValidation, Engine);
            _hardBlocks = result.HardBlocks.Select(i => i.Message).ToList();
            _softWarnings = result.SoftWarnings.Select(i => i.Message).ToList();
        }
        catch
        {
            // Validation itself failing (e.g. transient DB issue) shouldn't block
            // typing -- Save's own throw is still the hard backstop.
        }
    }

    private async Task RequestCancel() => await OnCancelled.InvokeAsync();

    private async Task SaveAsync()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            var draft = BuildDraft();
            var saved = IsNew ? await Recipes.CreateAsync(draft) : await Recipes.UpdateAsync(draft);
            await OnSaved.InvokeAsync(saved);
        }
        catch (Exception ex)
        {
            _error = "Save failed: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
