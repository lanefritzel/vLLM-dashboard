@using Dashboard.Core.Abstractions
@using Dashboard.Core.Downloads
@using Dashboard.Core.Models
@using Dashboard.Core.Supervisor
@using Dashboard.Infrastructure.Persistence.V2
@using Dashboard.Web.Components.Shared
@inject IModelService Models
@inject ISupervisorClient SupervisorClient
@inject IHuggingFaceModelLookup HfLookup

<Dialog Title="Add model" Size="md" Open="true" OpenChanged="@(open => { if (!open) _ = RequestCancelIfIdle(); })">
    @if (!string.IsNullOrEmpty(_error))
    {
        <Callout Tone="danger">@_error</Callout>
    }

    <div class="row g-3">
        <div class="col-md-4">
            <UiField Label="Name" For="am-name">
                <UiInput Id="am-name" Value="@_name" ValueChanged="@(v => _name = v)" Disabled="IsBusy" />
            </UiField>
        </div>
        <div class="col-md-4">
            <UiField Label="Source" For="am-source"
                     Hint="@(_source == "huggingface" && Instance?.AdminUrl is null ? "No supervisor registered on the selected instance — Hugging Face downloads need one. Use a local path instead." : null)">
                <UiSelect Id="am-source" Value="@_source" ValueChanged="@(v => _source = v)" Disabled="IsBusy">
                    <option value="huggingface">Hugging Face</option>
                    <option value="local">Local path</option>
                </UiSelect>
            </UiField>
        </div>
    </div>

    @if (_source == "local")
    {
        <div class="row g-3 mt-1">
            <div class="col-md-12">
                <UiField Label="Weights path (on the server's disk)" For="am-local-path">
                    <div style="display:flex; gap: var(--ui-space-2);">
                        <div style="flex:1;"><UiInput Id="am-local-path" Value="@_localPath" ValueChanged="@(v => _localPath = v)" Placeholder="/models/hf-cache/my-model" Disabled="IsBusy" /></div>
                        <UiButton Variant="secondary" Size="sm" Disabled="IsBusy" OnClick="@(() => _showPathPicker = true)">Browse…</UiButton>
                    </div>
                </UiField>
            </div>
            <div class="col-md-12">
                <UiButton Variant="primary" Size="sm" Disabled="@(!CanSaveLocal || IsBusy)" OnClick="SaveLocalAsync">Save</UiButton>
                <UiButton Variant="secondary" Size="sm" Disabled="IsBusy" OnClick="RequestCancelIfIdle">Cancel</UiButton>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3 mt-1">
            <div class="col-md-8">
                <UiField Label="Hugging Face repo id" For="am-repo-id">
                    <UiInput Id="am-repo-id" Value="@_repoId" ValueChanged="@(v => _repoId = v)" Placeholder="org/repo-name" Disabled="IsBusy" />
                </UiField>
            </div>
            <div class="col-md-4" style="display:flex; align-items:flex-end;">
                <UiButton Variant="secondary" Size="sm" Disabled="@(string.IsNullOrWhiteSpace(_repoId) || IsBusy || Instance?.AdminUrl is null)"
                          OnClick="InspectAsync">Inspect</UiButton>
            </div>
        </div>

        @if (_inspecting)
        {
            <p class="text-muted small mt-2">Inspecting @_repoId…</p>
        }

        @if (_inspectError is not null)
        {
            <div style="margin-top: var(--ui-space-2);"><Callout Tone="danger">@_inspectError</Callout></div>
        }

        @if (_inspected is not null)
        {
            var requiredBytes = _inspected.Files.Sum(f => f.Size);
            var diskCheck = DiskGuard.Check(requiredBytes, _inspected.FreeBytes);

            <div style="margin-top: var(--ui-space-2);">
                <UiPanel Variant="inset">
                    <div class="ui-stat-grid" style="gap: var(--ui-space-2);">
                        <Chip Static="true">Files: @_inspected.Files.Count</Chip>
                        <Chip Static="true">Size: @FormatBytes(requiredBytes)</Chip>
                        @if (_hfLookup is not null)
                        {
                            <Chip Static="true">Params: @FormatParamCount(_hfLookup.ParameterCount)</Chip>
                            <Chip Static="true">Quantized: @(_hfLookup.IsQuantized ? $"Yes ({_hfLookup.QuantizationMethod ?? "method unspecified"})" : "No — full precision")</Chip>
                            <Chip Static="true">Context: @(_hfLookup.DefaultMaxContextLength?.ToString("N0") ?? "unknown") tokens</Chip>
                        }
                    </div>
                </UiPanel>
            </div>

            @if (!diskCheck.Ok)
            {
                <div style="margin-top: var(--ui-space-2);">
                    <Callout Tone="danger" Action="@DiskCheckActions">@diskCheck.Message</Callout>
                </div>
            }
            else if (_downloadStatus is null)
            {
                <div class="mt-2">
                    <UiButton Variant="primary" Size="sm" Disabled="@(!CanSaveHf || IsBusy)" OnClick="StartDownloadAsync">Download</UiButton>
                    <UiButton Variant="secondary" Size="sm" OnClick="RequestCancelIfIdle">Cancel</UiButton>
                </div>
            }
        }

        @if (_downloadStatus is { } status)
        {
            @if (status.Status == "downloading")
            {
                <div class="mt-3">
                    <ProgressBar Value="@status.ProgressPct" />
                    <div class="text-muted small mt-1">
                        @status.ProgressPct.ToString("0.0")% · @FormatBytes((long)status.SpeedBps)/s ·
                        @(status.EtaSeconds is { } eta ? FormatDuration(eta) : "unknown ETA") ·
                        file @status.FilesDone of @status.FilesTotal
                    </div>
                    <div class="mt-2"><UiButton Variant="secondary" Size="sm" OnClick="CancelDownloadAsync">Cancel download</UiButton></div>
                </div>
            }
            else if (status.Status == "done")
            {
                <div class="mt-2"><Callout Tone="success">Available</Callout></div>
                <UiButton Variant="primary" Size="sm" Disabled="IsBusy" OnClick="FinishHfDownloadAsync">Add to catalog</UiButton>
            }
            else
            {
                <div class="mt-2"><Callout Tone="danger">Download @status.Status: @(status.Error ?? "no details")</Callout></div>
                <UiButton Variant="secondary" Size="sm" OnClick="ResetInspection">Try again</UiButton>
            }
        }
    }
</Dialog>

@if (_showPathPicker)
{
    <FolderPickerDialog Title="Choose the weights folder" StartPath="@_localPath"
        OnSelected="@(path => { _localPath = path; _showPathPicker = false; })"
        OnCancelled="@(() => _showPathPicker = false)" />
}

@code {
    [Parameter] public Instance? Instance { get; set; }
    [Parameter] public EventCallback<Model> OnSaved { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }
    [Parameter] public EventCallback OnDeleteOldModelsRequested { get; set; }

    private string _name = "";
    private string _source = "huggingface";
    private string _localPath = "";
    private bool _showPathPicker;
    private string _repoId = "";
    private string? _error;

    private bool _inspecting;
    private string? _inspectError;
    private SupervisorDownloadInspectResult? _inspected;
    private HuggingFaceModelInfo? _hfLookup;

    private string? _downloadId;
    private SupervisorDownloadStatus? _downloadStatus;
    private CancellationTokenSource? _pollCts;

    private bool CanSaveLocal => !string.IsNullOrWhiteSpace(_name) && !string.IsNullOrWhiteSpace(_localPath);
    private bool CanSaveHf => !string.IsNullOrWhiteSpace(_name) && _inspected is not null;

    /// <summary>"One download at a time: Add model is disabled while one runs" (doc 6) --
    /// this dialog being modal already prevents a SECOND one opening; this flag is what
    /// blocks closing/cancelling out from under an in-flight download.</summary>
    private bool IsBusy => _downloadStatus?.Status == "downloading";

    private RenderFragment DiskCheckActions => @<text>
        <UiButton Variant="secondary" Size="sm" OnClick="@(() => OnDeleteOldModelsRequested.InvokeAsync())">Delete old models</UiButton>
        <UiButton Variant="secondary" Size="sm" OnClick="ResetInspection">Choose another</UiButton>
    </text>;

    private async Task RequestCancelIfIdle()
    {
        if (IsBusy) return;
        _pollCts?.Cancel();
        await OnCancelled.InvokeAsync();
    }

    private async Task SaveLocalAsync()
    {
        _error = null;
        try
        {
            var model = new Model { ServerId = Instance!.ServerId, Name = _name.Trim(), Path = _localPath.Trim(), SourceType = "local" };
            var saved = await Models.CreateAsync(model);
            await OnSaved.InvokeAsync(saved);
        }
        catch (Exception ex)
        {
            _error = "Save failed: " + ex.Message;
        }
    }

    private async Task InspectAsync()
    {
        if (Instance?.AdminUrl is null) return;

        _inspecting = true;
        _inspectError = null;
        _inspected = null;
        _hfLookup = null;
        StateHasChanged();
        try
        {
            _inspected = await SupervisorClient.InspectDownloadAsync(Instance.AdminUrl, _repoId.Trim());
            _hfLookup = await HfLookup.LookupAsync(_repoId.Trim());
        }
        catch (Exception ex)
        {
            _inspectError = "Could not inspect this repo: " + ex.Message;
        }
        finally
        {
            _inspecting = false;
        }
    }

    private void ResetInspection()
    {
        _inspected = null;
        _hfLookup = null;
        _inspectError = null;
        _downloadId = null;
        _downloadStatus = null;
    }

    private async Task StartDownloadAsync()
    {
        if (Instance?.AdminUrl is null) return;

        _error = null;
        try
        {
            _downloadId = await SupervisorClient.StartDownloadAsync(Instance.AdminUrl, _repoId.Trim(), _name.Trim());
            _pollCts = new CancellationTokenSource();
            _ = PollDownloadAsync(Instance.AdminUrl, _downloadId, _pollCts.Token);
        }
        catch (Exception ex)
        {
            _error = "Could not start the download: " + ex.Message;
        }
    }

    private async Task PollDownloadAsync(string adminUrl, string downloadId, CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                _downloadStatus = await SupervisorClient.GetDownloadAsync(adminUrl, downloadId, ct);
            }
            catch (OperationCanceledException)
            {
                return;
            }
            catch (Exception ex)
            {
                _error = "Lost contact with the download: " + ex.Message;
                return;
            }
            await InvokeAsync(StateHasChanged);
            if (_downloadStatus.Status != "downloading")
                return;
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(1), ct);
            }
            catch (OperationCanceledException)
            {
                return;
            }
        }
    }

    private async Task CancelDownloadAsync()
    {
        if (Instance?.AdminUrl is null || _downloadId is null) return;

        _pollCts?.Cancel();
        try
        {
            await SupervisorClient.CancelDownloadAsync(Instance.AdminUrl, _downloadId);
        }
        catch (Exception ex)
        {
            _error = "Could not cancel the download: " + ex.Message;
        }
        ResetInspection();
    }

    private async Task FinishHfDownloadAsync()
    {
        if (_downloadStatus is not { Status: "done" }) return;
        _error = null;
        try
        {
            var model = new Model
            {
                ServerId = Instance!.ServerId,
                Name = _name.Trim(),
                SourceType = "huggingface",
                RepoId = _repoId.Trim(),
                Path = _downloadStatus.Path ?? "",
                SizeBytes = _downloadStatus.SizeBytes,
                LoadFormat = _downloadStatus.LoadFormat ?? "auto",
                Config = _downloadStatus.Config is null ? null : System.Text.Json.JsonSerializer.Serialize(_downloadStatus.Config),
                Status = "available",
            };
            var saved = await Models.CreateAsync(model);
            await OnSaved.InvokeAsync(saved);
        }
        catch (Exception ex)
        {
            _error = "Save failed: " + ex.Message;
        }
    }

    private static string FormatBytes(long bytes)
    {
        double value = bytes;
        string[] units = { "B", "KB", "MB", "GB", "TB" };
        var unit = 0;
        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }
        return $"{value:0.#} {units[unit]}";
    }

    private static string FormatDuration(double seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.TotalHours >= 1 ? $"{(int)ts.TotalHours}h {ts.Minutes}m" : $"{ts.Minutes}m {ts.Seconds}s";
    }

    private static string FormatParamCount(long? count) => count switch
    {
        null => "unknown",
        >= 1_000_000_000 => $"{count.Value / 1_000_000_000.0:0.#}B",
        >= 1_000_000 => $"{count.Value / 1_000_000.0:0.#}M",
        _ => count.Value.ToString("N0"),
    };
}
