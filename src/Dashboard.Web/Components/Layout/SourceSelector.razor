@rendermode InteractiveServer
@implements IDisposable
@using Dashboard.Core.Abstractions
@using Dashboard.Core.Models
@inject ISourceCatalog Sources
@inject IPhysicalServerCatalog Servers
@inject IConfigStore Config
@inject SourceSelection Selection

@* Two-level picker, scoped to vLLM instances only: pick the physical server, then
   which instance on it. Every page still just reads Selection.CurrentSourceId as
   before — this component is the only thing that changed. *@
<div class="d-flex align-items-center gap-2">
    <select class="source-selector"
            @bind="_selectedServerKey" @bind:after="@OnServerChangedAsync"
            title="Select which physical server"
            aria-label="Physical server"
            disabled="@(Loading || _groups.Count == 0)">
        @if (Loading)
        {
            <option>Loading…</option>
        }
        else if (_error)
        {
            <option>Couldn't load sources</option>
        }
        else if (_groups.Count == 0)
        {
            <option>No vLLM instances configured</option>
        }
        else
        {
            @foreach (var g in _groups)
            {
                <option value="@g.Key">@g.Label</option>
            }
        }
    </select>

    <select class="source-selector"
            @bind:get="Selection.CurrentSourceId" @bind:set="@OnInstanceChangedAsync"
            title="Select which vLLM instance to monitor — also drives Quick Test, hot-swap, Live Traffic, and Logs"
            aria-label="vLLM instance"
            disabled="@(Loading || CurrentGroupInstances.Count == 0)">
        @if (Loading)
        {
            <option>Loading…</option>
        }
        else
        {
            @foreach (var s in CurrentGroupInstances)
            {
                <option value="@s.Id">@s.Label</option>
            }
        }
    </select>

    @if (!Loading && (_error || _groups.Count == 0))
    {
        <span class="text-muted small">
            @(_error ? "Couldn't load sources." : "No sources yet.") <a href="settings">Set up one in Settings</a>
        </span>
    }
</div>

@code {
    private const string NoServerKey = "__none__";

    private sealed class ServerGroup
    {
        public required string Key { get; init; }
        public required string Label { get; init; }
        public List<SourceInfo> Instances { get; } = new();
    }

    private bool _loading = true;
    private bool _error;
    private List<ServerGroup> _groups = new();
    private string _selectedServerKey = "";
    private bool _disposed;

    private bool Loading => _loading;

    private List<SourceInfo> CurrentGroupInstances =>
        _groups.FirstOrDefault(g => g.Key == _selectedServerKey)?.Instances ?? new();

    protected override async Task OnInitializedAsync()
    {
        Config.Changed += OnChanged;
        Selection.Changed += OnChanged;
        await RefreshAsync();
    }

    private void OnChanged(object? sender, EventArgs e)
    {
        if (!_disposed)
            _ = RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        try
        {
            _error = false;
            var vllmSources = (await Sources.GetAllAsync()).Where(s => s.Type == SourceType.Vllm).ToList();
            var servers = (await Servers.GetAllAsync()).ToDictionary(p => p.Id);

            var groups = new List<ServerGroup>();
            foreach (var s in vllmSources.OrderBy(s => s.Label))
            {
                var key = s.PhysicalServerId is { } id && servers.ContainsKey(id) ? id : NoServerKey;
                var group = groups.FirstOrDefault(g => g.Key == key);
                if (group is null)
                {
                    group = new ServerGroup
                    {
                        Key = key,
                        Label = key == NoServerKey ? "No physical server" : servers[key].Label,
                    };
                    groups.Add(group);
                }
                group.Instances.Add(s);
            }
            // Real servers first (alphabetical), "No physical server" last.
            _groups = groups.OrderBy(g => g.Key == NoServerKey).ThenBy(g => g.Label).ToList();

            var current = Selection.CurrentSourceId;
            var currentStillValid = current is not null && vllmSources.Any(s => s.Id == current);

            if (currentStillValid)
            {
                _selectedServerKey = _groups.First(g => g.Instances.Any(s => s.Id == current)).Key;
            }
            else if (_groups.Count > 0)
            {
                // First run, or the previously selected instance is gone — pick a
                // sensible default: an active instance if any, else just the first.
                _selectedServerKey = _groups[0].Key;
                var def = _groups[0].Instances.FirstOrDefault(s => s.Active) ?? _groups[0].Instances.First();
                Selection.SetCurrent(def.Id);
            }
            else
            {
                _selectedServerKey = "";
                Selection.SetCurrent(null);
            }
        }
        catch
        {
            _groups = new List<ServerGroup>();
            _error = true;
        }
        _loading = false;
        try { await InvokeAsync(StateHasChanged); } catch { }
    }

    private Task OnServerChangedAsync()
    {
        // Switching servers auto-picks a default instance on it rather than leaving
        // the instance dropdown pointing at whatever was selected before.
        var def = CurrentGroupInstances.FirstOrDefault(s => s.Active) ?? CurrentGroupInstances.FirstOrDefault();
        Selection.SetCurrent(def?.Id);
        return Task.CompletedTask;
    }

    private void OnInstanceChangedAsync(string? value) => Selection.SetCurrent(value);

    public void Dispose()
    {
        _disposed = true;
        Config.Changed -= OnChanged;
        Selection.Changed -= OnChanged;
    }
}
