@using Dashboard.Core.Abstractions
@inject IFilesystemBrowser Browser

@* Native <dialog> (Style Refactor D3) -- this picker is always opened from
   inside another dialog (Server/AddModelDialog's "Browse…"), and the old
   .modal-overlay div rendered BEHIND a native <dialog>'s top-layer backdrop,
   making it invisible/unclickable once those dialogs moved to Dialog.razor. *@
<Dialog Title="@Title" Size="sm" Open="true" OpenChanged="@(open => { if (!open) _ = Cancel(); })"
        Footer="@(Browser.IsAvailable ? FooterActions : null)">
    @if (!Browser.IsAvailable)
    {
        <Callout Tone="danger">
            @Browser.RootPath isn't mounted into this container, so it can't be browsed here. Type the path manually instead.
        </Callout>
    }
    else
    {
        <p class="text-muted small mb-2" style="word-break: break-all;">@_result?.CurrentPath</p>

        <div style="max-height: 320px; overflow-y: auto; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); padding: 0.25rem;">
            @if (_result?.CanGoUp == true)
            {
                <button type="button" class="ui-btn-link d-block text-start w-100" @onclick="@(() => Navigate(_result.ParentPath))">.. (up)</button>
            }
            @if (_result is { Subfolders.Count: 0 })
            {
                <p class="text-muted small p-2" style="margin:0;">No subfolders here.</p>
            }
            @if (_result is not null)
            {
                @foreach (var folder in _result.Subfolders)
                {
                    <button type="button" class="ui-btn-link d-block text-start w-100" @onclick="@(() => Navigate(folder.FullPath))">📁 @folder.Name</button>
                }
            }
        </div>
    }
</Dialog>

@code {
    private RenderFragment FooterActions => @<text>
        <UiButton Variant="secondary" Size="sm" OnClick="Cancel">Cancel</UiButton>
        <UiButton Variant="primary" Size="sm" OnClick="SelectCurrentAsync">Select this folder</UiButton>
    </text>;

    /// <summary>Reusable navigable folder picker (vs. a free-text path field) --
    /// first used by the Server modal's ModelsDir and AddModelDialog's local weights
    /// path, backed by whatever IFilesystemBrowser has mounted (MODELS_BROWSE_ROOT).</summary>
    [Parameter] public string Title { get; set; } = "Choose a folder";
    [Parameter] public string? StartPath { get; set; }
    [Parameter] public EventCallback<string> OnSelected { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    private FolderBrowseResult? _result;

    protected override void OnInitialized()
    {
        if (Browser.IsAvailable)
            _result = Browser.ListFolders(StartPath);
    }

    private void Navigate(string? path) => _result = Browser.ListFolders(path);

    private async Task SelectCurrentAsync()
    {
        if (_result is null) return;
        await OnSelected.InvokeAsync(_result.CurrentPath);
    }

    private async Task Cancel() => await OnCancelled.InvokeAsync();
}
