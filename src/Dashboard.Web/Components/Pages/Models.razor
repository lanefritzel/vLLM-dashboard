@page "/models"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@using Dashboard.Core.Abstractions
@using Dashboard.Core.Models

<PageTitle>Models — vLLM Dashboard</PageTitle>

<h1 class="page-title">Models <span class="text-muted fs-5">/ @(SelectedSource?.Label ?? "no source selected")</span></h1>

@if (SelectedSource is null)
{
    <div class="card"><div class="card-body">
        <p class="text-muted mb-0">No source selected. Add one on the <a href="settings">Settings</a> page.</p>
    </div></div>
}

@if (SelectedSource is { } src)
{
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="card-title">Models</div>
                <button class="btn btn-primary btn-sm" @onclick="@StartNewModel">+ Add model</button>
            </div>
            <table class="table table-sm">
                <thead>
                    <tr><th>Name</th><th>Display name</th><th>Source</th><th>Path / repo</th><th>Idle TTL</th><th>Active</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var m in _models)
                    {
                        <tr>
                            <td>@m.Name</td>
                            <td>@(m.DisplayName ?? "—")</td>
                            <td>@(m.ModelSource == ModelSource.HuggingFace ? "Hugging Face" : "Local path")</td>
                            <td class="url-cell">@m.ModelPathOrRepoId</td>
                            <td>@(m.IdleTtlSeconds is { } s ? $"{s / 60} min" : "—")</td>
                            <td>
                                @if (m.IsActive)
                                {
                                    <span class="chip chip-active">active</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                                @if (m.PreloadOnStartup)
                                {
                                    <span class="chip" title="Brought up automatically when the dashboard starts">preload</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-outline btn-sm" @onclick="@(() => StartEditModel(m))">Edit</button>
                                @if (!m.IsActive)
                                {
                                    <button class="btn btn-outline btn-sm" disabled="@(_busyModelId != null)"
                                            @onclick="@(() => ActivateAsync(m))">Activate</button>
                                    <button class="btn btn-primary btn-sm" disabled="@(_busyModelId != null)"
                                            @onclick="@(() => SwapAsync(m))">Hot-swap</button>
                                }
                                <button class="btn btn-outline btn-sm btn-danger-soft" @onclick="@(() => DeleteModelAsync(m))">Delete</button>
                            </td>
                        </tr>
                    }
                    @if (_models.Count == 0)
                    {
                        <tr><td colspan="7" class="text-muted">No models registered for this source.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (_editingModel is not null)
    {
        <div class="modal-overlay" @onclick="@CancelEditModel">
            <div class="modal-dialog-custom" @onclick:stopPropagation="true">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <div class="card-title mb-0">@(_isCreatingModel ? "New model" : "Edit model")</div>
                    <button type="button" class="modal-close-btn" @onclick="@CancelEditModel" aria-label="Close">✕</button>
                </div>
                <p class="text-muted small">
                    Model path/repo id must be in Hugging Face format. Models downloaded via
                    <strong>Ollama</strong> are stored in a different, incompatible format (content-addressed
                    GGUF blobs, not a Hugging Face-style repo) and can't be run through this feature —
                    use <code>llama-swap</code> for those instead.
                </p>
                <form @onsubmit="@OnModelSubmit" @onsubmit:preventDefault="true" class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Server</label>
                        <select class="form-select" @bind="_fModelSourceId" @bind:after="RefreshCurrentSpecAsync">
                            @foreach (var s in _all)
                            {
                                <option value="@s.Id">@s.Label</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Name (served name / id)</label>
                        <input class="form-control" @bind="_fModelName" placeholder="qwen3.8-vllm" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Display name</label>
                        <input class="form-control" @bind="_fModelDisplay" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Image override <span class="text-muted">(optional)</span></label>
                        <input class="form-control" @bind="_fModelImageOverride" placeholder="(use server default)" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Model source</label>
                        <select class="form-select" @bind="_fModelSource" @bind:after="OnModelSourceChanged">
                            <option value="@ModelSource.HuggingFace">Hugging Face repo</option>
                            <option value="@ModelSource.LocalPath">Local path</option>
                        </select>
                    </div>
                    @if (_fModelSource == ModelSource.HuggingFace)
                    {
                        <div class="col-md-9">
                            <label class="form-label">Hugging Face repo id</label>
                            <input class="form-control" @bind="_fModelPathOrRepoId" @bind:after="TriggerHfLookupAsync"
                                   placeholder="Qwen/Qwen2.5-7B-Instruct" />
                        </div>
                        <div class="col-md-12">
                            @if (_hfLookupBusy)
                            {
                                <div class="text-muted small">Looking up @_fModelPathOrRepoId on Hugging Face…</div>
                            }
                            else if (_hfLookupFailed)
                            {
                                <div class="text-muted small">
                                    Couldn't look this repo up (not found, private, or unreachable) — nothing below
                                    can be checked against it automatically.
                                </div>
                            }
                            else if (_hfLookup is not null && string.Equals(_hfLookup.RepoId, _fModelPathOrRepoId.Trim(), StringComparison.Ordinal))
                            {
                                <div class="card status-card mb-0" style="border-left-color: var(--green);">
                                    <div class="card-body py-2 small">
                                        <strong>@FormatParamCount(_hfLookup.ParameterCount)</strong> parameters
                                        @if (_hfLookup.IsQuantized)
                                        {
                                            <span> · already quantized@(_hfLookup.QuantizationMethod is { } qm ? $" ({qm})" : "")</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger"> · not quantized (full precision)</span>
                                        }
                                        @if (_hfLookup.DefaultMaxContextLength is { } ctx)
                                        {
                                            <span> · default context length: @ctx.ToString("N0") tokens</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="col-md-9">
                            <label class="form-label">Weights folder (on the Docker host)</label>
                            <input class="form-control" @bind="_fModelPathOrRepoId" placeholder="/media/external6tb/llm-models/hf-cache/Qwen3.8-27B-INT4" />
                            <div class="form-text">Mounted automatically — the container path and --model value are derived for you.</div>
                        </div>
                    }
                    <div class="col-md-4">
                        <label class="form-label">
                            <input type="checkbox" class="form-check-input" @bind="_fModelActive" /> set active on save
                        </label>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">
                            <input type="checkbox" class="form-check-input" @bind="_fModelPreloadOnStartup" /> preload on dashboard startup
                        </label>
                        <div class="form-text">Brings this container up automatically when the dashboard starts, if it isn't already running.</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Idle unload after <span class="text-muted">(minutes — blank disables it)</span></label>
                        <input class="form-control" type="number" min="1" @bind="_fModelIdleTtlMinutes" placeholder="stays loaded until swapped" />
                        <div class="form-text">If this model sits idle (no proxied requests) this long, its container is stopped to free the GPU.</div>
                    </div>

                    <div class="col-md-12">
                        <div class="card-title mb-2">Model options</div>
                        @foreach (var group in VllmOptionCatalog.ByGroup())
                        {
                            <details class="mb-2" open>
                                <summary style="cursor:pointer">@GroupLabel(group.Key)</summary>
                                <div class="row g-2 mt-1">
                                    @foreach (var opt in group.Where(o => o.Tier == VllmOptionTier.Common))
                                    {
                                        @RenderOption(opt)
                                    }
                                </div>
                                @if (group.Any(o => o.Tier == VllmOptionTier.Advanced))
                                {
                                    <details class="mt-1">
                                        <summary class="text-muted" style="cursor:pointer">Advanced</summary>
                                        <div class="row g-2 mt-1">
                                            @foreach (var opt in group.Where(o => o.Tier == VllmOptionTier.Advanced))
                                            {
                                                @RenderOption(opt)
                                            }
                                        </div>
                                    </details>
                                }
                            </details>
                        }
                    </div>

                    <div class="col-md-12">
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@(_busyModelId != null)">Save</button>
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="@CancelEditModel">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (_swapTarget is not null)
    {
        <div class="card mb-4 status-card" style="border-left-color: var(--warn);">
            <div class="card-body">
                <div class="card-title mb-2">Hot-swap → @_swapTarget.Name</div>
                @foreach (var step in _swapSteps)
                {
                    <div class="swap-step">
                        <span class="@(step.Complete ? "dot dot-up" : "dot dot-off")"></span>
                        <strong>@step.Step</strong>
                        <span class="text-muted">@step.Message</span>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    [Inject] private ISourceCatalog Sources { get; set; } = default!;
    [Inject] private IModelCatalog ModelCatalog { get; set; } = default!;
    [Inject] private ILaunchSpecStore LaunchSpecs { get; set; } = default!;
    [Inject] private IDockerOrchestrator Orchestrator { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private SourceSelection Selection { get; set; } = default!;
    [Inject] private IConfigStore Config { get; set; } = default!;
    [Inject] private IHuggingFaceModelLookup HfLookup { get; set; } = default!;

    private List<SourceInfo> _all = new();
    private List<ModelInfo> _models = new();
    private ModelInfo? _editingModel;
    private bool _isCreatingModel;
    private string? _busyModelId;
    private ModelInfo? _swapTarget;
    private List<SwapStep> _swapSteps = new();
    private bool _disposed;

    // Model form.
    private string _fModelSourceId = "";
    private string _fModelName = "";
    private string _fModelDisplay = "";
    private string _fModelImageOverride = "";
    private ModelSource _fModelSource = ModelSource.HuggingFace;
    private string _fModelPathOrRepoId = "";
    private bool _fModelActive;
    private bool _fModelPreloadOnStartup;
    private int? _fModelIdleTtlMinutes;
    private Dictionary<string, string> _fOptions = new();

    // Live Hugging Face lookup + the current server's LaunchSpec (for its stated
    // VRAM total) — both drive the dependency hints rendered alongside options like
    // max-model-len/quantization/gpu-memory-utilization.
    private HuggingFaceModelInfo? _hfLookup;
    private bool _hfLookupBusy;
    private bool _hfLookupFailed;
    private LaunchSpec? _currentSpec;

    private static string GroupLabel(VllmOptionGroup g) => g switch
    {
        VllmOptionGroup.ModelAndWeights => "Model & weights",
        VllmOptionGroup.MemoryAndCache => "Memory & cache",
        VllmOptionGroup.Parallelism => "Parallelism",
        VllmOptionGroup.ToolAndReasoning => "Tool & reasoning calling",
        VllmOptionGroup.Multimodal => "Multimodal",
        VllmOptionGroup.LoRA => "LoRA",
        VllmOptionGroup.Scheduler => "Scheduler",
        VllmOptionGroup.Observability => "Observability",
        _ => g.ToString(),
    };

    private bool IsOptionEnabled(string key) => _fOptions.ContainsKey(key);

    private void SetOptionEnabled(string key, bool enabled, VllmOptionDefinition def)
    {
        if (enabled)
        {
            _fOptions[key] = def.ControlType == VllmOptionControlType.Toggle
                ? "true"
                : (def.AllowedValues?.FirstOrDefault() ?? "");
        }
        else
        {
            _fOptions.Remove(key);
        }
    }

    // Text-type options skip the override checkbox entirely: an empty value already
    // means "flag not emitted" (see DockerOrchestrator.BuildCreatePayload), so the
    // checkbox added an extra click without adding any safety — unlike Toggle/Enum/
    // numeric fields, where it genuinely prevents an accidental value slipping in.
    private string GetOptionValue(string key) => _fOptions.TryGetValue(key, out var v) ? v : "";

    private void SetOptionValue(string key, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            _fOptions.Remove(key);
        else
            _fOptions[key] = value;
    }

    private async Task RefreshCurrentSpecAsync()
    {
        _currentSpec = string.IsNullOrWhiteSpace(_fModelSourceId) ? null : await LaunchSpecs.GetBySourceAsync(_fModelSourceId);
    }

    private Task OnModelSourceChanged()
    {
        // Switching away from Hugging Face makes any lookup result stale/irrelevant
        // (it was for a repo id, not a local path) — drop it rather than show
        // misleading leftover info.
        if (_fModelSource != ModelSource.HuggingFace)
        {
            _hfLookup = null;
            _hfLookupFailed = false;
        }
        return Task.CompletedTask;
    }

    private async Task TriggerHfLookupAsync()
    {
        if (_fModelSource != ModelSource.HuggingFace || string.IsNullOrWhiteSpace(_fModelPathOrRepoId))
        {
            _hfLookup = null;
            _hfLookupFailed = false;
            return;
        }

        var repoId = _fModelPathOrRepoId.Trim();
        if (_hfLookup?.RepoId == repoId)
            return; // already have this exact repo's result

        _hfLookupBusy = true;
        _hfLookupFailed = false;
        StateHasChanged();
        try
        {
            _hfLookup = await HfLookup.LookupAsync(repoId);
            _hfLookupFailed = _hfLookup is null;
        }
        catch
        {
            _hfLookup = null;
            _hfLookupFailed = true;
        }
        finally
        {
            _hfLookupBusy = false;
            StateHasChanged();
        }
    }

    private static string FormatParamCount(long? count) => count switch
    {
        null => "unknown",
        >= 1_000_000_000 => $"{count.Value / 1_000_000_000.0:0.#}B",
        >= 1_000_000 => $"{count.Value / 1_000_000.0:0.#}M",
        _ => count.Value.ToString("N0"),
    };

    private RenderFragment RenderOption(VllmOptionDefinition opt) =>
        @<div class="col-md-6">
            @if (opt.ControlType == VllmOptionControlType.Text)
            {
                <label class="form-label mb-1" for="@("opt-" + opt.Key)">
                    @opt.Label <code class="text-muted">@opt.CliFlag</code>
                </label>
                @if (opt.Suggestions is { Length: > 0 })
                {
                    <input class="form-control form-control-sm" id="@("opt-" + opt.Key)"
                           list="@("opt-dl-" + opt.Key)"
                           placeholder="leave blank to use vLLM's default"
                           @bind:get="GetOptionValue(opt.Key)" @bind:set="v => SetOptionValue(opt.Key, v)" />
                    <datalist id="@("opt-dl-" + opt.Key)">
                        @foreach (var s in opt.Suggestions)
                        {
                            <option value="@s"></option>
                        }
                    </datalist>
                }
                else
                {
                    <input class="form-control form-control-sm" id="@("opt-" + opt.Key)"
                           placeholder="leave blank to use vLLM's default"
                           @bind:get="GetOptionValue(opt.Key)" @bind:set="v => SetOptionValue(opt.Key, v)" />
                }
                @if (!string.IsNullOrEmpty(opt.Description))
                {
                    <div class="form-text">@opt.Description</div>
                }
            }
            else
            {
                <div class="form-check d-flex align-items-center gap-2">
                    <input type="checkbox" class="form-check-input" id="@("opt-" + opt.Key)"
                           checked="@IsOptionEnabled(opt.Key)"
                           @onchange="@(e => SetOptionEnabled(opt.Key, e.Value is bool b && b, opt))" />
                    <label class="form-check-label" for="@("opt-" + opt.Key)">
                        @opt.Label <code class="text-muted">@opt.CliFlag</code>
                    </label>
                </div>
                @if (!string.IsNullOrEmpty(opt.Description))
                {
                    <div class="form-text">@opt.Description</div>
                }
                @if (!IsOptionEnabled(opt.Key))
                {
                    @if (opt.Key == "max-model-len" && _fModelSource == ModelSource.HuggingFace && _hfLookup?.DefaultMaxContextLength is { } ctxLen)
                    {
                        <div class="form-text text-danger">
                            Not set — will use this model's own default (@ctxLen.ToString("N0") tokens) unless you
                            set one. This is what caused a real production incident (a model defaulting to a
                            262,144-token context silently exhausted a server's entire memory).
                        </div>
                    }
                    else if (opt.Key == "quantization" && _fModelSource == ModelSource.HuggingFace && _hfLookup is not null)
                    {
                        @if (_hfLookup.IsQuantized)
                        {
                            <div class="form-text" style="color: var(--green);">
                                This repo already appears to be quantized@(_hfLookup.QuantizationMethod is { } qm ? $" ({qm})" : "")
                                — vLLM should auto-detect this; you likely don't need to set this.
                            </div>
                        }
                        else
                        {
                            <div class="form-text text-danger">
                                This repo does not appear to be pre-quantized — running it at full precision needs
                                significantly more memory. Consider finding an already-quantized variant instead.
                            </div>
                        }
                    }
                    else if (opt.Key == "gpu-memory-utilization")
                    {
                        <div class="form-text text-danger">
                            Not set — vLLM will default to using 90% of this source's GPU VRAM@(_currentSpec?.GpuVramTotalGb is { } vram ? $" (≈{vram * 0.9:0.#} GB of the {vram} GB you've told the dashboard this card has)" : "").
                            The System RAM limit on the Settings page does not apply to VRAM at all.
                        </div>
                    }
                }
                @if (IsOptionEnabled(opt.Key) && opt.ControlType != VllmOptionControlType.Toggle)
                {
                    @if (opt.ControlType == VllmOptionControlType.Enum)
                    {
                        <select class="form-select form-select-sm mt-1" @bind="_fOptions[opt.Key]">
                            @foreach (var v in opt.AllowedValues ?? Array.Empty<string>())
                            {
                                <option value="@v">@v</option>
                            }
                        </select>
                    }
                    else if (opt.ControlType is VllmOptionControlType.Integer or VllmOptionControlType.Float)
                    {
                        <div class="input-group input-group-sm mt-1">
                            <input class="form-control" type="number"
                                   step="@(opt.ControlType == VllmOptionControlType.Float ? "any" : "1")"
                                   min="@opt.Min" max="@opt.Max"
                                   @bind="_fOptions[opt.Key]" />
                            @if (!string.IsNullOrEmpty(opt.Unit))
                            {
                                <span class="input-group-text">@opt.Unit</span>
                            }
                        </div>
                    }
                }
            }
        </div>;

    private SourceInfo? SelectedSource =>
        _all.FirstOrDefault(s => s.Id == Selection.CurrentSourceId) ?? _all.FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        Selection.Changed += OnSelectionChanged;
        Config.Changed += OnConfigChanged;
        await ReloadAsync();
    }

    private void OnSelectionChanged(object? sender, EventArgs e) =>
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            await ReloadAsync();
        });

    // Without this, editing a source's settings (e.g. Container name, Image) on a
    // different page/tab left this page holding a stale SourceInfo/LaunchSpec
    // indefinitely — a swap could silently act on settings that were already
    // corrected, because nothing here ever re-read them until a full page reload.
    private void OnConfigChanged(object? sender, EventArgs e) =>
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            await ReloadAsync();
        });

    private async Task ReloadAsync()
    {
        try
        {
            _all = (await Sources.GetAllAsync()).ToList();
            var src = SelectedSource;
            _models = src is null ? new List<ModelInfo>() : (await ModelCatalog.GetBySourceAsync(src.Id)).ToList();
        }
        catch
        {
            // leave whatever we have; next selection change retries
        }
        StateHasChanged();
    }

    private async Task StartNewModel()
    {
        _isCreatingModel = true;
        _editingModel = new ModelInfo { SourceId = SelectedSource!.Id, SortOrder = _models.Count };
        _fModelSourceId = SelectedSource!.Id;
        _fModelName = "";
        _fModelDisplay = "";
        _fModelImageOverride = "";
        _fModelSource = ModelSource.HuggingFace;
        _fModelPathOrRepoId = "";
        _fModelActive = _models.Count == 0;
        _fModelPreloadOnStartup = false;
        _fModelIdleTtlMinutes = null;
        _fOptions = new();
        _hfLookup = null;
        _hfLookupFailed = false;
        await RefreshCurrentSpecAsync();
    }

    private async Task StartEditModel(ModelInfo m)
    {
        _isCreatingModel = false;
        _editingModel = m;
        _fModelSourceId = m.SourceId;
        _fModelName = m.Name;
        _fModelDisplay = m.DisplayName ?? "";
        _fModelImageOverride = m.ImageOverride ?? "";
        _fModelSource = m.ModelSource;
        _fModelPathOrRepoId = m.ModelPathOrRepoId;
        _fModelActive = m.IsActive;
        _fModelPreloadOnStartup = m.PreloadOnStartup;
        _fModelIdleTtlMinutes = m.IdleTtlSeconds is { } s ? Math.Max(1, s / 60) : null;
        _fOptions = new Dictionary<string, string>(m.Options);
        _hfLookup = null;
        _hfLookupFailed = false;
        await RefreshCurrentSpecAsync();
        await TriggerHfLookupAsync();
    }

    private void CancelEditModel() => _editingModel = null;

    private async Task OnModelSubmit()
    {
        if (_editingModel is null) return;
        if (string.IsNullOrWhiteSpace(_fModelName)) return;
        try
        {
            var model = _editingModel with
            {
                SourceId = _fModelSourceId,
                Name = _fModelName.Trim(),
                DisplayName = string.IsNullOrWhiteSpace(_fModelDisplay) ? null : _fModelDisplay.Trim(),
                ImageOverride = string.IsNullOrWhiteSpace(_fModelImageOverride) ? null : _fModelImageOverride.Trim(),
                ModelSource = _fModelSource,
                ModelPathOrRepoId = _fModelPathOrRepoId.Trim(),
                IdleTtlSeconds = _fModelIdleTtlMinutes is { } m and > 0 ? m * 60 : null,
                PreloadOnStartup = _fModelPreloadOnStartup,
                Options = _fOptions.Where(kv => !string.IsNullOrWhiteSpace(kv.Value))
                    .ToDictionary(kv => kv.Key, kv => kv.Value),
            };
            if (_isCreatingModel)
                await ModelCatalog.CreateAsync(model with { IsActive = _fModelActive });
            else
                await ModelCatalog.UpdateAsync(model with { IsActive = _fModelActive });
            _editingModel = null;

            // If the model was saved against a different server than the one currently
            // shown, jump to that server so the table actually reflects what just
            // happened, instead of the model silently not appearing in the visible list.
            if (_fModelSourceId != SelectedSource?.Id)
                Selection.SetCurrent(_fModelSourceId);

            await ReloadAsync();
        }
        catch (Exception ex)
        {
            await AlertAsync("Save failed: " + ex.Message);
        }
    }

    private async Task ActivateAsync(ModelInfo m)
    {
        try
        {
            await ModelCatalog.ActivateAsync(m.Id);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            await AlertAsync("Activate failed: " + ex.Message);
        }
    }

    private async Task DeleteModelAsync(ModelInfo m)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"Delete model '{m.Name}'?");
        if (!ok) return;
        try
        {
            await ModelCatalog.DeleteAsync(m.Id);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            await AlertAsync("Delete failed: " + ex.Message);
        }
    }

    private async Task SwapAsync(ModelInfo m)
    {
        var src = SelectedSource;
        if (src is null || _busyModelId is not null) return;
        var spec = await LaunchSpecs.GetBySourceAsync(src.Id);
        if (spec is null || string.IsNullOrWhiteSpace(spec.Image))
        {
            await AlertAsync("Set up this server's hot-swap/Docker settings on the Settings page (image is required) before hot-swapping.");
            return;
        }
        var ok = await JS.InvokeAsync<bool>("confirm",
            $"Hot-swap '{src.Label}' to model '{m.Name}'? The backend container will be recreated.");
        if (!ok) return;

        _busyModelId = m.Id;
        _swapTarget = m;
        _swapSteps = new List<SwapStep>();
        StateHasChanged();

        var progress = new SwapProgress(ReportSwapStep);
        var result = await Orchestrator.SwapModelAsync(src, m, spec, progress);

        if (!result.Success)
            await AlertAsync("Hot-swap failed: " + result.Error);
        else
            await ModelCatalog.ActivateAsync(m.Id);

        _busyModelId = null;
        await ReloadAsync();
    }

    private async Task AlertAsync(string message)
    {
        try { await JS.InvokeVoidAsync("alert", message); } catch { }
    }

    private Task ReportSwapStep(SwapStep step) => InvokeAsync(() =>
    {
        _swapSteps.Add(step);
        StateHasChanged();
    });

    private sealed class SwapProgress : IAsyncActionProgress
    {
        private readonly Func<SwapStep, Task> _report;
        public SwapProgress(Func<SwapStep, Task> report) => _report = report;
        public Task ReportAsync(SwapStep step) => _report(step);
    }

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        Selection.Changed -= OnSelectionChanged;
        Config.Changed -= OnConfigChanged;
    }
}
