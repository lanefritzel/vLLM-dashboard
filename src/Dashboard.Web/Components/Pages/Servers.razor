@page "/servers"
@rendermode InteractiveServer
@attribute [Authorize]
@using Dashboard.Core.Abstractions
@using Dashboard.Core.Models
@using Dashboard.Core.Supervisor
@using Dashboard.Infrastructure.Persistence.V2
@using Dashboard.Web.Components.Shared
@inject IServerService ServersSvc
@inject IInstanceService Instances
@inject ISupervisorClient SupervisorClient
@inject Dashboard.Web.Components.Shared.IDialogService Dialogs

<PageTitle>Servers — vLLM Dashboard</PageTitle>

<h1 class="page-title">Servers</h1>

@if (_loading)
{
    <p class="text-muted">Loading…</p>
}
else
{
    @if (_error is not null)
    {
        <Callout Tone="danger">@_error</Callout>
    }

    <div class="ui-page-actions" style="justify-content:flex-end; margin-bottom: var(--ui-space-3);">
        <UiButton Variant="primary" Size="sm" OnClick="OpenNewServer">+ Add server</UiButton>
    </div>

    @foreach (var server in _servers)
    {
        <div style="margin-bottom: var(--ui-space-3);">
            <UiPanel Title="@server.Label"
                     Description="@($"{server.DockerHost ?? "no Docker host"} · {server.GpuName ?? "no GPU set"} {(server.GpuCount > 1 ? $"x{server.GpuCount}" : "")} {(server.GpuMemGb is { } gb ? $"({gb} GB)" : "")} · models dir: {(string.IsNullOrWhiteSpace(server.ModelsDir) ? "—" : server.ModelsDir)}")"
                     HeaderActions="@ServerHeaderActions(server)"
                     Flush="true">
                <TableShell Caption="@($"Instances on {server.Label}")" ColumnCount="5"
                            IsEmpty="@(!HasInstances(server.Id))"
                            EmptyTitle="No instances on this server yet">
                    <Header>
                        <th scope="col">Instance</th>
                        <th scope="col">Proxy slug</th>
                        <th scope="col">Port</th>
                        <th scope="col">Supervisor</th>
                        <th scope="col"></th>
                    </Header>
                    <ChildContent>
                        @if (_instancesByServer.TryGetValue(server.Id, out var list))
                        {
                            @foreach (var instance in list)
                            {
                                <tr>
                                    <td>@instance.Label</td>
                                    <td><code>@instance.ProxySlug</code></td>
                                    <td class="num">@instance.Port</td>
                                    <td>@(instance.AdminUrl is null ? "needs supervisor registration" : instance.AdminUrl)</td>
                                    <td>
                                        <span class="ui-row-actions">
                                            <UiButton Variant="ghost" Size="sm" OnClick="@(() => OpenEditInstance(server, instance))">Edit</UiButton>
                                            <UiButton Variant="danger" Size="sm" OnClick="@(() => DeleteInstanceAsync(instance))">Delete</UiButton>
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </ChildContent>
                    <Footer>
                        <UiButton Variant="secondary" Size="sm" OnClick="@(() => OpenNewInstance(server))">+ Add instance</UiButton>
                    </Footer>
                </TableShell>
            </UiPanel>
        </div>
    }
    @if (_servers.Count == 0)
    {
        <UiPanel><EmptyState Variant="no-data" Title="No servers configured yet" PrimaryAction="@NoServersAction" /></UiPanel>
    }
}

@if (_editingServer is not null)
{
    <Dialog Title="@(_serverIsNew ? "Add server" : "Edit server")" Size="md"
            Open="@(_editingServer is not null)" OpenChanged="@(open => { if (!open) CloseServerDialog(); })"
            Footer="@ServerDialogFooter">
        <form id="server-form" @onsubmit="SaveServerAsync" @onsubmit:preventDefault="true" class="row g-3">
            <div class="col-md-6">
                <UiField Label="Label" For="sv-label" Required="true">
                    <UiInput Id="sv-label" @bind-Value="_svLabel" />
                </UiField>
            </div>
            <div class="col-md-6">
                <UiField Label="Docker host" For="sv-docker-host" Hint="for Start/Hard-reset only">
                    <UiInput Id="sv-docker-host" @bind-Value="_svDockerHost" />
                </UiField>
            </div>
            <div class="col-md-4">
                <UiField Label="GPU name" For="sv-gpu-name" Hint="Containing &quot;intel&quot; enables the Intel dtype rule.">
                    <UiInput Id="sv-gpu-name" @bind-Value="_svGpuName" Placeholder="e.g. Intel Max 1550" />
                </UiField>
            </div>
            <div class="col-md-4">
                <UiField Label="GPU count" For="sv-gpu-count">
                    <UiInput Id="sv-gpu-count" Type="number" Value="@_svGpuCount.ToString()" ValueChanged="@(v => _svGpuCount = int.TryParse(v, out var n) ? n : _svGpuCount)" />
                </UiField>
            </div>
            <div class="col-md-4">
                <UiField Label="GPU memory (GB)" For="sv-gpu-mem">
                    <UiInput Id="sv-gpu-mem" Type="number" Value="@_svGpuMemGb?.ToString()" ValueChanged="@(v => _svGpuMemGb = int.TryParse(v, out var n) ? n : null)" />
                </UiField>
            </div>
            <div class="col-md-12">
                <UiField Label="Models directory" For="sv-models-dir">
                    <div style="display:flex; gap: var(--ui-space-2);">
                        <div style="flex:1;"><UiInput Id="sv-models-dir" @bind-Value="_svModelsDir" Placeholder="/models" /></div>
                        <UiButton Variant="secondary" Size="sm" OnClick="@(() => _showModelsDirPicker = true)">Browse…</UiButton>
                    </div>
                </UiField>
            </div>
        </form>
    </Dialog>
}

@if (_showModelsDirPicker)
{
    <FolderPickerDialog Title="Choose the models directory" StartPath="@_svModelsDir"
        OnSelected="@(path => { _svModelsDir = path; _showModelsDirPicker = false; })"
        OnCancelled="@(() => _showModelsDirPicker = false)" />
}

@if (_editingInstance is not null)
{
    <Dialog Title="@(_instanceIsNew ? "Add instance" : "Edit instance")" Size="md"
            Open="@(_editingInstance is not null)" OpenChanged="@(open => { if (!open) CloseInstanceDialog(); })"
            Footer="@InstanceDialogFooter">
        <form id="instance-form" @onsubmit="SaveInstanceAsync" @onsubmit:preventDefault="true" class="row g-3">
            <div class="col-md-6">
                <UiField Label="Label" For="in-label" Required="true">
                    <UiInput Id="in-label" @bind-Value="_inLabel" />
                </UiField>
            </div>
            <div class="col-md-6">
                <UiField Label="Proxy slug" For="in-slug" Required="true"
                         Hint="@(!_instanceIsNew ? "Changing this changes every client's proxy URL." : null)">
                    <UiInput Id="in-slug" @bind-Value="_inProxySlug" />
                </UiField>
            </div>
            <div class="col-md-4">
                <UiField Label="Engine" For="in-engine">
                    <UiSelect Id="in-engine" @bind-Value="_inEngine">
                        @foreach (var engine in EngineCapabilities.Options)
                        {
                            <option value="@engine.Storage">@engine.Label</option>
                        }
                    </UiSelect>
                </UiField>
            </div>
            <div class="col-md-4">
                <UiField Label="Engine port" For="in-port">
                    <UiInput Id="in-port" Type="number" Value="@_inPort.ToString()" ValueChanged="@(v => _inPort = int.TryParse(v, out var n) ? n : _inPort)" />
                </UiField>
            </div>
            <div class="col-md-4">
                <UiField Label="Container name" For="in-container" Hint="for Start/Hard-reset only">
                    <UiInput Id="in-container" @bind-Value="_inContainerName" />
                </UiField>
            </div>
            <div class="col-md-4">
                <UiField Label="Poll interval (ms)" For="in-poll">
                    <UiInput Id="in-poll" Type="number" Value="@_inPollIntervalMs.ToString()" ValueChanged="@(v => _inPollIntervalMs = int.TryParse(v, out var n) ? n : _inPollIntervalMs)" />
                </UiField>
            </div>
            <div class="col-md-8">
                <UiField Label="Supervisor URL" For="in-admin-url">
                    <UiInput Id="in-admin-url" @bind-Value="_inAdminUrl" Placeholder="http://host:8080" />
                </UiField>
            </div>
            <div class="col-md-12">
                <UiButton Variant="secondary" Size="sm" Disabled="@(_testBusy || string.IsNullOrWhiteSpace(_inAdminUrl))" OnClick="TestConnectionAsync">
                    @(_testBusy ? "Testing…" : "Test connection")
                </UiButton>
                @if (_testResult is not null)
                {
                    <div style="margin-top: var(--ui-space-2);">
                        <Callout Tone="@(_testOk ? "success" : "danger")">@_testResult</Callout>
                    </div>
                }
            </div>

            @if (!_instanceIsNew && _editingInstance!.AdminUrl is not null)
            {
                <div class="col-md-12">
                    @if (_autoStartOn is null)
                    {
                        <label class="ui-label" style="display:block; margin-bottom: 4px;">Restore last known good model on boot — checking…</label>
                    }
                    else
                    {
                        <label class="ui-label" style="display:flex; align-items:center; gap: var(--ui-space-2); margin-bottom: 4px;">
                            <input type="checkbox" checked="@_autoStartOn" @onchange="@OnAutoStartToggledAsync" />
                            Restore last known good model on boot
                        </label>
                    }
                    <p class="ui-hint" style="margin:0;">
                        Restores the last <em>healthy</em> model when the container starts — a failed run is
                        never replayed, and it stops retrying after 3 attempts.
                    </p>
                </div>
            }
        </form>
    </Dialog>
}

@code {
    private bool _loading = true;
    private string? _error;
    private List<Server> _servers = new();
    private Dictionary<int, List<Instance>> _instancesByServer = new();

    private Server? _editingServer;
    private bool _serverIsNew;
    private string _svLabel = "";
    private string _svDockerHost = "";
    private string _svGpuName = "";
    private int _svGpuCount = 1;
    private int? _svGpuMemGb;
    private string _svModelsDir = "/models";
    private bool _showModelsDirPicker;

    private Instance? _editingInstance;
    private int _editingInstanceServerId;
    private bool _instanceIsNew;
    private string _inLabel = "";
    private string _inProxySlug = "";
    private string _inEngine = EngineCapabilities.DefaultEngine.Storage;
    private int _inPort = 9999;
    private string _inContainerName = "";
    private int _inPollIntervalMs = 1000;
    private string _inAdminUrl = "";

    private bool _testBusy;
    private bool _testOk;
    private string? _testResult;
    private bool? _autoStartOn;

    private bool HasInstances(int serverId) => _instancesByServer.TryGetValue(serverId, out var list) && list.Count > 0;

    private RenderFragment ServerHeaderActions(Server server) => @<text>
        <UiButton Variant="ghost" Size="sm" OnClick="@(() => OpenEditServer(server))">Edit</UiButton>
        <UiButton Variant="danger" Size="sm" OnClick="@(() => DeleteServerAsync(server))">Delete</UiButton>
    </text>;

    private RenderFragment NoServersAction => @<UiButton Variant="primary" Size="sm" OnClick="OpenNewServer">+ Add server</UiButton>;

    private RenderFragment ServerDialogFooter => @<text>
        <UiButton Variant="secondary" Size="sm" OnClick="CloseServerDialog">Cancel</UiButton>
        <UiButton Variant="primary" Size="sm" Type="submit" form="server-form">Save</UiButton>
    </text>;

    private RenderFragment InstanceDialogFooter => @<text>
        <UiButton Variant="secondary" Size="sm" OnClick="CloseInstanceDialog">Cancel</UiButton>
        <UiButton Variant="primary" Size="sm" Type="submit" form="instance-form">Save</UiButton>
    </text>;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _servers = (await ServersSvc.ListAsync()).ToList();
            _instancesByServer.Clear();
            foreach (var server in _servers)
                _instancesByServer[server.Id] = (await Instances.ListByServerAsync(server.Id)).ToList();
        }
        catch (Exception ex)
        {
            _error = "Could not load: " + ex.Message;
        }
        _loading = false;
    }

    private void OpenNewServer()
    {
        _editingServer = new Server();
        _serverIsNew = true;
        _svLabel = ""; _svDockerHost = ""; _svGpuName = ""; _svGpuCount = 1; _svGpuMemGb = null; _svModelsDir = "/models";
    }

    private void OpenEditServer(Server server)
    {
        _editingServer = server;
        _serverIsNew = false;
        _svLabel = server.Label;
        _svDockerHost = server.DockerHost ?? "";
        _svGpuName = server.GpuName ?? "";
        _svGpuCount = server.GpuCount;
        _svGpuMemGb = server.GpuMemGb;
        _svModelsDir = server.ModelsDir;
    }

    private void CloseServerDialog() => _editingServer = null;

    private async Task SaveServerAsync()
    {
        try
        {
            var server = new Server
            {
                Id = _editingServer!.Id, Label = _svLabel.Trim(),
                DockerHost = string.IsNullOrWhiteSpace(_svDockerHost) ? null : _svDockerHost.Trim(),
                GpuName = string.IsNullOrWhiteSpace(_svGpuName) ? null : _svGpuName.Trim(),
                GpuCount = Math.Max(1, _svGpuCount), GpuMemGb = _svGpuMemGb,
                ModelsDir = _svModelsDir.Trim(),
            };
            if (_serverIsNew) await ServersSvc.CreateAsync(server);
            else await ServersSvc.UpdateAsync(server);
            _editingServer = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Dialogs.AlertAsync("Could not save: " + ex.Message);
        }
    }

    private async Task DeleteServerAsync(Server server)
    {
        var confirmed = await Dialogs.ConfirmAsync($"Delete server \"{server.Label}\"? This cannot be undone.", confirmText: "Delete");
        if (!confirmed) return;
        try
        {
            await ServersSvc.DeleteAsync(server.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Dialogs.AlertAsync("Could not delete (it may still have instances/models/recipes): " + ex.Message);
        }
    }

    private void OpenNewInstance(Server server)
    {
        _editingInstanceServerId = server.Id;
        _editingInstance = new Instance { ServerId = server.Id };
        _instanceIsNew = true;
        _inLabel = ""; _inProxySlug = ""; _inEngine = EngineCapabilities.DefaultEngine.Storage; _inPort = 9999; _inContainerName = ""; _inPollIntervalMs = 1000;
        _inAdminUrl = "";
        _testResult = null;
        _autoStartOn = null;
    }

    private void OpenEditInstance(Server server, Instance instance)
    {
        _editingInstanceServerId = server.Id;
        _editingInstance = instance;
        _instanceIsNew = false;
        _inLabel = instance.Label;
        _inProxySlug = instance.ProxySlug;
        _inEngine = instance.Engine;
        _inPort = instance.Port;
        _inContainerName = instance.ContainerName ?? "";
        _inPollIntervalMs = instance.PollIntervalMs;
        _inAdminUrl = instance.AdminUrl ?? "";
        _testResult = null;
        // null ("checking…") until RefreshAutoStartAsync resolves the real value --
        // showing a guessed default here would flash the wrong state on every open.
        _autoStartOn = null;
        if (instance.AdminUrl is not null)
            _ = RefreshAutoStartAsync(instance);
    }

    private async Task RefreshAutoStartAsync(Instance instance)
    {
        if (instance.AdminUrl is null) return;
        try
        {
            var value = await SupervisorClient.GetAutoStartAsync(instance.AdminUrl);
            _autoStartOn = value != "off";
            StateHasChanged();
        }
        catch
        {
            // Best-effort -- leave the toggle at its default rather than blocking the dialog.
        }
    }

    private void CloseInstanceDialog() => _editingInstance = null;

    private async Task TestConnectionAsync()
    {
        _testBusy = true;
        _testResult = null;
        StateHasChanged();
        try
        {
            var healthy = await SupervisorClient.HealthAsync(_inAdminUrl.Trim());
            if (!healthy)
            {
                _testOk = false;
                _testResult = "Could not reach this supervisor at that URL.";
                return;
            }

            var status = await SupervisorClient.GetStatusAsync(_inAdminUrl.Trim());
            var gpu = await SupervisorClient.GetGpuAsync(_inAdminUrl.Trim());
            var currentModel = status.Child?.Argv is { Count: > 0 } argv ? string.Join(" ", argv.TakeLast(2)) : "idle";
            _testOk = true;
            _testResult = $"Connected. GPU: {gpu.Vendor} ({gpu.TotalMb ?? 0} MB total) · supervisor state: {status.State} · {currentModel}";
        }
        catch (Exception ex)
        {
            _testOk = false;
            _testResult = "Connection failed: " + ex.Message;
        }
        finally
        {
            _testBusy = false;
            StateHasChanged();
        }
    }

    private async Task OnAutoStartToggledAsync(ChangeEventArgs e)
    {
        if (_editingInstance?.AdminUrl is null) return;
        var on = e.Value is bool b && b;
        try
        {
            await SupervisorClient.SetAutoStartAsync(_editingInstance.AdminUrl, on ? "last_good" : "off");
            _autoStartOn = on;
        }
        catch (Exception ex)
        {
            await Dialogs.AlertAsync("Could not change the boot-restore setting: " + ex.Message);
        }
    }

    private async Task SaveInstanceAsync()
    {
        try
        {
            var instance = new Instance
            {
                Id = _editingInstance!.Id, ServerId = _editingInstanceServerId,
                Label = _inLabel.Trim(), ProxySlug = _inProxySlug.Trim(), Engine = _inEngine, Port = Math.Max(1, _inPort),
                ContainerName = string.IsNullOrWhiteSpace(_inContainerName) ? null : _inContainerName.Trim(),
                PollIntervalMs = Math.Max(100, _inPollIntervalMs),
                AdminUrl = string.IsNullOrWhiteSpace(_inAdminUrl) ? null : _inAdminUrl.Trim(),
                Host = _editingInstance.Host,
                IsActive = true,
            };

            if (_instanceIsNew)
            {
                await Instances.CreateAsync(instance);
            }
            else
            {
                var (_, slugChanged) = await Instances.UpdateAsync(instance);
                if (slugChanged)
                    await Dialogs.AlertAsync("The proxy slug changed -- every client's proxy URL for this instance is now different.");
            }
            _editingInstance = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Dialogs.AlertAsync("Could not save: " + ex.Message);
        }
    }

    private async Task DeleteInstanceAsync(Instance instance)
    {
        var confirmed = await Dialogs.ConfirmAsync($"Delete instance \"{instance.Label}\"? This cannot be undone.", confirmText: "Delete");
        if (!confirmed) return;
        try
        {
            await Instances.DeleteAsync(instance.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Dialogs.AlertAsync("Could not delete: " + ex.Message);
        }
    }
}
