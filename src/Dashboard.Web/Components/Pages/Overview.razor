@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Text.Json
@using Dashboard.Core.Abstractions
@using Dashboard.Core.Models
@using Dashboard.Core.Supervisor
@using Dashboard.Infrastructure.Persistence.V2
@using Dashboard.Web.Components.Overview
@using Microsoft.JSInterop
@inject IServerService Servers
@inject IInstanceService Instances
@inject IModelService Models
@inject IRecipeService Recipes
@inject IDeploymentService Deployments
@inject ISwapService Swap
@inject ISupervisorClient SupervisorClient
@inject ISupervisorTokenProvider TokenProvider
@inject IJSRuntime JS
@inject Dashboard.Web.Components.Shared.IDialogService Dialogs
@inject IOnboardingService Onboarding

<PageTitle>Overview — vLLM Dashboard</PageTitle>

<h1 class="page-title">Overview</h1>

@if (_onboarding is { ShouldShow: true })
{
    <div class="card mb-3" style="border-left: 3px solid var(--blue, #4c8dff);">
        <div class="card-body">
            <div class="card-title mb-2">Get started</div>
            <ol class="onboarding-checklist mb-0">
                <li class="@(_onboarding.HasServerAndInstance ? "text-muted" : "")">
                    @(_onboarding.HasServerAndInstance ? "✓" : "①") Register a server and instance
                    @if (!_onboarding.HasServerAndInstance)
                    {
                        <a href="servers">— go to Servers</a>
                    }
                </li>
                <li class="@(_onboarding.HasModel ? "text-muted" : "")">
                    @(_onboarding.HasModel ? "✓" : "②") Add or download a model
                    @if (_onboarding.HasServerAndInstance && !_onboarding.HasModel)
                    {
                        <a href="models-recipes">— go to Models &amp; Recipes</a>
                    }
                </li>
                <li class="@(_onboarding.HasRecipe ? "text-muted" : "")">
                    @(_onboarding.HasRecipe ? "✓" : "③") Create a recipe from it
                    @if (_onboarding.HasModel && !_onboarding.HasRecipe)
                    {
                        <a href="models-recipes">— go to Models &amp; Recipes</a>
                    }
                </li>
                <li class="@(_onboarding.HasDeployment ? "text-muted" : "")">
                    @(_onboarding.HasDeployment ? "✓" : "④") Do your first swap
                </li>
            </ol>
        </div>
    </div>
}

@if (_loading)
{
    <p class="text-muted">Loading…</p>
}
else if (_instance is null)
{
    <div class="card"><div class="card-body">
        <p class="text-muted mb-0">No instance configured yet. Register one on the Servers page.</p>
    </div></div>
}
else
{
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger py-2">@_error</div>
    }

    @if (_pendingDeployment is not null && !_swapOpen)
    {
        <div class="card status-card mb-3">
            <div class="card-body d-flex align-items-center gap-3 py-2">
                <span class="dot dot-wait"></span>
                <div class="flex-grow-1">A swap is in progress on this instance.</div>
                <button class="btn btn-outline btn-sm" @onclick="@(() => OpenCeremony(_pendingDeployment.Id))">View progress</button>
            </div>
        </div>
    }
    else if (_activeDeployment is not null)
    {
        <div class="card status-card status-up mb-3">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="dot dot-up"></span>
                    <strong>Ready</strong>
                    <span class="text-muted">· Serving: @(_activeModel?.Name ?? "—")</span>
                    <span class="text-muted">· recipe: @(_activeRecipe?.Name ?? "—")</span>
                    <span class="text-muted">· @_instance.Label</span>
                </div>
                <div class="text-muted small mt-1">
                    proxy: <code>/proxy/@(_instance.ProxySlug)/v1</code>
                    · served as "@(_activeRecipe?.ServedModelName ?? "main")"
                    · Uptime @UptimeText()
                    · VRAM @VramText()
                    · @ReqPerSecText() req/s
                </div>
                <div class="mt-2">
                    <button class="btn btn-primary btn-sm" @onclick="@(() => OpenCeremony(null))">Swap</button>
                    <a class="btn btn-outline btn-sm" href="@("/proxy/" + _instance.ProxySlug + "/v1")" target="_blank">Playground</a>
                    <button class="btn btn-outline btn-sm" @onclick="@StopAsync">Stop</button>
                    <button class="btn btn-outline btn-sm" disabled="@(!_canRollback)" @onclick="@(() => OpenCeremony(null, rollback: true))">Rollback</button>
                </div>

                @if (_vramWarning is not null)
                {
                    <div class="alert alert-warning py-2 mt-2">
                        @_vramWarning
                        <div class="mt-1">
                            <button class="btn btn-outline btn-sm" @onclick="@RecheckVramAsync">Re-check</button>
                            <button class="btn btn-outline btn-sm" @onclick="@HardResetAsync">Hard reset container</button>
                        </div>
                    </div>
                }
                @if (_vramReleasedMessage is not null)
                {
                    <div class="alert alert-success py-2 mt-2">@_vramReleasedMessage</div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card status-card mb-3">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="dot dot-off"></span>
                    <strong>No active model — instance is idle</strong>
                </div>
                @if (_lastFailed is not null)
                {
                    <div class="alert alert-danger py-2 mt-2">
                        ✗ Last run failed — @(_lastFailed.FailureReason ?? "unknown reason") (code @(_lastFailed.ExitCode?.ToString() ?? "n/a"))
                    </div>
                }
                <div class="mt-2">
                    @if (_lastWorking is not null)
                    {
                        <button class="btn btn-primary btn-sm" @onclick="@RedeployLastWorkingAsync">
                            Re-deploy last working: @(_lastWorkingModelName) · @(_lastWorkingRecipeName)
                        </button>
                    }
                    <button class="btn btn-outline btn-sm" @onclick="@(() => OpenCeremony(null))">Pick a recipe</button>
                </div>

                @if (_vramWarning is not null)
                {
                    <div class="alert alert-warning py-2 mt-2">
                        @_vramWarning
                        <div class="mt-1">
                            <button class="btn btn-outline btn-sm" @onclick="@RecheckVramAsync">Re-check</button>
                            <button class="btn btn-outline btn-sm" @onclick="@HardResetAsync">Hard reset container</button>
                        </div>
                    </div>
                }
                @if (_vramReleasedMessage is not null)
                {
                    <div class="alert alert-success py-2 mt-2">@_vramReleasedMessage</div>
                }
            </div>
        </div>
    }

    @if (_recentDeployments.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="card-title mb-2">Recent swaps</div>
                <table class="table table-sm">
                    <thead><tr><th>Model</th><th>Recipe</th><th>Status</th><th>Stopped by</th><th>When</th></tr></thead>
                    <tbody>
                        @foreach (var d in _recentDeployments)
                        {
                            <tr>
                                <td>@NameFor(d.ModelId, _models)</td>
                                <td>@NameFor(d.RecipeId, _recipes)</td>
                                <td>@d.Status</td>
                                <td>@(d.StopReason ?? "—")</td>
                                <td>@(d.StoppedAt ?? d.CreatedAt).ToLocalTime().ToString("MMM d, HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
        <div class="card-title">Live metrics</div>
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small">Window</span>
            <select class="form-select window-select" @onchange="@OnWindowChanged">
                <option value="1" selected="@(_windowMinutes == 1)">1 min</option>
                <option value="5" selected="@(_windowMinutes == 5)">5 min</option>
                <option value="30" selected="@(_windowMinutes == 30)">30 min</option>
            </select>
        </div>
    </div>

    @if (_latestSample is null)
    {
        <div class="card"><div class="card-body text-muted">No traffic in this window.</div></div>
    }
    else
    {
        <div class="row g-3">
            <div class="col-lg-6">
                <div class="card h-100"><div class="card-body">
                    <div class="card-title">Throughput (tok/s)</div>
                    <div class="chart-wrap"><canvas id="ov2-throughput"></canvas></div>
                </div></div>
            </div>
            <div class="col-lg-6">
                <div class="card h-100"><div class="card-body">
                    <div class="card-title">KV cache usage (%)</div>
                    <div class="chart-wrap"><canvas id="ov2-kv"></canvas></div>
                </div></div>
            </div>
        </div>
    }
}

@if (_swapOpen && _instance is not null)
{
    <SwapCeremonyDialog Instance="@_instance" CurrentModel="@_activeModel" CurrentRecipe="@_activeRecipe"
                         Models_="@_models" Recipes_="@_recipes" ResumeDeploymentId="@_resumeDeploymentId"
                         OnClosed="@CloseCeremonyAsync" OnDeploymentSettled="@RefreshDeploymentStateAsync" />
}

@code {
    private static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    private bool _loading = true;
    private OnboardingStatus? _onboarding;
    private string? _error;

    private List<Server> _servers = new();
    private Instance? _instance;
    private List<Model> _models = new();
    private List<Recipe> _recipes = new();
    private Deployment? _activeDeployment;
    private Deployment? _pendingDeployment;
    private Model? _activeModel;
    private Recipe? _activeRecipe;
    private List<Deployment> _recentDeployments = new();
    private Deployment? _lastFailed;
    private Deployment? _lastWorking;
    private string _lastWorkingModelName = "";
    private string _lastWorkingRecipeName = "";
    private bool _canRollback;

    private bool _swapOpen;
    private int? _resumeDeploymentId;

    private string? _vramWarning;
    private string? _vramReleasedMessage;
    private SupervisorGpuInfo? _gpuInfo;

    private DotNetObjectReference<Overview>? _receiver;
    private bool _hubStarted;
    private bool _jsReady;
    private int _windowMinutes = 5;
    private string? _chartKey;
    private MetricsSample? _latestSample;
    private string? _hubJoinedSourceId;

    protected override async Task OnInitializedAsync()
    {
        _receiver = DotNetObjectReference.Create(this);
        try
        {
            _onboarding = await Onboarding.GetStatusAsync();
            _servers = (await Servers.ListAsync()).ToList();
            if (_servers.Count > 0)
                await LoadInstanceScopedDataAsync(_servers[0].Id);
        }
        catch (Exception ex)
        {
            _error = "Could not load: " + ex.Message;
        }
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_instance is null) return;
        try
        {
            if (!_hubStarted)
            {
                await JS.InvokeVoidAsync("hub_start", _receiver!);
                _hubStarted = true;
            }
            _jsReady = true;
            await EnsureChartsAsync();
        }
        catch
        {
            // JS not ready yet (static prerender pass) -- retried on the next render.
        }
    }

    private async Task LoadInstanceScopedDataAsync(int serverId)
    {
        var instances = await Instances.ListByServerAsync(serverId);
        _instance = instances.FirstOrDefault();
        if (_instance is null) return;

        _models = (await Models.ListByServerAsync(serverId)).ToList();
        _recipes = (await Recipes.ListByServerAsync(serverId)).ToList();

        await RefreshDeploymentStateAsync();
    }

    private async Task RefreshDeploymentStateAsync()
    {
        if (_instance is null) return;
        if (_onboarding is { ShouldShow: true, HasDeployment: false })
            _onboarding = await Onboarding.GetStatusAsync(); // re-check after a swap -- step 4 may have just completed
        _activeDeployment = await Deployments.GetActiveAsync(_instance.Id);
        _pendingDeployment = await Deployments.GetPendingAsync(_instance.Id);

        _activeModel = _activeDeployment is null ? null : _models.FirstOrDefault(m => m.Id == _activeDeployment.ModelId);
        _activeRecipe = _activeDeployment is null ? null : _recipes.FirstOrDefault(r => r.Id == _activeDeployment.RecipeId);

        var history = (await Deployments.ListByInstanceAsync(_instance.Id)).ToList();
        _recentDeployments = history.Where(d => d.Id != _activeDeployment?.Id && d.Id != _pendingDeployment?.Id).Take(5).ToList();

        _canRollback = history.Any(d => d.Id != _activeDeployment?.Id && d.Status == "stopped");

        if (_activeDeployment is null && _pendingDeployment is null)
        {
            var last = history.FirstOrDefault();
            _lastFailed = last is { Status: "stopped" or "failed" } && last.FailureReason is not null ? last : null;
            _lastWorking = history.FirstOrDefault(d => d.Status == "stopped" && d.FailureReason is null)
                ?? history.FirstOrDefault(d => d.FailureReason is null);
            if (_lastWorking is not null)
            {
                _lastWorkingModelName = NameFor(_lastWorking.ModelId, _models);
                _lastWorkingRecipeName = NameFor(_lastWorking.RecipeId, _recipes);
            }
        }
        else
        {
            _lastFailed = null;
            _lastWorking = null;
        }

        await RefreshGpuAsync();
        StateHasChanged();
    }

    private async Task RefreshGpuAsync()
    {
        if (_instance?.AdminUrl is null) { _gpuInfo = null; return; }
        var token = await TokenProvider.GetTokenAsync(_instance.Id);
        if (token is null) { _gpuInfo = null; return; }
        try
        {
            _gpuInfo = await SupervisorClient.GetGpuAsync(_instance.AdminUrl, token);
        }
        catch
        {
            _gpuInfo = null;
        }
    }

    private static string NameFor(int id, List<Model> models) => models.FirstOrDefault(m => m.Id == id)?.Name ?? $"#{id}";
    private static string NameFor(int id, List<Recipe> recipes) => recipes.FirstOrDefault(r => r.Id == id)?.Name ?? $"#{id}";

    private string UptimeText()
    {
        if (_activeDeployment?.StartedAt is not { } started) return "—";
        var span = DateTime.UtcNow - started;
        return span.TotalHours >= 1 ? $"{(int)span.TotalHours}h {span.Minutes}m" : $"{span.Minutes}m {span.Seconds}s";
    }

    private string VramText() => _gpuInfo is { TotalMb: { } total and > 0, UsedMb: { } used }
        ? $"{(used * 100.0 / total):0}%"
        : "n/a";

    private string ReqPerSecText() => _latestSample?.ReqTps is { } v ? v.ToString("0.#") : "—";

    private void OpenCeremony(int? resumeDeploymentId, bool rollback = false)
    {
        if (rollback)
        {
            _ = RollbackDirectAsync();
            return;
        }
        _resumeDeploymentId = resumeDeploymentId;
        _swapOpen = true;
    }

    private async Task RollbackDirectAsync()
    {
        try
        {
            var result = await Swap.RollbackAsync(_instance!.Id);
            _resumeDeploymentId = result.DeploymentId;
            _swapOpen = true;
        }
        catch (Exception ex)
        {
            _error = "Rollback failed: " + ex.Message;
        }
    }

    private async Task RedeployLastWorkingAsync()
    {
        if (_lastWorking is null || _instance is null) return;
        try
        {
            var result = await Swap.SwapAsync(_instance.Id, _lastWorking.ModelId, _lastWorking.RecipeId, acknowledgeServedNameChange: true);
            _resumeDeploymentId = result.DeploymentId;
            _swapOpen = true;
        }
        catch (Exception ex)
        {
            _error = "Could not re-deploy: " + ex.Message;
        }
    }

    private async Task CloseCeremonyAsync()
    {
        _swapOpen = false;
        _resumeDeploymentId = null;
        await RefreshDeploymentStateAsync();
    }

    private async Task StopAsync()
    {
        if (_instance is null) return;
        try
        {
            var result = await Swap.StopAsync(_instance.Id);
            if (result.Vram.Released)
            {
                _vramWarning = null;
                _vramReleasedMessage = $"VRAM released: {result.Vram.UsedMb ?? 0} / {result.Vram.TotalMb ?? 0} MB used ✓";
            }
            else
            {
                _vramReleasedMessage = null;
                _vramWarning = $"VRAM may not be fully released: {result.Vram.UsedMb ?? 0} / {result.Vram.TotalMb ?? 0} MB still used.";
            }
            await RefreshDeploymentStateAsync();
        }
        catch (Exception ex)
        {
            _error = "Stop failed: " + ex.Message;
        }
    }

    private async Task RecheckVramAsync()
    {
        await RefreshGpuAsync();
        if (_gpuInfo is { UsedMb: { } used, TotalMb: { } total })
        {
            if (used <= 0)
            {
                _vramWarning = null;
                _vramReleasedMessage = $"VRAM released: {used} / {total} MB used ✓";
            }
            else
            {
                _vramWarning = $"VRAM may not be fully released: {used} / {total} MB still used.";
            }
        }
        StateHasChanged();
    }

    private async Task HardResetAsync()
    {
        if (_instance?.ContainerName is null)
        {
            await Dialogs.AlertAsync("This instance has no container name recorded -- hard reset isn't available yet.");
            return;
        }
        var confirmed = await Dialogs.ConfirmAsync(
            "This forcibly restarts the instance's container, dropping any in-flight requests. Continue?",
            title: "Hard reset container?", confirmText: "Hard reset");
        if (!confirmed) return;
        // Deliberately not wired to a live Docker host in this phase -- see
        // PROGRESS.md / testing-reference.md for why (same standing rule P12 hit).
        await Dialogs.AlertAsync("Hard reset is not wired to a live Docker host in this build.");
    }

    [JSInvokable]
    public Task OnSample(string json) => InvokeAsync(async () =>
    {
        if (string.IsNullOrWhiteSpace(json) || _instance is null) return;
        MetricsSample? s;
        try { s = JsonSerializer.Deserialize<MetricsSample>(json, JsonOpts); }
        catch { return; }
        if (s is null || s.SourceId != Dashboard.Web.Metrics.InstanceMetricsPollingService.SourceIdFor(_instance.Id)) return;

        _latestSample = s;
        await PushToChartsAsync(s);
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnConfigUpdated() => Task.CompletedTask;

    private async Task EnsureChartsAsync()
    {
        if (_instance is null || !_jsReady) return;
        var sourceId = Dashboard.Web.Metrics.InstanceMetricsPollingService.SourceIdFor(_instance.Id);

        if (_hubJoinedSourceId != sourceId)
        {
            if (_hubJoinedSourceId is not null)
                await JS.InvokeVoidAsync("hub_leave", _hubJoinedSourceId);
            await JS.InvokeVoidAsync("hub_join", sourceId);
            _hubJoinedSourceId = sourceId;
        }

        if (_chartKey == sourceId) return;
        await JS.InvokeVoidAsync("chart_dispose_all");
        _chartKey = sourceId;

        await JS.InvokeVoidAsync("chart_create", "ov2-throughput",
            new List<Dictionary<string, string>>
            {
                new() { ["key"] = "gen", ["label"] = "generation", ["color"] = "#4c8dff" },
                new() { ["key"] = "prompt", ["label"] = "prompt", ["color"] = "#31c06b" },
            }, new { });
        await JS.InvokeVoidAsync("chart_create", "ov2-kv",
            new List<Dictionary<string, string>> { new() { ["key"] = "kv", ["label"] = "kv cache %", ["color"] = "#f5a524" } },
            new { yMin = 0.0, yMax = 100.0 });
    }

    private Task PushToChartsAsync(MetricsSample s)
    {
        var label = s.Ts.ToLocalTime().ToString("HH:mm:ss");
        var cap = Math.Max(10, (_windowMinutes * 60) / Math.Max(1, _instance?.PollIntervalMs / 1000 ?? 1));
        var groups = new Dictionary<string, Dictionary<string, double?>>
        {
            ["ov2-throughput"] = new() { ["gen"] = s.GenTps, ["prompt"] = s.PromptTps },
            ["ov2-kv"] = new() { ["kv"] = s.KvPct },
        };
        return JS.InvokeVoidAsync("chart_push_all", label, groups, cap).AsTask();
    }

    private async Task OnWindowChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var m) && m is 1 or 5 or 30)
            _windowMinutes = m;
        _chartKey = null;
        await EnsureChartsAsync();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_hubJoinedSourceId is not null)
                await JS.InvokeVoidAsync("hub_leave", _hubJoinedSourceId);
        }
        catch
        {
            // Circuit may already be gone.
        }
        _receiver?.Dispose();
    }
}
