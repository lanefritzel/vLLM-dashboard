@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Text.Json
@using Dashboard.Core.Abstractions
@using Dashboard.Core.Models
@using Dashboard.Core.Supervisor
@using Dashboard.Infrastructure.Persistence.V2
@using Dashboard.Web.Components.Overview
@using Microsoft.JSInterop
@inject IServerService Servers
@inject IInstanceService Instances
@inject IModelService Models
@inject IRecipeService Recipes
@inject IDeploymentService Deployments
@inject ISwapService Swap
@inject ISupervisorClient SupervisorClient
@inject IJSRuntime JS
@inject Dashboard.Web.Components.Shared.IDialogService Dialogs
@inject IOnboardingService Onboarding
@inject IBootReconciler Reconciler
@inject IMetricsHistory History

<PageTitle>Overview — vLLM Dashboard</PageTitle>

<h1 class="page-title">Overview</h1>

@if (_onboarding is { ShouldShow: true })
{
    <div class="card mb-3" style="border-left: 3px solid var(--ui-info);">
        <div class="card-body">
            <div class="card-title mb-2">Get started</div>
            <ol class="onboarding-checklist mb-0">
                <li class="@(_onboarding.HasServerAndInstance ? "text-muted" : "")">
                    @(_onboarding.HasServerAndInstance ? "✓" : "①") Register a server and instance
                    @if (!_onboarding.HasServerAndInstance)
                    {
                        <a href="servers">— go to Servers</a>
                    }
                </li>
                <li class="@(_onboarding.HasModel ? "text-muted" : "")">
                    @(_onboarding.HasModel ? "✓" : "②") Add or download a model
                    @if (_onboarding.HasServerAndInstance && !_onboarding.HasModel)
                    {
                        <a href="models-recipes">— go to Models &amp; Recipes</a>
                    }
                </li>
                <li class="@(_onboarding.HasRecipe ? "text-muted" : "")">
                    @(_onboarding.HasRecipe ? "✓" : "③") Create a recipe from it
                    @if (_onboarding.HasModel && !_onboarding.HasRecipe)
                    {
                        <a href="models-recipes">— go to Models &amp; Recipes</a>
                    }
                </li>
                <li class="@(_onboarding.HasDeployment ? "text-muted" : "")">
                    @(_onboarding.HasDeployment ? "✓" : "④") Do your first swap
                </li>
            </ol>
        </div>
    </div>
}

@if (_loading)
{
    <p class="text-muted">Loading…</p>
}
else if (_instance is null)
{
    <div class="card"><div class="card-body">
        <p class="text-muted mb-0">No instance configured yet. Register one on the Servers page.</p>
    </div></div>
}
else
{
    @if (!string.IsNullOrEmpty(_error))
    {
        <Callout Tone="danger">@_error</Callout>
    }

    @if (_pendingDeployment is not null && !_swapOpen)
    {
        <div class="ui-toolbar" style="margin-bottom: var(--ui-space-3);">
            <StatusPill Status="swapping" />
            <span class="text-muted">A swap is in progress on this instance.</span>
            <div class="ui-toolbar-spacer"></div>
            <UiButton Variant="secondary" Size="sm" OnClick="@(() => OpenCeremony(_pendingDeployment.Id))">View progress</UiButton>
        </div>
    }
    else if (_activeDeployment is not null && _reconcile?.Status is null or ReconcileStatus.Ok)
    {
        <div class="ui-toolbar" style="margin-bottom: 2px;">
            <StatusPill Status="running" />
            <span class="text-muted">Serving: @(_activeModel?.Name ?? "—") · recipe: @(_activeRecipe?.Name ?? "—") · @_instance.Label</span>
            <div class="ui-toolbar-spacer"></div>
            <UiButton Variant="primary" Size="sm" OnClick="@(() => OpenCeremony(null))">Swap</UiButton>
            <a class="ui-btn ui-btn-secondary ui-btn-sm" href="@("/proxy/" + _instance.ProxySlug + "/v1")" target="_blank">Playground</a>
            <UiButton Variant="secondary" Size="sm" OnClick="StopAsync">Stop</UiButton>
            <UiButton Variant="secondary" Size="sm" Disabled="@(!_canRollback)" OnClick="@(() => OpenCeremony(null, rollback: true))">Rollback</UiButton>
        </div>
        <div class="ui-meta-row" style="margin: 0 0 var(--ui-space-3);">
            <Chip Static="true">proxy: <code>/proxy/@(_instance.ProxySlug)/v1</code></Chip>
            <Chip Static="true">served as "@(_activeRecipe?.ServedModelName ?? "main")"</Chip>
            <Chip Static="true">Uptime @UptimeText()</Chip>
            <Chip Static="true">VRAM @VramText()</Chip>
            <Chip Static="true">@(_latestSample is null ? "—" : _latestSample.Running.ToString()) running</Chip>
        </div>

        @if (_vramWarning is not null)
        {
            <Callout Tone="warn" Action="@VramWarningActions">@_vramWarning</Callout>
        }
        @if (_vramReleasedMessage is not null)
        {
            <Callout Tone="success">@_vramReleasedMessage</Callout>
        }
    }
    else if (_activeDeployment is not null && IsSupervisorBusy)
    {
        <div class="ui-toolbar" style="margin-bottom: 2px;">
            <StatusPill Status="swapping" />
            <span class="text-muted">
                Last known config: @(_activeModel?.Name ?? "—") · recipe: @(_activeRecipe?.Name ?? "—") · @_instance.Label
                — supervisor is currently @SupervisorStateText(_reconcile?.SupervisorState).
            </span>
        </div>
    }
    else
    {
        <div class="ui-toolbar" style="margin-bottom: 2px;">
            <StatusPill Status="stopped" />
            <span class="text-muted">No active model — instance is idle.</span>
            <div class="ui-toolbar-spacer"></div>
            @if (_lastWorking is not null)
            {
                <UiButton Variant="primary" Size="sm" Disabled="@_redeployBusy" OnClick="RedeployLastWorkingAsync">
                    @(_redeployBusy ? "Re-deploying…" : $"Re-deploy: {_lastWorkingModelName} · {_lastWorkingRecipeName}")
                </UiButton>
            }
            <UiButton Variant="secondary" Size="sm" OnClick="@(() => OpenCeremony(null))">Pick a recipe</UiButton>
        </div>

        @if (_lastFailed is not null)
        {
            <Callout Tone="danger">Last run failed — @(_lastFailed.FailureReason ?? "unknown reason") (code @(_lastFailed.ExitCode?.ToString() ?? "n/a"))</Callout>
        }
        @if (_vramWarning is not null)
        {
            <Callout Tone="warn" Action="@VramWarningActions">@_vramWarning</Callout>
        }
        @if (_vramReleasedMessage is not null)
        {
            <Callout Tone="success">@_vramReleasedMessage</Callout>
        }
    }

    <div class="ui-toolbar" style="margin-bottom: var(--ui-space-3);">
        <span class="ui-stat-label">Live metrics</span>
        <div class="ui-toolbar-spacer"></div>
        <SegmentedControl Items="_windowItems" Value="@_windowMinutes.ToString()" ValueChanged="OnWindowChangedAsync" />
    </div>

    @if (_latestSample is null)
    {
        <UiPanel><EmptyState Variant="no-data" Description="No traffic in this window." /></UiPanel>
    }
    else
    {
        <div class="ui-stat-grid" style="margin-bottom: var(--ui-space-3);">
            <StatCard Label="Throughput" Value="@Fmt(_latestSample?.GenTps)" Unit="tok/s live">
                <Sparkline><div class="chart-wrap" style="height:100%;margin-bottom:0;"><canvas id="ov2-throughput-spark"></canvas></div></Sparkline>
            </StatCard>
            <StatCard Label="Peak (30d)" Value="@Fmt(_genStats?.Peak)" Unit="tok/s" Info="Peak generation throughput, last 30 days" />
            <StatCard Label="Avg (30d)" Value="@Fmt(_genStats?.Avg)" Unit="tok/s" Info="Average generation throughput while actively generating, last 30 days" />
            <StatCard Label="Low (30d)" Value="@Fmt(_genStats?.Low)" Unit="tok/s" Info="Lowest generation throughput while actively generating, last 30 days" />
            <StatCard Label="KV cache" Value="@Fmt(_latestSample?.KvPct)" Unit="%">
                <Sparkline><div class="chart-wrap" style="height:100%;margin-bottom:0;"><canvas id="ov2-kv-spark"></canvas></div></Sparkline>
            </StatCard>
        </div>
        <div class="ui-toolbar" style="margin-bottom: 0;">
            <UiButton Variant="link" Size="sm" OnClick="ToggleExpandChartAsync">@(_expandChart ? "Hide full chart" : "Show full chart")</UiButton>
            <a href="javascript:void(0)" class="gen-stats-reset" title="Delete generation history and reset these stats" @onclick="ResetGenStatsAsync">reset stats</a>
        </div>
        @if (_expandChart)
        {
            <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(320px, 1fr)); gap: var(--ui-space-4); margin-top: var(--ui-space-3);">
                <ChartCard Title="Throughput (tok/s)">
                    <div class="chart-wrap"><canvas id="ov2-throughput"></canvas></div>
                </ChartCard>
                <ChartCard Title="KV cache usage (%)">
                    <div class="chart-wrap"><canvas id="ov2-kv"></canvas></div>
                </ChartCard>
            </div>
        }
    }

    @if (_recentDeployments.Count > 0)
    {
        <div style="height: var(--ui-space-4);"></div>
        <UiPanel Title="Recent swaps" Flush="true">
            <TableShell Caption="Recent swaps" ColumnCount="5">
                <Header>
                    <th scope="col">Model</th>
                    <th scope="col">Recipe</th>
                    <th scope="col">Status</th>
                    <th scope="col">Stopped by</th>
                    <SortableHeader Label="When" Direction="@(_recentSortAscending ? "ascending" : "descending")" OnSort="ToggleRecentSort" />
                </Header>
                <ChildContent>
                    @foreach (var d in SortedRecentDeployments)
                    {
                        <tr>
                            <td>@NameFor(d.ModelId, _models)</td>
                            <td>@NameFor(d.RecipeId, _recipes)</td>
                            <td><StatusPill Status="@d.Status" Size="sm" /></td>
                            <td>@(d.StopReason ?? "—")</td>
                            <td>@((d.StoppedAt ?? d.CreatedAt).ToLocalTime().ToString("MMM d, HH:mm"))</td>
                        </tr>
                    }
                </ChildContent>
            </TableShell>
        </UiPanel>
    }
}

@if (_swapOpen && _instance is not null)
{
    <SwapCeremonyDialog Instance="@_instance" CurrentModel="@_activeModel" CurrentRecipe="@_activeRecipe"
                         Models_="@_models" Recipes_="@_recipes" ResumeDeploymentId="@_resumeDeploymentId"
                         OnClosed="@CloseCeremonyAsync" OnDeploymentSettled="@RefreshDeploymentStateAsync" />
}

@code {
    private static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    private bool _loading = true;
    private OnboardingStatus? _onboarding;
    private string? _error;

    private List<Server> _servers = new();
    private Instance? _instance;
    private List<Model> _models = new();
    private List<Recipe> _recipes = new();
    private Deployment? _activeDeployment;
    private Deployment? _pendingDeployment;
    private ReconcileState? _reconcile;
    private Model? _activeModel;
    private Recipe? _activeRecipe;
    private List<Deployment> _recentDeployments = new();
    private Deployment? _lastFailed;
    private Deployment? _lastWorking;
    private string _lastWorkingModelName = "";
    private string _lastWorkingRecipeName = "";
    private bool _canRollback;
    private bool _redeployBusy;

    private bool _swapOpen;
    private int? _resumeDeploymentId;

    private string? _vramWarning;
    private string? _vramReleasedMessage;
    private SupervisorGpuInfo? _gpuInfo;

    private DotNetObjectReference<Overview>? _receiver;
    private Task? _hubStartTask;
    private bool _jsReady;
    private int _windowMinutes = 5;
    private string? _chartKey;
    private string? _expandedChartKey;
    private bool _expandChart = true;
    private MetricsSample? _latestSample;
    private string? _hubJoinedSourceId;
    private bool _recentSortAscending;

    private readonly IReadOnlyList<(string Key, string Label)> _windowItems =
        [("1", "1 min"), ("5", "5 min"), ("30", "30 min")];

    private IEnumerable<Deployment> SortedRecentDeployments =>
        _recentSortAscending ? _recentDeployments.AsEnumerable().Reverse() : _recentDeployments;

    private void ToggleRecentSort() => _recentSortAscending = !_recentSortAscending;

    private RenderFragment VramWarningActions => @<text>
        <UiButton Variant="secondary" Size="sm" OnClick="RecheckVramAsync">Re-check</UiButton>
        <UiButton Variant="secondary" Size="sm" OnClick="HardResetAsync">Hard reset container</UiButton>
    </text>;

    private static readonly TimeSpan GenStatsWindow = TimeSpan.FromDays(30);
    private GenerationThroughputStats? _genStats;
    private DateTime _genStatsLastRefresh = DateTime.MinValue;

    // Periodic re-poll of deployment/reconcile state (P16a finding, 2026-11-05):
    // a supervisor-driven boot-replay never pushes events to the dashboard (its
    // deployment id isn't one the dashboard issued -- see deploy_runner.py's
    // _should_push), so without this, a tab left open during one never learns
    // the model finished loading until the user manually reloads the page.
    private static readonly TimeSpan ReconcilePollInterval = TimeSpan.FromSeconds(7);
    private System.Threading.Timer? _reconcilePollTimer;
    private bool _reconcilePollRunning;

    /// <summary>True when the DB still has an active deployment row but the
    /// supervisor itself is reporting a real, in-progress, non-idle state --
    /// a boot-replay in flight, not a genuine stop. Drives which status banner
    /// (and which action buttons) the "no Ok reconcile" branch below shows.</summary>
    private bool IsSupervisorBusy =>
        _reconcile?.Status == ReconcileStatus.IdleVsActive
        && _reconcile.SupervisorState is { } s && s is not ("idle" or "ready");

    private static string SupervisorStateText(string? state) => state switch
    {
        "loading" => "loading the model",
        "waiting_health" => "waiting for the health check",
        "starting" => "starting",
        "stopping" => "stopping the previous model",
        "releasing_gpu" => "releasing GPU memory",
        "smoke" => "running a startup smoke test",
        null => "unavailable",
        var other => other,
    };

    protected override async Task OnInitializedAsync()
    {
        _receiver = DotNetObjectReference.Create(this);
        try
        {
            _onboarding = await Onboarding.GetStatusAsync();
            _servers = (await Servers.ListAsync()).ToList();
            if (_servers.Count > 0)
                await LoadInstanceScopedDataAsync(_servers[0].Id);
        }
        catch (Exception ex)
        {
            _error = "Could not load: " + ex.Message;
        }
        _loading = false;

        _reconcilePollTimer = new System.Threading.Timer(
            _ => _ = PollReconcileAsync(), null, ReconcilePollInterval, ReconcilePollInterval);
    }

    private async Task PollReconcileAsync()
    {
        // Timer callbacks run on a thread-pool thread, outside Blazor's render
        // sync context -- InvokeAsync marshals back onto it, and the running
        // flag skips a tick if the previous one is still in flight rather than
        // piling up overlapping polls.
        if (_reconcilePollRunning || _instance is null) return;
        _reconcilePollRunning = true;
        try
        {
            await InvokeAsync(RefreshDeploymentStateAsync);
        }
        catch
        {
            // Circuit may be gone (page navigated away/closed) -- next tick
            // either recovers or the timer gets disposed shortly after.
        }
        finally
        {
            _reconcilePollRunning = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_instance is null) return;
        try
        {
            // Shared in-flight task, not a bool flag (matches LiveTraffic.razor's
            // _hubStartTask) -- the periodic reconcile poll below forces a fresh
            // OnAfterRenderAsync every few seconds for the page's whole lifetime,
            // not just once at startup, so a bool set "before awaiting" still has
            // a window where a second concurrent render sees it as already true
            // AFTER the single flag flip but BEFORE the connection is actually
            // negotiated -- no, worse: a bool can't tell "already in flight" from
            // "never started", so two renders landing back to back could each
            // decide to (re)start hub_start, and hub.js's hub_start stops whatever
            // connection already exists to make room for the new one, aborting a
            // join mid-flight every time it happens. Assigning ??= here is atomic
            // and synchronous -- a second concurrent render always awaits the
            // exact same Task instance instead of ever calling hub_start twice.
            _hubStartTask ??= JS.InvokeVoidAsync("hub_start", _receiver!).AsTask();
            await _hubStartTask;
            _jsReady = true;
            await EnsureChartsAsync();
        }
        catch
        {
            // JS not ready yet (static prerender pass) -- retried on the next render.
            _hubStartTask = null;
        }
    }

    private async Task LoadInstanceScopedDataAsync(int serverId)
    {
        var instances = await Instances.ListByServerAsync(serverId);
        _instance = instances.FirstOrDefault();
        if (_instance is null) return;

        _models = (await Models.ListByServerAsync(serverId)).ToList();
        _recipes = (await Recipes.ListByServerAsync(serverId)).ToList();

        await RefreshDeploymentStateAsync();
    }

    private async Task RefreshDeploymentStateAsync()
    {
        if (_instance is null) return;
        if (_onboarding is { ShouldShow: true, HasDeployment: false })
            _onboarding = await Onboarding.GetStatusAsync(); // re-check after a swap -- step 4 may have just completed
        _activeDeployment = await Deployments.GetActiveAsync(_instance.Id);
        _pendingDeployment = await Deployments.GetPendingAsync(_instance.Id);

        // The DB's own "active deployment" row is only ever cleared once a LATER
        // swap actually succeeds (by design -- a failed swap attempt leaves the
        // previous row's bookkeeping alone, since that's still "what's supposed
        // to be running"). But the supervisor never auto-restarts anything after
        // a failed deploy (also by design), so a DB-active row can easily be
        // pointing at a process that's actually dead. Confirmed the hard way
        // during P16a's real-hardware rehearsal: the banner confidently showed
        // "Ready -- Serving... Uptime 1h 56m" for a model that had crashed over
        // a minute earlier. Cross-check against the supervisor's live status
        // (the same reconcile the Instances page already uses) before trusting
        // the DB row for display.
        try { _reconcile = await Reconciler.ReconcileInstanceAsync(_instance.Id); }
        catch { _reconcile = null; }

        _activeModel = _activeDeployment is null ? null : _models.FirstOrDefault(m => m.Id == _activeDeployment.ModelId);
        _activeRecipe = _activeDeployment is null ? null : _recipes.FirstOrDefault(r => r.Id == _activeDeployment.RecipeId);

        var history = (await Deployments.ListByInstanceAsync(_instance.Id)).ToList();
        _recentDeployments = history.Where(d => d.Id != _activeDeployment?.Id && d.Id != _pendingDeployment?.Id).Take(5).ToList();

        _canRollback = history.Any(d => d.Id != _activeDeployment?.Id && d.Status == "stopped");

        var reallyIdle = _reconcile?.Status == ReconcileStatus.IdleVsActive;
        if ((_activeDeployment is null || reallyIdle) && _pendingDeployment is null)
        {
            var last = history.FirstOrDefault();
            _lastFailed = last is { Status: "stopped" or "failed" } && last.FailureReason is not null ? last : null;
            _lastWorking = history.FirstOrDefault(d => d.Status == "stopped" && d.FailureReason is null)
                ?? history.FirstOrDefault(d => d.FailureReason is null);
            if (_lastWorking is not null)
            {
                _lastWorkingModelName = NameFor(_lastWorking.ModelId, _models);
                _lastWorkingRecipeName = NameFor(_lastWorking.RecipeId, _recipes);
            }
        }
        else
        {
            _lastFailed = null;
            _lastWorking = null;
        }

        await RefreshGpuAsync();
        StateHasChanged();
    }

    private async Task RefreshGpuAsync()
    {
        if (_instance?.AdminUrl is null) { _gpuInfo = null; return; }
        try
        {
            _gpuInfo = await SupervisorClient.GetGpuAsync(_instance.AdminUrl);
        }
        catch
        {
            _gpuInfo = null;
        }
    }

    private static string NameFor(int id, List<Model> models) => models.FirstOrDefault(m => m.Id == id)?.Name ?? $"#{id}";
    private static string NameFor(int id, List<Recipe> recipes) => recipes.FirstOrDefault(r => r.Id == id)?.Name ?? $"#{id}";

    private string UptimeText()
    {
        if (_activeDeployment?.StartedAt is not { } started) return "—";
        var span = DateTime.UtcNow - started;
        return span.TotalHours >= 1 ? $"{(int)span.TotalHours}h {span.Minutes}m" : $"{span.Minutes}m {span.Seconds}s";
    }

    private string VramText() => _gpuInfo is { TotalMb: { } total and > 0, UsedMb: { } used }
        ? $"{(used * 100.0 / total):0}%"
        : "n/a";

    private void OpenCeremony(int? resumeDeploymentId, bool rollback = false)
    {
        if (rollback)
        {
            _ = RollbackDirectAsync();
            return;
        }
        _resumeDeploymentId = resumeDeploymentId;
        _swapOpen = true;
    }

    private async Task RollbackDirectAsync()
    {
        try
        {
            var result = await Swap.RollbackAsync(_instance!.Id);
            _resumeDeploymentId = result.DeploymentId;
            _swapOpen = true;
        }
        catch (Exception ex)
        {
            _error = "Rollback failed: " + ex.Message;
        }
    }

    private async Task RedeployLastWorkingAsync()
    {
        if (_lastWorking is null || _instance is null || _redeployBusy) return;
        _redeployBusy = true;
        try
        {
            // If the "last working" deployment IS the DB's current active row
            // (the IdleVsActive case: the supervisor crashed/died after it, but
            // nothing ever flipped the DB's own active flag), a plain SwapAsync
            // would silently no-op via its own "already active" short-circuit --
            // same (model, recipe) pair, as far as the DB can tell. ForceRedeployAsync
            // exists specifically to bypass that for this exact mismatch. A
            // genuinely idle instance (no active row at all) still goes through
            // the normal SwapAsync path.
            var result = _activeDeployment is not null && _activeDeployment.Id == _lastWorking.Id
                ? await Swap.ForceRedeployAsync(_instance.Id)
                : await Swap.SwapAsync(_instance.Id, _lastWorking.ModelId, _lastWorking.RecipeId, acknowledgeServedNameChange: true);
            _resumeDeploymentId = result.DeploymentId;
            _swapOpen = true;
        }
        catch (Exception ex)
        {
            _error = "Could not re-deploy: " + ex.Message;
        }
        finally
        {
            _redeployBusy = false;
        }
    }

    private async Task CloseCeremonyAsync()
    {
        _swapOpen = false;
        _resumeDeploymentId = null;
        await RefreshDeploymentStateAsync();
    }

    private async Task StopAsync()
    {
        if (_instance is null) return;
        try
        {
            var result = await Swap.StopAsync(_instance.Id);
            if (result.Vram.Released)
            {
                _vramWarning = null;
                _vramReleasedMessage = $"VRAM released: {result.Vram.UsedMb ?? 0} / {result.Vram.TotalMb ?? 0} MB used ✓";
            }
            else
            {
                _vramReleasedMessage = null;
                _vramWarning = $"VRAM may not be fully released: {result.Vram.UsedMb ?? 0} / {result.Vram.TotalMb ?? 0} MB still used.";
            }
            await RefreshDeploymentStateAsync();
        }
        catch (Exception ex)
        {
            _error = "Stop failed: " + ex.Message;
        }
    }

    private async Task RecheckVramAsync()
    {
        await RefreshGpuAsync();
        if (_gpuInfo is { UsedMb: { } used, TotalMb: { } total })
        {
            if (used <= 0)
            {
                _vramWarning = null;
                _vramReleasedMessage = $"VRAM released: {used} / {total} MB used ✓";
            }
            else
            {
                _vramWarning = $"VRAM may not be fully released: {used} / {total} MB still used.";
            }
        }
        StateHasChanged();
    }

    private async Task HardResetAsync()
    {
        if (_instance?.ContainerName is null)
        {
            await Dialogs.AlertAsync("This instance has no container name recorded -- hard reset isn't available yet.");
            return;
        }
        var confirmed = await Dialogs.ConfirmAsync(
            "This forcibly restarts the instance's container, dropping any in-flight requests. Continue?",
            title: "Hard reset container?", confirmText: "Hard reset");
        if (!confirmed) return;
        // Deliberately not wired to a live Docker host in this phase -- see
        // PROGRESS.md / testing-reference.md for why (same standing rule P12 hit).
        await Dialogs.AlertAsync("Hard reset is not wired to a live Docker host in this build.");
    }

    [JSInvokable]
    public Task OnSample(string json) => InvokeAsync(async () =>
    {
        if (string.IsNullOrWhiteSpace(json) || _instance is null) return;
        MetricsSample? s;
        try { s = JsonSerializer.Deserialize<MetricsSample>(json, JsonOpts); }
        catch { return; }
        if (s is null || s.SourceId != Dashboard.Web.Metrics.InstanceMetricsPollingService.SourceIdFor(_instance.Id)) return;

        _latestSample = s;
        await PushToChartsAsync(s);

        // Peak/low only ever need a running max/min against the live value — cheap
        // and instant, no need to wait for the periodic DB refresh below for those.
        // Avg can't be maintained incrementally without also removing samples that
        // age out of the rolling window, so it's just re-queried periodically instead
        // (only while samples are actually arriving — nothing changes while idle).
        if (s.GenTps is > 0)
        {
            _genStats = _genStats is null
                ? new GenerationThroughputStats { Peak = s.GenTps.Value, Avg = s.GenTps.Value, Low = s.GenTps.Value }
                : _genStats with { Peak = Math.Max(_genStats.Peak, s.GenTps.Value), Low = Math.Min(_genStats.Low, s.GenTps.Value) };
            await RefreshGenStatsAsync(s.SourceId, force: false);
        }

        StateHasChanged();
    });

    private async Task RefreshGenStatsAsync(string sourceId, bool force)
    {
        if (!force && DateTime.UtcNow - _genStatsLastRefresh < TimeSpan.FromSeconds(60))
            return;
        _genStatsLastRefresh = DateTime.UtcNow;
        try
        {
            _genStats = await History.GetActiveGenerationStatsAsync(sourceId, GenStatsWindow);
        }
        catch
        {
            // Best-effort — keep whatever we already had rather than blanking the card.
        }
    }

    private async Task ResetGenStatsAsync()
    {
        if (_instance is null) return;
        var sourceId = Dashboard.Web.Metrics.InstanceMetricsPollingService.SourceIdFor(_instance.Id);

        var ok = await Dialogs.ConfirmAsync(
            "This permanently deletes all generation history for this instance — the Peak/Avg/Low stats above and the History views for it will be empty until new data comes in. This cannot be undone.",
            title: "Clear generation stats?",
            confirmText: "Clear");
        if (!ok) return;

        try
        {
            await History.ClearAsync(sourceId);
        }
        catch
        {
            return;
        }

        _genStats = null;
        await RefreshGenStatsAsync(sourceId, force: true);
        StateHasChanged();
    }

    private static string Fmt(double? v) => v is null ? "—" : v.Value.ToString("0.#");

    [JSInvokable]
    public Task OnConfigUpdated() => Task.CompletedTask;

    private async Task EnsureChartsAsync()
    {
        if (_instance is null || !_jsReady) return;
        var sourceId = Dashboard.Web.Metrics.InstanceMetricsPollingService.SourceIdFor(_instance.Id);

        if (_hubJoinedSourceId != sourceId)
        {
            if (_hubJoinedSourceId is not null)
                await JS.InvokeVoidAsync("hub_leave", _hubJoinedSourceId);
            await JS.InvokeVoidAsync("hub_join", sourceId);
            _hubJoinedSourceId = sourceId;
            _genStats = null;
            await RefreshGenStatsAsync(sourceId, force: true);
        }

        // chart_create can genuinely fail on its first attempt -- e.g. right
        // after this card's own @if block flips from hidden to visible, the
        // canvas may not have reached the DOM yet even though OnAfterRenderAsync
        // has already fired. Only latch the relevant key (which blocks all
        // future retries) once its charts actually exist; otherwise leave it
        // unset so the next OnAfterRenderAsync call (which already fires on
        // every render, not just the first) tries again. The sparkline charts
        // latch on _chartKey since they're always in the DOM alongside the
        // StatCard row; the full Chart.js view is its own _expandedChartKey
        // since it only exists in the DOM once the user expands it -- sharing
        // one key would mean the sparklines never latch while collapsed.
        if (_chartKey != sourceId)
        {
            await JS.InvokeVoidAsync("chart_dispose_all");

            var throughputSparkOk = await JS.InvokeAsync<bool>("chart_create", "ov2-throughput-spark",
                new List<Dictionary<string, string>> { new() { ["key"] = "gen", ["label"] = "generation", ["color"] = "var(--ui-chart-2)" } },
                new { sparkline = true });
            var kvSparkOk = await JS.InvokeAsync<bool>("chart_create", "ov2-kv-spark",
                new List<Dictionary<string, string>> { new() { ["key"] = "kv", ["label"] = "kv cache %", ["color"] = "var(--ui-chart-6)" } },
                new { yMin = 0.0, yMax = 100.0, sparkline = true });

            if (throughputSparkOk && kvSparkOk)
                _chartKey = sourceId;
        }

        if (_expandChart && _expandedChartKey != sourceId)
        {
            var throughputOk = await JS.InvokeAsync<bool>("chart_create", "ov2-throughput",
                new List<Dictionary<string, object>>
                {
                    new() { ["key"] = "gen", ["label"] = "generation", ["color"] = "var(--ui-chart-2)", ["fill"] = true },
                    new() { ["key"] = "prompt", ["label"] = "prompt", ["color"] = "var(--ui-chart-1)" },
                }, new { });
            var kvOk = await JS.InvokeAsync<bool>("chart_create", "ov2-kv",
                new List<Dictionary<string, string>> { new() { ["key"] = "kv", ["label"] = "kv cache %", ["color"] = "var(--ui-chart-6)" } },
                new { yMin = 0.0, yMax = 100.0 });

            if (throughputOk && kvOk)
                _expandedChartKey = sourceId;
        }
    }

    private Task PushToChartsAsync(MetricsSample s)
    {
        var label = s.Ts.ToLocalTime().ToString("HH:mm:ss");
        var cap = Math.Max(10, (_windowMinutes * 60) / Math.Max(1, _instance?.PollIntervalMs / 1000 ?? 1));
        var groups = new Dictionary<string, Dictionary<string, double?>>
        {
            ["ov2-throughput"] = new() { ["gen"] = s.GenTps, ["prompt"] = s.PromptTps },
            ["ov2-kv"] = new() { ["kv"] = s.KvPct },
            ["ov2-throughput-spark"] = new() { ["gen"] = s.GenTps },
            ["ov2-kv-spark"] = new() { ["kv"] = s.KvPct },
        };
        return JS.InvokeVoidAsync("chart_push_all", label, groups, cap).AsTask();
    }

    private async Task OnWindowChangedAsync(string value)
    {
        if (int.TryParse(value, out var m) && m is 1 or 5 or 30)
            _windowMinutes = m;
        _chartKey = null;
        await EnsureChartsAsync();
    }

    private async Task ToggleExpandChartAsync()
    {
        _expandChart = !_expandChart;
        if (_expandChart) return;

        _expandedChartKey = null;
        try
        {
            await JS.InvokeVoidAsync("chart_dispose", "ov2-throughput");
            await JS.InvokeVoidAsync("chart_dispose", "ov2-kv");
        }
        catch
        {
            // Circuit may already be gone.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_reconcilePollTimer is not null)
            await _reconcilePollTimer.DisposeAsync();
        try
        {
            if (_hubJoinedSourceId is not null)
                await JS.InvokeVoidAsync("hub_leave", _hubJoinedSourceId);
        }
        catch
        {
            // Circuit may already be gone.
        }
        _receiver?.Dispose();
    }
}
