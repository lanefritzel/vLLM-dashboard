@page "/playground"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Text
@using System.Text.Json
@using Dashboard.Core.Abstractions
@using Dashboard.Infrastructure.Persistence.V2
@using Dashboard.Infrastructure.Proxy
@inject IServerService Servers
@inject IInstanceService Instances
@inject IRecipeService Recipes
@inject IDeploymentService Deployments
@inject ISupervisorClient SupervisorClient
@inject ISupervisorTokenProvider TokenProvider
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav

<PageTitle>Playground — vLLM Dashboard</PageTitle>

<h1 class="page-title">Playground <span class="text-muted fs-5">/ @(_instance?.Label ?? "no instance selected")</span></h1>

@if (_instance is null)
{
    <div class="card"><div class="card-body">
        <p class="text-muted mb-0">No instance configured yet.</p>
    </div></div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <form @onsubmit="@RunAsync" @onsubmit:preventDefault="true" class="row g-3">
                <div class="col-md-9">
                    <label class="form-label">Prompt</label>
                    <textarea class="form-control" rows="3" @bind="_prompt"></textarea>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Temperature</label>
                    <input class="form-control" type="number" min="0" max="2" step="0.1" @bind="_temperature" />
                </div>
                <div class="col-md-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm" disabled="@_busy">@(_busy ? "Running…" : "Send")</button>
                    <button type="button" class="btn btn-outline btn-sm" disabled="@_smokeBusy" @onclick="@RunSmokeTestAsync">
                        @(_smokeBusy ? "Testing…" : "Run smoke test")
                    </button>
                    @if (_smokeResult is not null)
                    {
                        <span class="text-muted small align-self-center">@_smokeResult</span>
                    }
                </div>
            </form>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger py-2">@_error</div>
    }

    @if (_responseText.Length > 0 || _busy)
    {
        <div class="card traffic-card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3 flex-wrap mb-2">
                    <span class="text-muted small">TTFT @TtftText()</span>
                    <span class="text-muted small">Total @TotalText()</span>
                    <span class="text-muted small">@TokPerSecText()</span>
                    @if (_busy)
                    {
                        <span class="text-muted small">streaming…</span>
                    }
                </div>

                @if (_reasoningText.Length > 0)
                {
                    <details class="mb-2">
                        <summary class="text-muted small" style="cursor:pointer">Thinking</summary>
                        <pre class="probe-output traffic-reasoning">@_reasoningText.ToString()</pre>
                    </details>
                }

                <div class="text-muted small mb-1">Response</div>
                <pre class="probe-output traffic-response">@(_responseText.Length > 0 ? _responseText.ToString() : "…")</pre>

                <details class="mt-2">
                    <summary class="text-muted small" style="cursor:pointer">Raw request</summary>
                    <pre class="probe-output small">@_rawRequest</pre>
                </details>
                <details class="mt-1">
                    <summary class="text-muted small" style="cursor:pointer">Raw response (SSE)</summary>
                    <pre class="probe-output small">@_rawResponse.ToString()</pre>
                </details>
            </div>
        </div>
    }
}

@code {
    private static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    private Instance? _instance;
    private string? _servedModelName;
    private string _prompt = "Say hello in one short sentence.";
    private double _temperature = 0.7;
    private bool _busy;
    private string? _error;

    private string _rawRequest = "";
    private readonly StringBuilder _rawResponse = new();
    private readonly StringBuilder _responseText = new();
    private readonly StringBuilder _reasoningText = new();
    private DateTime _startedAt;
    private DateTime? _firstTokenAt;
    private DateTime? _finishedAt;

    private bool _smokeBusy;
    private string? _smokeResult;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var servers = (await Servers.ListAsync()).ToList();
            if (servers.Count > 0)
            {
                var instances = await Instances.ListByServerAsync(servers[0].Id);
                _instance = instances.FirstOrDefault();
                if (_instance is not null)
                {
                    var active = await Deployments.GetActiveAsync(_instance.Id);
                    if (active is not null)
                    {
                        var recipe = await Recipes.GetAsync(active.RecipeId);
                        _servedModelName = recipe?.ServedModelName;
                    }
                }
            }
        }
        catch
        {
            // _instance stays null -- the "no instance" branch covers it.
        }
    }

    private async Task RunAsync()
    {
        if (_instance is null || _busy) return;
        _busy = true;
        _error = null;
        _rawResponse.Clear();
        _responseText.Clear();
        _reasoningText.Clear();
        _firstTokenAt = null;
        _finishedAt = null;
        _startedAt = DateTime.UtcNow;

        var body = new
        {
            model = _servedModelName ?? "",
            messages = new[] { new { role = "user", content = _prompt } },
            temperature = _temperature,
            stream = true,
        };
        _rawRequest = JsonSerializer.Serialize(body, new JsonSerializerOptions { WriteIndented = true });

        var baseAuthority = new Uri(Nav.BaseUri).GetLeftPart(UriPartial.Authority);
        var url = $"{baseAuthority}/proxy/{_instance.ProxySlug}/v1/chat/completions";

        try
        {
            var client = HttpClientFactory.CreateClient("playground");
            using var request = new HttpRequestMessage(HttpMethod.Post, url)
            {
                Content = new StringContent(JsonSerializer.Serialize(body), Encoding.UTF8, "application/json"),
            };
            using var response = await client.SendAsync(request, HttpCompletionOption.ResponseHeadersRead);
            using var stream = await response.Content.ReadAsStreamAsync();
            using var reader = new StreamReader(stream);

            string? line;
            while ((line = await reader.ReadLineAsync()) is not null)
            {
                _rawResponse.AppendLine(line);
                if (!line.StartsWith("data:", StringComparison.Ordinal)) continue;
                var payload = line["data:".Length..].Trim();
                if (payload == "[DONE]") break;

                var delta = ModelProxyService.TryExtractDeltaText(payload);
                var reasoning = ModelProxyService.TryExtractReasoningText(payload);
                if (delta is { Length: > 0 } || reasoning is { Length: > 0 })
                {
                    _firstTokenAt ??= DateTime.UtcNow;
                    if (delta is { Length: > 0 }) _responseText.Append(delta);
                    if (reasoning is { Length: > 0 }) _reasoningText.Append(reasoning);
                    StateHasChanged();
                }
            }

            if (!response.IsSuccessStatusCode && _responseText.Length == 0)
                _error = $"Request failed: {(int)response.StatusCode} {response.ReasonPhrase}";
        }
        catch (Exception ex)
        {
            _error = "Request failed: " + ex.Message;
        }

        _finishedAt = DateTime.UtcNow;
        _busy = false;
        StateHasChanged();
    }

    private string TtftText() => _firstTokenAt is { } t ? $"{(t - _startedAt).TotalMilliseconds:0} ms" : "—";
    private string TotalText() => _finishedAt is { } t ? $"{(t - _startedAt).TotalMilliseconds:0} ms" : (_busy ? "…" : "—");

    private string TokPerSecText()
    {
        if (_finishedAt is not { } end) return "";
        var seconds = (end - _startedAt).TotalSeconds;
        if (seconds <= 0) return "";
        var approxTokens = _responseText.Length / 4.0;
        return $"~{approxTokens / seconds:0.#} tok/s";
    }

    private async Task RunSmokeTestAsync()
    {
        if (_instance?.AdminUrl is null)
        {
            _smokeResult = "No supervisor registered on this instance.";
            return;
        }
        var token = TokenProvider.GetToken(_instance.Id);
        if (token is null)
        {
            _smokeResult = "No supervisor token configured.";
            return;
        }
        _smokeBusy = true;
        _smokeResult = null;
        StateHasChanged();
        try
        {
            var result = await SupervisorClient.SmokeTestAsync(_instance.AdminUrl, token);
            _smokeResult = result.Ok ? $"✓ passed ({result.Ms:0} ms)" : $"✗ failed: {result.Excerpt}";
        }
        catch (Exception ex)
        {
            _smokeResult = "Smoke test failed: " + ex.Message;
        }
        _smokeBusy = false;
        StateHasChanged();
    }
}
