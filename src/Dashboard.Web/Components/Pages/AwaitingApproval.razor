@page "/awaiting-approval"
@layout EmptyLayout
@attribute [Authorize]

<PageTitle>Awaiting approval — vLLM Dashboard</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <h1>vLLM Dashboard</h1>
        <div class="card">
            <div class="card-body">
                <h2 class="card-title">Awaiting approval</h2>
                <p class="text-muted">Your account has been created and is waiting for an administrator to approve it.
                    You can sign in again once access has been granted.</p>
                <form method="post" action="Account/Logout" class="mt-3">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="/" />
                    <button type="submit" class="btn btn-secondary">Sign out</button>
                </form>
            </div>
        </div>
    </div>
</div>
