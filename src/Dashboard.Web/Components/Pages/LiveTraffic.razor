@page "/traffic"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@using System.Text.Json
@using Dashboard.Core.Abstractions
@using Dashboard.Infrastructure.Persistence.V2
@using Dashboard.Infrastructure.Proxy
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject IServerService Servers
@inject IInstanceService Instances

<PageTitle>Live Traffic — vLLM Dashboard</PageTitle>

<div class="ui-page-header">
    <h1 class="ui-page-title">Live Traffic <span class="ui-page-subtitle" style="margin:0;">/ @(_instance?.Label ?? "no instance selected")</span></h1>
    @if (_instance is not null)
    {
        <UiButton Variant="secondary" Size="sm" OnClick="ClearCards">Clear</UiButton>
    }
</div>

@if (_instance is null)
{
    <UiPanel><EmptyState Variant="no-instance" Description="Register one on the Servers page." /></UiPanel>
}
else
{
    <p class="text-muted small">
        Every request forwarded through this instance's proxy URL appears here as it happens -- the model used and the
        response text streaming in live. This only mirrors traffic for display; it never affects what the real client
        receives.
    </p>

    <Toolbar Attached="true">
        <Filters>
            <UiSelect Id="traffic-model-filter" Value="@_modelFilter" ValueChanged="@(v => _modelFilter = v)">
                <option value="">All models</option>
                @foreach (var m in DistinctModels())
                {
                    <option value="@m">@m</option>
                }
            </UiSelect>
            <SegmentedControl Items="_statusFilterItems" Value="_statusFilter" ValueChanged="@(v => _statusFilter = v)" />
        </Filters>
        <Search>
            <UiInput Id="traffic-text-filter" Value="@_textFilter" ValueChanged="@(v => _textFilter = v)" Placeholder="Filter by message/response text…" />
        </Search>
    </Toolbar>

    @if (_hubError)
    {
        <Callout Tone="danger">Live updates aren't connecting. Try reloading this page.</Callout>
    }
    else if (_cards.Count == 0)
    {
        <UiPanel><EmptyState Variant="no-data" Title="Waiting for the first request" Description="Requests through this instance's proxy will appear here as they happen." /></UiPanel>
    }

    @foreach (var card in FilteredCards())
    {
        <div style="margin-bottom: var(--ui-space-3);">
            <UiPanel>
                <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap: var(--ui-space-2); margin-bottom: var(--ui-space-2);">
                    <div style="display:flex; align-items:center; gap: var(--ui-space-2);">
                        <StatusPill Status="@StatusFor(card)" Size="sm" />
                        <Chip Static="true">@(card.Model ?? "unknown model")</Chip>
                        @if (!string.IsNullOrEmpty(TokensText(card)))
                        {
                            <Chip Static="true">@TokensText(card)</Chip>
                        }
                    </div>
                    <span class="text-muted small">
                        @card.StartedAt.ToLocalTime().ToString("HH:mm:ss")
                        · TTFT @TtftText(card)
                        @if (card.ElapsedMs is { } ms)
                        {
                            <text> — @ms ms total</text>
                        }
                    </span>
                </div>

                @if (SystemMessage(card) is { } sys)
                {
                    <details class="mb-2">
                        <summary class="text-muted small" style="cursor:pointer">System prompt</summary>
                        <div class="traffic-message-text small mt-1">@sys</div>
                    </details>
                }

                @if (UserMessage(card) is { } user)
                {
                    <div class="traffic-headline mb-2">@user</div>
                }

                <div class="ui-label" style="margin-bottom: 6px;">Response</div>
                <pre class="probe-output traffic-response">@(card.ResponseText.Length > 0 ? card.ResponseText.ToString() : "…")</pre>

                @if (card.ReasoningText.Length > 0)
                {
                    <details class="mt-1">
                        <summary class="text-muted small" style="cursor:pointer">Thinking</summary>
                        <pre class="probe-output traffic-reasoning">@card.ReasoningText.ToString()</pre>
                    </details>
                }

                @if (!string.IsNullOrEmpty(card.Error))
                {
                    <div style="margin-top: var(--ui-space-2);"><Callout Tone="danger">@card.Error</Callout></div>
                }
            </UiPanel>
        </div>
    }
}

@code {
    private const int MaxCards = 25;

    private DotNetObjectReference<LiveTraffic>? _receiver;
    private Instance? _instance;
    private readonly LinkedList<TrafficCard> _cards = new();
    private readonly Dictionary<string, TrafficCard> _cardsById = new();
    private bool _hubStarted;
    private Task? _hubStartTask;
    private bool _jsReady;
    private bool _disposed;
    private string? _hubJoinedId;
    private bool _joining;
    private int _hubStartAttempts;
    private bool _hubError;

    private string _modelFilter = "";
    private string _statusFilter = "";
    private string _textFilter = "";

    private readonly IReadOnlyList<(string Key, string Label)> _statusFilterItems =
        [("", "All"), ("ok", "OK"), ("error", "Error")];

    protected override async Task OnInitializedAsync()
    {
        _receiver = DotNetObjectReference.Create(this);
        try
        {
            var servers = (await Servers.ListAsync()).ToList();
            if (servers.Count > 0)
            {
                var instances = await Instances.ListByServerAsync(servers[0].Id);
                _instance = instances.FirstOrDefault();
            }
        }
        catch
        {
            // Leave _instance null -- the page's own "no instance" branch handles it.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _instance is null) return;
        try
        {
            if (!_hubStarted)
            {
                _hubStartTask ??= JS.InvokeVoidAsync("traffichub_start", _receiver!).AsTask();
                await _hubStartTask;
                _hubStarted = true;
            }
            _jsReady = true;
            _hubError = false;
            await EnsureJoinedAsync();
        }
        catch (Exception)
        {
            _hubStartTask = null;
            _hubStartAttempts++;
            if (_hubStartAttempts > 5 && !_jsReady)
            {
                _hubError = true;
                StateHasChanged();
            }
        }
    }

    private async Task EnsureJoinedAsync()
    {
        var id = _instance?.Id.ToString();
        if (id is null || !_jsReady || _joining) return;
        if (_hubJoinedId == id) return;

        _joining = true;
        try
        {
            if (_hubJoinedId is not null)
                await JS.InvokeVoidAsync("traffichub_leave", _hubJoinedId);
            await JS.InvokeVoidAsync("traffichub_join", id);
            _hubJoinedId = id;
        }
        finally
        {
            _joining = false;
        }
    }

    [JSInvokable]
    public Task OnTrafficStarted(string json) => InvokeAsync(() =>
    {
        if (_disposed) return;
        var e = Deserialize<TrafficRequestStarted>(json);
        if (e is null || e.SourceId != _instance?.Id.ToString()) return;
        if (_cardsById.ContainsKey(e.RequestId)) return;

        var card = new TrafficCard
        {
            RequestId = e.RequestId,
            Model = e.Model,
            Messages = e.Messages,
            StartedAt = e.StartedAt,
            Status = TrafficCardStatus.Streaming,
        };
        _cards.AddFirst(card);
        _cardsById[card.RequestId] = card;
        while (_cards.Count > MaxCards)
        {
            var last = _cards.Last!.Value;
            _cardsById.Remove(last.RequestId);
            _cards.RemoveLast();
        }
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnTrafficChunk(string json) => InvokeAsync(() =>
    {
        if (_disposed) return;
        var e = Deserialize<TrafficChunk>(json);
        if (e is null || !_cardsById.TryGetValue(e.RequestId, out var card)) return;
        if (card.FirstChunkAt is null)
            card.FirstChunkAt = DateTimeOffset.UtcNow;
        var target = e.Kind == TrafficChunkKind.Reasoning ? card.ReasoningText : card.ResponseText;
        target.Append(e.Text);
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnTrafficFinished(string json) => InvokeAsync(() =>
    {
        if (_disposed) return;
        var e = Deserialize<TrafficFinished>(json);
        if (e is null || !_cardsById.TryGetValue(e.RequestId, out var card)) return;
        card.StatusCode = e.StatusCode;
        card.ElapsedMs = e.ElapsedMs;
        card.Error = e.Error;
        card.Status = e.Error is not null || e.StatusCode >= 400 ? TrafficCardStatus.Error : TrafficCardStatus.Done;
        StateHasChanged();
    });

    private static T? Deserialize<T>(string json)
    {
        try { return JsonSerializer.Deserialize<T>(json, new JsonSerializerOptions(JsonSerializerDefaults.Web)); }
        catch { return default; }
    }

    private void ClearCards()
    {
        _cards.Clear();
        _cardsById.Clear();
        StateHasChanged();
    }

    private static string StatusFor(TrafficCard card) => card.Status switch
    {
        TrafficCardStatus.Streaming => "starting",
        TrafficCardStatus.Error => "failed",
        _ => "ready",
    };

    private static string? SystemMessage(TrafficCard card) =>
        card.Messages.LastOrDefault(m => string.Equals(m.Role, "system", StringComparison.OrdinalIgnoreCase))?.Content;

    private static string? UserMessage(TrafficCard card) =>
        card.Messages.LastOrDefault(m => string.Equals(m.Role, "user", StringComparison.OrdinalIgnoreCase))?.Content;

    private static string TtftText(TrafficCard card) =>
        card.FirstChunkAt is { } first ? $"{(first - card.StartedAt).TotalMilliseconds:0} ms" : "—";

    private static string TokensText(TrafficCard card) =>
        card.ResponseText.Length > 0 ? $"~{card.ResponseText.Length / 4} tok" : "";

    private IEnumerable<string> DistinctModels() =>
        _cards.Select(c => c.Model).Where(m => !string.IsNullOrEmpty(m)).Distinct().OrderBy(m => m)!;

    private IEnumerable<TrafficCard> FilteredCards()
    {
        IEnumerable<TrafficCard> q = _cards;
        if (!string.IsNullOrEmpty(_modelFilter))
            q = q.Where(c => c.Model == _modelFilter);
        if (_statusFilter == "ok")
            q = q.Where(c => c.Status != TrafficCardStatus.Error);
        else if (_statusFilter == "error")
            q = q.Where(c => c.Status == TrafficCardStatus.Error);
        if (!string.IsNullOrWhiteSpace(_textFilter))
        {
            var needle = _textFilter.Trim();
            q = q.Where(c =>
                c.ResponseText.ToString().Contains(needle, StringComparison.OrdinalIgnoreCase) ||
                c.Messages.Any(m => m.Content.Contains(needle, StringComparison.OrdinalIgnoreCase)));
        }
        return q;
    }

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        _receiver?.Dispose();
    }

    private enum TrafficCardStatus { Streaming, Done, Error }

    private sealed class TrafficCard
    {
        public string RequestId { get; init; } = "";
        public string? Model { get; init; }
        public IReadOnlyList<TrafficMessage> Messages { get; init; } = Array.Empty<TrafficMessage>();
        public DateTimeOffset StartedAt { get; init; }
        public DateTimeOffset? FirstChunkAt { get; set; }
        public TrafficCardStatus Status { get; set; }
        public int? StatusCode { get; set; }
        public long? ElapsedMs { get; set; }
        public string? Error { get; set; }
        public System.Text.StringBuilder ReasoningText { get; } = new();
        public System.Text.StringBuilder ResponseText { get; } = new();
    }
}
