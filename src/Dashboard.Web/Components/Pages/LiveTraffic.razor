@page "/traffic"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@using System.Text.Json
@using Dashboard.Application.Proxy
@using Dashboard.Core.Abstractions
@using Dashboard.Core.Models
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject ISourceCatalog Sources
@inject SourceSelection Selection
@inject IConfigStore Config

<PageTitle>Live Traffic — vLLM Dashboard</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <h1 class="page-title mb-0">Live Traffic <span class="text-muted fs-5">/ @(SelectedSource?.Label ?? "no source selected")</span></h1>
    @if (SelectedSource is not null)
    {
        <button class="btn btn-outline-secondary btn-sm" @onclick="ClearCards">Clear</button>
    }
</div>

@if (SelectedSource is null)
{
    <div class="card"><div class="card-body">
        <p class="text-muted mb-0">No source selected. Add one on the <a href="settings">Settings</a> page.</p>
    </div></div>
}
else
{
    <p class="text-muted small">
        Every request forwarded through this source's proxy URL appears here as it happens — the model used and the
        response text streaming in live. This only mirrors traffic for display; it never affects what the real client
        receives.
    </p>

    @if (_cards.Count == 0)
    {
        <div class="card status-card status-wait"><div class="card-body d-flex align-items-center gap-3 py-2">
            <span class="dot dot-off"></span>
            <div class="text-muted">Waiting for the first request through the proxy…</div>
        </div></div>
    }

    @foreach (var card in _cards)
    {
        <div class="card mb-3 traffic-card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="dot @StatusDotClass(card)"></span>
                        <span class="chip">@(card.Model ?? "unknown model")</span>
                    </div>
                    <div class="text-muted small">
                        @card.StartedAt.ToLocalTime().ToString("HH:mm:ss")
                        @if (card.ElapsedMs is { } ms)
                        {
                            <span> — @ms ms</span>
                        }
                        @if (card.Status == TrafficCardStatus.Streaming)
                        {
                            <span> — streaming…</span>
                        }
                    </div>
                </div>

                @if (card.Messages.Count > 0)
                {
                    <div class="text-muted small mb-1">Messages sent</div>
                    <div class="traffic-messages mb-2">
                        @foreach (var m in card.Messages)
                        {
                            <div class="traffic-message">
                                <span class="traffic-role">@m.Role</span>
                                <span class="traffic-message-text">@m.Content</span>
                            </div>
                        }
                    </div>
                }

                @if (card.ReasoningText.Length > 0)
                {
                    <div class="text-muted small mb-1">Thinking</div>
                    <pre class="probe-output traffic-reasoning">@card.ReasoningText.ToString()</pre>
                }

                <div class="text-muted small mb-1">Response</div>
                <pre class="probe-output traffic-response">@(card.ResponseText.Length > 0 ? card.ResponseText.ToString() : "…")</pre>

                @if (!string.IsNullOrEmpty(card.Error))
                {
                    <div class="text-danger small">@card.Error</div>
                }
            </div>
        </div>
    }
}

@code {
    private const int MaxCards = 25;

    private DotNetObjectReference<LiveTraffic>? _receiver;
    private List<SourceInfo> _all = new();
    private readonly LinkedList<TrafficCard> _cards = new();
    private readonly Dictionary<string, TrafficCard> _cardsById = new();
    private bool _hubStarted;
    private bool _jsReady;
    private bool _disposed;
    private string? _hubJoinedId;

    private SourceInfo? SelectedSource =>
        _all.FirstOrDefault(s => s.Id == Selection.CurrentSourceId) ?? _all.FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        _receiver = DotNetObjectReference.Create(this);
        Selection.Changed += OnSelectionChanged;
        Config.Changed += OnConfigChanged;
        _all = (await Sources.GetAllAsync()).ToList();
    }

    // Without this, editing a source's slug/settings elsewhere left this page
    // holding a stale SourceInfo indefinitely — it would keep joining the hub group
    // for whatever Id it loaded at page-open time.
    private void OnConfigChanged(object? sender, EventArgs e) =>
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            _all = (await Sources.GetAllAsync()).ToList();
            StateHasChanged();
        });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || SelectedSource is null) return;
        try
        {
            if (!_hubStarted)
            {
                await JS.InvokeVoidAsync("traffichub_start", _receiver!);
                _hubStarted = true;
            }
            _jsReady = true;
            await EnsureJoinedAsync();
        }
        catch (Exception)
        {
            // JS not ready yet (static prerender pass) — retry on the next render.
        }
    }

    private void OnSelectionChanged(object? sender, EventArgs e) =>
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            ClearCardsInternal();
            await EnsureJoinedAsync();
            StateHasChanged();
        });

    private async Task EnsureJoinedAsync()
    {
        var src = SelectedSource;
        if (src is null || !_jsReady) return;
        if (_hubJoinedId == src.Id) return;

        if (_hubJoinedId is not null)
            await JS.InvokeVoidAsync("traffichub_leave", _hubJoinedId);
        await JS.InvokeVoidAsync("traffichub_join", src.Id);
        _hubJoinedId = src.Id;
    }

    [JSInvokable]
    public Task OnTrafficStarted(string json) => InvokeAsync(() =>
    {
        if (_disposed) return;
        var e = Deserialize<TrafficRequestStarted>(json);
        if (e is null || e.SourceId != SelectedSource?.Id) return;

        var card = new TrafficCard
        {
            RequestId = e.RequestId,
            Model = e.Model,
            Messages = e.Messages,
            StartedAt = e.StartedAt,
            Status = TrafficCardStatus.Streaming,
        };
        _cards.AddFirst(card);
        _cardsById[card.RequestId] = card;
        while (_cards.Count > MaxCards)
        {
            var last = _cards.Last!.Value;
            _cardsById.Remove(last.RequestId);
            _cards.RemoveLast();
        }
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnTrafficChunk(string json) => InvokeAsync(() =>
    {
        if (_disposed) return;
        var e = Deserialize<TrafficChunk>(json);
        if (e is null || !_cardsById.TryGetValue(e.RequestId, out var card)) return;
        var target = e.Kind == TrafficChunkKind.Reasoning ? card.ReasoningText : card.ResponseText;
        target.Append(e.Text);
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnTrafficFinished(string json) => InvokeAsync(() =>
    {
        if (_disposed) return;
        var e = Deserialize<TrafficFinished>(json);
        if (e is null || !_cardsById.TryGetValue(e.RequestId, out var card)) return;
        card.StatusCode = e.StatusCode;
        card.ElapsedMs = e.ElapsedMs;
        card.Error = e.Error;
        card.Status = e.Error is not null || e.StatusCode >= 400 ? TrafficCardStatus.Error : TrafficCardStatus.Done;
        StateHasChanged();
    });

    private static T? Deserialize<T>(string json)
    {
        try { return JsonSerializer.Deserialize<T>(json, new JsonSerializerOptions(JsonSerializerDefaults.Web)); }
        catch { return default; }
    }

    private void ClearCards()
    {
        ClearCardsInternal();
        StateHasChanged();
    }

    private void ClearCardsInternal()
    {
        _cards.Clear();
        _cardsById.Clear();
    }

    private static string StatusDotClass(TrafficCard card) => card.Status switch
    {
        TrafficCardStatus.Streaming => "dot-off",
        TrafficCardStatus.Error => "dot-down",
        _ => "dot-up",
    };

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        Selection.Changed -= OnSelectionChanged;
        Config.Changed -= OnConfigChanged;
        _receiver?.Dispose();
    }

    private enum TrafficCardStatus { Streaming, Done, Error }

    private sealed class TrafficCard
    {
        public string RequestId { get; init; } = "";
        public string? Model { get; init; }
        public IReadOnlyList<TrafficMessage> Messages { get; init; } = Array.Empty<TrafficMessage>();
        public DateTimeOffset StartedAt { get; init; }
        public TrafficCardStatus Status { get; set; }
        public int? StatusCode { get; set; }
        public long? ElapsedMs { get; set; }
        public string? Error { get; set; }
        public System.Text.StringBuilder ReasoningText { get; } = new();
        public System.Text.StringBuilder ResponseText { get; } = new();
    }
}
