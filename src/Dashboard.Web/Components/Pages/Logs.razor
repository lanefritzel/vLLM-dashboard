@page "/logs"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@using Dashboard.Core.Abstractions
@using Dashboard.Core.Models
@using Dashboard.Infrastructure.Persistence.V2
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject IServerService Servers
@inject IInstanceService Instances
@inject IDeploymentService Deployments
@inject ISupervisorClient SupervisorClient

<PageTitle>Logs — vLLM Dashboard</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <h1 class="page-title mb-0">Logs <span class="text-muted fs-5">/ @(_instance?.Label ?? "no instance configured")</span></h1>
    @if (_instance is not null)
    {
        <div class="d-flex align-items-center gap-2">
            <label class="text-muted small d-flex align-items-center gap-1" style="cursor: pointer;">
                <input type="checkbox" checked="@_followTail" @onchange="OnFollowTailChanged" />
                Follow tail
            </label>
            <button class="btn btn-outline-secondary btn-sm" @onclick="ClearLines">Clear</button>
        </div>
    }
</div>

@if (_instance is null)
{
    <div class="card"><div class="card-body">
        <p class="text-muted mb-0">No instance configured yet. Register one on the <a href="servers">Servers</a> page.</p>
    </div></div>
}
else if (_activeDeploymentId is null)
{
    <div class="card"><div class="card-body">
        <p class="text-muted mb-0">No active deployment on this instance — logs appear once a model is serving.</p>
    </div></div>
}
else
{
    <p class="text-muted small">
        Stdout/stderr from the active deployment's supervisor process, polled every 2s.
    </p>

    <div class="card">
        <div class="card-body">
            <pre id="logs-console" class="probe-output logs-console">@(_lines.Count == 0 ? "Waiting for log output…" : string.Join("\n", _lines))</pre>
        </div>
    </div>
}

@code {
    private const int MaxLines = 500;

    private List<Server> _servers = new();
    private Instance? _instance;
    private int? _activeDeploymentId;
    private readonly List<string> _lines = new();
    private bool _followTail = true;
    private bool _disposed;
    private CancellationTokenSource? _pollCts;

    protected override async Task OnInitializedAsync()
    {
        _servers = (await Servers.ListAsync()).ToList();
        if (_servers.Count > 0)
        {
            var instances = await Instances.ListByServerAsync(_servers[0].Id);
            _instance = instances.FirstOrDefault();
        }
        if (_instance is not null)
        {
            _pollCts = new CancellationTokenSource();
            _ = PollLoopAsync(_instance, _pollCts.Token);
        }
    }

    /// <summary>Same pull-based approach as SwapCeremonyDialog's log pane
    /// (P16a finding: the supervisor's push-based log delivery is
    /// best-effort/droppable) -- asks the supervisor's admin API directly
    /// on a plain timer instead of relying on any push arriving. Also
    /// re-checks the instance's active deployment each tick, so a swap
    /// made while this page is open picks up the new deployment's logs
    /// without a reload.</summary>
    private async Task PollLoopAsync(Instance instance, CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                var active = await Deployments.GetActiveAsync(instance.Id, ct);
                var id = active?.Id;
                if (id != _activeDeploymentId)
                {
                    _activeDeploymentId = id;
                    _lines.Clear();
                    await InvokeAsync(StateHasChanged);
                }

                if (id is not null && instance.AdminUrl is not null)
                {
                    var text = await SupervisorClient.GetDeploymentLogsAsync(
                        instance.AdminUrl, id.Value.ToString(), MaxLines, ct);
                    var lines = text.Split('\n', StringSplitOptions.RemoveEmptyEntries);
                    _lines.Clear();
                    _lines.AddRange(lines);
                    await InvokeAsync(async () =>
                    {
                        StateHasChanged();
                        if (_followTail)
                        {
                            try { await JS.InvokeVoidAsync("logs_scroll_bottom", "logs-console"); }
                            catch { /* JS not ready */ }
                        }
                    });
                }
            }
            catch (OperationCanceledException)
            {
                return;
            }
            catch
            {
                // Best-effort -- the next tick tries again.
            }

            try { await Task.Delay(TimeSpan.FromSeconds(2), ct); }
            catch (OperationCanceledException) { return; }
        }
    }

    private void OnFollowTailChanged(ChangeEventArgs e) => _followTail = e.Value is bool b && b;

    private void ClearLines()
    {
        _lines.Clear();
        StateHasChanged();
    }

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        _pollCts?.Cancel();
    }
}
