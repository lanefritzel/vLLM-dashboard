@page "/settings"
@rendermode InteractiveServer
@attribute [Authorize]
@using Dashboard.Core.Abstractions
@using Dashboard.Core.Models
@using Dashboard.Web.Components.Shared
@inject NavigationManager Nav
@inject IDialogService Dialogs

<PageTitle>Settings — vLLM Dashboard</PageTitle>

<h1 class="page-title">Settings</h1>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="card status-card status-down mb-3">
        <div class="card-body py-2"><span class="dot dot-down"></span> <span class="text-danger">@_error</span></div>
    </div>
}
@if (!string.IsNullOrEmpty(_message))
{
    <div class="card status-card mb-3" style="border-left-color: var(--green);">
        <div class="card-body py-2"><span class="dot dot-up"></span> @_message</div>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <div class="card-title mb-1">Physical Servers</div>
                <p class="text-muted small mb-0">
                    A physical (or virtual) machine that runs one or more vLLM instances below. Its Docker
                    host address, GPU, and Hugging Face cache directory are shared by every instance on it —
                    set once here instead of re-entering them per instance.
                </p>
            </div>
            <button class="btn btn-primary btn-sm" @onclick="@(() => _serverWizardOpen = true)">+ Add physical server</button>
        </div>

        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Label</th>
                    <th>Docker host</th>
                    <th>GPU</th>
                    <th>HF cache directory</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _physicalServers)
                {
                    <tr>
                        <td>@p.Label</td>
                        <td class="url-cell"><code>@p.DockerHost</code></td>
                        <td>@(p.GpuVendor == GpuVendor.None ? "—" : $"{p.GpuVendor}{(p.GpuVramTotalGb is > 0 ? $" ({p.GpuVramTotalGb} GB)" : "")}")</td>
                        <td>@(string.IsNullOrWhiteSpace(p.HfCacheHostPath) ? "—" : p.HfCacheHostPath)</td>
                        <td class="text-end">
                            <button class="btn btn-outline btn-sm" @onclick="@(() => StartEditPhysicalServer(p))">Edit</button>
                            <button class="btn btn-outline btn-sm btn-danger-soft" @onclick="@(() => DeletePhysicalServerAsync(p))">Delete</button>
                        </td>
                    </tr>
                }
                @if (_physicalServers.Count == 0)
                {
                    <tr><td colspan="5" class="text-muted">No physical servers configured.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (_serverWizardOpen)
{
    <Dashboard.Web.Components.Wizards.PhysicalServerSetupWizard
        OnCancelled="@(() => _serverWizardOpen = false)"
        OnSaved="@OnServerWizardSavedAsync"
        OnSwitchToAdvanced="@OnServerWizardSwitchToAdvancedAsync" />
}

@if (_editingServer is not null)
{
    <div class="modal-overlay" @onclick="@CancelEditServer">
        <div class="modal-dialog-custom" @onclick:stopPropagation="true">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="card-title mb-0">@(_isCreatingServer ? "New physical server" : "Edit physical server")</div>
                <button type="button" class="modal-close-btn" @onclick="@CancelEditServer" aria-label="Close">✕</button>
            </div>
            <form @onsubmit="@SubmitServerAsync" @onsubmit:preventDefault="true">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Label</label>
                        <input class="form-control" @bind="_fsLabel" placeholder="e.g. Main GPU box" />
                        <div class="form-text">A friendly name for this machine, shown wherever a vLLM instance's server is picked.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Docker host</label>
                        <input class="form-control" @bind="_fsDockerHost" placeholder="tcp://servername-or-ip:2375" />
                        <div class="form-text">The Docker daemon's own API address — shared by every vLLM instance on this machine.</div>
                    </div>
                    <div class="col-md-12">
                        <button type="button" class="btn btn-outline btn-sm" disabled="@_serverTesting" @onclick="@TestServerConnectionAsync">
                            @(_serverTesting ? "Testing…" : "Test connection")
                        </button>
                        @if (_serverTestResult is not null)
                        {
                            <span class="ms-2 @(_serverTestResult.Success ? "text-success" : "text-danger")">@_serverTestResult.Message</span>
                        }
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">GPU vendor</label>
                        <select class="form-select" @bind="_fsGpuVendor">
                            <option value="@GpuVendor.None">None</option>
                            <option value="@GpuVendor.Nvidia">NVIDIA</option>
                            <option value="@GpuVendor.Intel">Intel (raw device passthrough)</option>
                        </select>
                    </div>
                    @if (_fsGpuVendor != GpuVendor.None)
                    {
                        <div class="col-md-4">
                            <label class="form-label">GPU VRAM total (GB) <span class="text-muted">(optional)</span></label>
                            <input class="form-control" type="number" min="1" step="1" @bind="_fsGpuVramTotalGb" placeholder="e.g. 32" />
                            <div class="form-text">Informational only — powers warnings on the Models page.</div>
                        </div>
                    }
                    <div class="col-md-6">
                        <label class="form-label">Hugging Face cache directory <span class="text-muted">(optional, strongly recommended)</span></label>
                        <input class="form-control" @bind="_fsHfCache" placeholder="/home/you/.cache/huggingface" />
                        <div class="form-text">
                            Shared by every vLLM instance on this machine — set once here so the same model is
                            never downloaded twice for two instances on the same box.
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Hugging Face token <span class="text-muted">(optional)</span></label>
                        <input class="form-control" type="password" autocomplete="off" @bind="_fsHfToken" placeholder="hf_…" />
                        <div class="form-text">Only needed for gated or private Hugging Face repos.</div>
                    </div>
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary btn-sm" disabled="@_serverBusy">@(_serverBusy ? "Saving…" : "Save")</button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="@CancelEditServer">Cancel</button>
                </div>
            </form>
        </div>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div class="card-title">Sources</div>
            <div class="text-end">
                <div>
                    <button class="btn btn-outline btn-sm me-2" @onclick="@(() => _fullWizardOpen = true)">Full Setup Wizard</button>
                    <button class="btn btn-primary btn-sm" @onclick="@(() => _wizardOpen = true)">+ Add source</button>
                </div>
                <div class="mt-1">
                    <button type="button" class="btn btn-link btn-sm text-muted p-0" @onclick="@StartNewSource">Not vLLM? Add an Ollama/other source directly</button>
                </div>
            </div>
        </div>

        <table class="table table-sm sources-table">
            <thead>
                <tr>
                    <th>Label</th>
                    <th>Type</th>
                    <th>Proxy URL</th>
                    <th>Interval</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _sources)
                {
                    <tr>
                        <td>@s.Label</td>
                        <td>@s.Type</td>
                        <td class="url-cell">
                            <code title="Use this as the OpenAI-compatible baseURL for API clients">@ProxyUrl(s)</code>
                        </td>
                        <td>@s.ScrapeIntervalSeconds s</td>
                        <td>
                            <input type="checkbox" checked="@s.Active" onchange="@(() => ToggleActiveAsync(s))" title="Enable/disable polling" />
                        </td>
                        <td class="text-end">
                            <button class="btn btn-outline btn-sm" @onclick="@(() => StartEditSourceAsync(s))">Edit</button>
                            <button class="btn btn-outline btn-sm btn-danger-soft" @onclick="@(() => DeleteAsync(s))">Delete</button>
                        </td>
                    </tr>
                }
                @if (_sources.Count == 0)
                {
                    <tr><td colspan="6" class="text-muted">No sources configured.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (_wizardOpen)
{
    <Dashboard.Web.Components.Wizards.ServerSetupWizard
        OnCancelled="@(() => _wizardOpen = false)"
        OnSaved="@OnWizardSavedAsync"
        OnSwitchToAdvanced="@OnSwitchToAdvancedSourceAsync" />
}

@if (_fullWizardOpen)
{
    <Dashboard.Web.Components.Wizards.FullSetupWizard
        OnCancelled="@(() => _fullWizardOpen = false)"
        OnSaved="@OnFullWizardSavedAsync"
        OnSwitchToAdvancedSource="@OnSwitchToAdvancedSourceAsync"
        OnSwitchToAdvancedModel="@OnFullWizardSwitchToAdvancedModelAsync" />
}

@if (_editing is not null)
{
    <div class="modal-overlay" @onclick="@CancelEdit">
        <div class="modal-dialog-custom" @onclick:stopPropagation="true">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="card-title mb-0">@(_isCreating ? "New source" : "Edit source")</div>
                <button type="button" class="modal-close-btn" @onclick="@CancelEdit" aria-label="Close">✕</button>
            </div>
            <form @onsubmit="@OnSourceSubmit" @onsubmit:preventDefault="true" class="source-form">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Label</label>
                        <input class="form-control" @bind="_fLabel" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Proxy slug <span class="text-muted small">(used in the proxy URL instead of the internal ID — leave blank to auto-generate from the label)</span></label>
                        <input class="form-control" @bind="_fSlug" placeholder="@Slug.From(_fLabel)" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Type</label>
                        <select class="form-select" @bind="_fType">
                            <option value="vllm">vLLM (Prometheus)</option>
                            <option value="ollama">Ollama</option>
                            <option value="mock">Mock</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Scrape interval (s)</label>
                        <input class="form-control" type="number" min="1" @bind="_fInterval" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Metrics URL @(TypeIsVllm ? "(/metrics endpoint)" : "ignored")</label>
                        <input class="form-control" @bind="_fMetricsUrl" placeholder="http://servername-or-ip:9999" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Inference URL (vLLM /v1 or Ollama base)</label>
                        <input class="form-control" @bind="_fInferenceUrl" placeholder="http://servername-or-ip:9999" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Active</label>
                        <input type="checkbox" class="form-check-input" @bind="_fActive" />
                    </div>
                </div>

                @if (TypeIsVllm)
                {
                    <hr class="my-3" />
                    <div class="card-title mb-1">Hot-swap / Docker settings</div>
                    <p class="text-muted small">
                        Things true of this physical box/Docker host regardless of which model runs on it —
                        GPU access, networking, and where shared caches live. Set this up once per server;
                        each model on the Models page picks its own weights and flags on top of it.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Physical server <span class="text-muted">(optional, for hot-swap)</span></label>
                            <select class="form-select" @bind="_fPhysicalServerId">
                                <option value="">-- none (metrics-only, no hot-swap) --</option>
                                @foreach (var p in _physicalServers)
                                {
                                    <option value="@p.Id">@p.Label (@p.DockerHost)</option>
                                }
                            </select>
                            <div class="form-text">
                                Which machine this vLLM instance runs on — its Docker host, GPU, and Hugging
                                Face cache directory come from there. Manage them above.
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Container name <span class="text-muted">(optional)</span></label>
                            <input class="form-control" @bind="_fContainerName" placeholder="(default: label)" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Default image</label>
                            <input class="form-control" @bind="_fImage" placeholder="vllm/vllm-openai:latest" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Entrypoint override</label>
                            <input class="form-control" @bind="_fEntrypoint" placeholder="(image default)" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Serving port</label>
                            <input class="form-control" type="number" min="1" @bind="_fServingPort" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Restart policy</label>
                            <select class="form-select" @bind="_fRestartPolicy">
                                <option value="unless-stopped">unless-stopped</option>
                                <option value="always">always</option>
                                <option value="on-failure">on-failure</option>
                                <option value="no">no</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Health-check timeout (s)</label>
                            <input class="form-control" type="number" min="30" @bind="_fHealthTimeout" />
                            <div class="form-text">First-time swap to an uncached Hugging Face model has to download it first — allow enough time.</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">System RAM limit (GB) <span class="text-muted">(optional)</span></label>
                            <input class="form-control" type="number" min="1" step="1" @bind="_fMemoryLimitGb" placeholder="e.g. 20 — blank = no limit" />
                            <div class="form-text">
                                A hard number of gigabytes, enforced by Docker itself. If this model ever tries to use
                                more <strong>system RAM</strong> than this, Docker kills <em>this container only</em>
                                instead of the model exhausting the whole server's memory. Set it below your host's
                                total RAM (leave some headroom for other services running there). Leave blank for no
                                limit. <strong>This does not apply to GPU VRAM</strong> — see VRAM total below if this
                                source has a GPU.
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Network mode</label>
                            <select class="form-select" @bind="_fNetworkMode">
                                <option value="bridge">bridge</option>
                                <option value="host">host</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">IPC mode</label>
                            <select class="form-select" @bind="_fIpcMode">
                                <option value="">(default)</option>
                                <option value="host">host</option>
                            </select>
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="privileged" @bind="_fPrivileged" />
                                <label class="form-check-label" for="privileged">Privileged</label>
                            </div>
                        </div>
                        @if (SelectedServerVendor == GpuVendor.Nvidia)
                        {
                            <div class="col-md-8">
                                <label class="form-label">GPU device ids</label>
                                <input class="form-control" @bind="_fGpuOptions" placeholder="all, or e.g. 0,1" />
                                <div class="form-text">Which of this server's GPU(s) this instance uses. "all" or a comma-separated list (e.g. 0,1) if the box has more than one.</div>
                            </div>
                        }

                        @if (SelectedServerVendor == GpuVendor.Intel)
                        {
                            <div class="col-md-12">
                                <label class="form-label">Devices (raw --device passthrough, e.g. /dev/dri)</label>
                                <div class="form-text mb-2">Which of this server's GPU device(s) this instance uses.</div>
                                @for (var i = 0; i < _fDevices.Count; i++)
                                {
                                    var row = _fDevices[i];
                                    <div class="row g-2 mb-2 align-items-center">
                                        <div class="col-md-5"><input class="form-control form-control-sm" placeholder="Host path" @bind="row.HostPath" /></div>
                                        <div class="col-md-5"><input class="form-control form-control-sm" placeholder="Container path" @bind="row.ContainerPath" /></div>
                                        <div class="col-md-2 text-end">
                                            <button type="button" class="btn btn-outline btn-sm btn-danger-soft" @onclick="@(() => _fDevices.Remove(row))">Remove</button>
                                        </div>
                                    </div>
                                }
                                <button type="button" class="btn btn-outline btn-sm" @onclick="@(() => _fDevices.Add(new DeviceMapping()))">+ Add device</button>
                            </div>
                        }

                        <div class="col-md-12">
                            <details>
                                <summary class="text-muted" style="cursor:pointer">Advanced: custom volumes &amp; environment variables</summary>
                                <div class="row g-3 mt-1">
                                    <div class="col-md-12">
                                        <label class="form-label">Volumes</label>
                                        @for (var i = 0; i < _fVolumes.Count; i++)
                                        {
                                            var row = _fVolumes[i];
                                            <div class="row g-2 mb-2 align-items-center">
                                                <div class="col-md-5"><input class="form-control form-control-sm" placeholder="Host path" @bind="row.Host" /></div>
                                                <div class="col-md-4"><input class="form-control form-control-sm" placeholder="Container path" @bind="row.Container" /></div>
                                                <div class="col-md-1 form-check">
                                                    <input type="checkbox" class="form-check-input" title="Read-only" @bind="row.ReadOnly" />
                                                </div>
                                                <div class="col-md-2 text-end">
                                                    <button type="button" class="btn btn-outline btn-sm btn-danger-soft" @onclick="@(() => _fVolumes.Remove(row))">Remove</button>
                                                </div>
                                            </div>
                                        }
                                        <button type="button" class="btn btn-outline btn-sm" @onclick="@(() => _fVolumes.Add(new VolumeMapping()))">+ Add volume</button>
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label">Environment variables</label>
                                        @for (var i = 0; i < _fEnv.Count; i++)
                                        {
                                            var row = _fEnv[i];
                                            <div class="row g-2 mb-2 align-items-center">
                                                <div class="col-md-5"><input class="form-control form-control-sm" placeholder="KEY" @bind="row.Key" /></div>
                                                <div class="col-md-5"><input class="form-control form-control-sm" placeholder="value" @bind="row.Value" /></div>
                                                <div class="col-md-2 text-end">
                                                    <button type="button" class="btn btn-outline btn-sm btn-danger-soft" @onclick="@(() => _fEnv.Remove(row))">Remove</button>
                                                </div>
                                            </div>
                                        }
                                        <button type="button" class="btn btn-outline btn-sm" @onclick="@(() => _fEnv.Add(new EnvRow()))">+ Add env var</button>
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label">Extra run args <span class="text-muted">(shared by every model on this server)</span></label>
                                        <input class="form-control" @bind="_fExtraRunArgs" />
                                    </div>
                                </div>
                            </details>
                        </div>
                    </div>
                }

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary btn-sm" disabled="@_busy">@(_busy ? "Saving…" : "Save")</button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="@CancelEdit">Cancel</button>
                </div>
            </form>
        </div>
    </div>
}

<div class="card">
    <div class="card-body">
        <div class="card-title mb-3">Preferences</div>
        <form @onsubmit="@OnConfigSubmit" @onsubmit:preventDefault="true" class="row g-3 config-form">
            <div class="col-md-3">
                <label class="form-label">Retention (days)</label>
                <input class="form-control" type="number" min="1" @bind="_fRetentionDays" />
            </div>
            <div class="col-md-3">
                <label class="form-label">UI update rate (ms)</label>
                <input class="form-control" type="number" min="200" step="100" @bind="_fUiRate" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Default history window (min)</label>
                <input class="form-control" type="number" min="5" @bind="_fHistWindow" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="rollups" @bind="_fRollups" />
                    <label class="form-check-label" for="rollups">Rollups enabled</label>
                </div>
            </div>
            <div class="col-md-12">
                <button type="submit" class="btn btn-primary btn-sm">Save preferences</button>
            </div>
        </form>
    </div>
</div>

@code {
    [Inject] private ISourceCatalog Sources { get; set; } = default!;
    [Inject] private IConfigStore Config { get; set; } = default!;
    [Inject] private ILaunchSpecStore LaunchSpecs { get; set; } = default!;
    [Inject] private IPhysicalServerCatalog Servers { get; set; } = default!;
    [Inject] private IDockerOrchestrator Docker { get; set; } = default!;
    [Inject] private Dashboard.Web.Components.SourceSelection Selection { get; set; } = default!;

    private List<PhysicalServerInfo> _physicalServers = new();
    private bool _serverWizardOpen;
    private PhysicalServerInfo? _editingServer;
    private bool _isCreatingServer;
    private bool _serverBusy;
    private bool _serverTesting;
    private DockerHostTestResult? _serverTestResult;
    private string _fsLabel = "";
    private string _fsDockerHost = "";
    private GpuVendor _fsGpuVendor = GpuVendor.None;
    private int? _fsGpuVramTotalGb;
    private string _fsHfCache = "";
    private string _fsHfToken = "";

    private List<SourceInfo> _sources = new();
    private SourceInfo? _editing;
    private LaunchSpec? _launch;
    private bool _isCreating;
    private bool _busy;
    private bool _wizardOpen;
    private bool _fullWizardOpen;
    private string? _error;
    private string? _message;

    // Source form fields.
    private string _fLabel = "";
    private string _fSlug = "";
    private string _fType = "vllm";
    private string _fMetricsUrl = "";
    private string _fInferenceUrl = "";
    private string _fPhysicalServerId = "";
    private string _fContainerName = "";
    private int _fInterval = 5;
    private bool _fActive = true;

    // Hot-swap / Docker settings fields (vLLM sources only).
    private string _fImage = "";
    private string _fEntrypoint = "";
    private int? _fServingPort;
    private string _fRestartPolicy = "unless-stopped";
    private int _fHealthTimeout = 600;
    private int? _fMemoryLimitGb;
    private string _fNetworkMode = "bridge";
    private string _fIpcMode = "";
    private bool _fPrivileged;
    private string _fGpuOptions = "";
    private List<DeviceMapping> _fDevices = new();
    private List<VolumeMapping> _fVolumes = new();
    private List<EnvRow> _fEnv = new();
    private string _fExtraRunArgs = "";

    private sealed class EnvRow
    {
        public string Key { get; set; } = "";
        public string Value { get; set; } = "";
    }

    // Config form fields.
    private int _fRetentionDays = 30;
    private int _fUiRate = 1000;
    private int _fHistWindow = 60;
    private bool _fRollups = true;

    private bool TypeIsVllm => _fType == "vllm";

    private GpuVendor SelectedServerVendor =>
        _physicalServers.FirstOrDefault(p => p.Id == _fPhysicalServerId)?.GpuVendor ?? GpuVendor.None;

    private string ProxyUrl(SourceInfo s) =>
        $"{Nav.BaseUri.TrimEnd('/')}/proxy/{(string.IsNullOrWhiteSpace(s.Slug) ? s.Id : s.Slug)}/v1";

    protected override async Task OnInitializedAsync()
    {
        _fRetentionDays = Config.RetentionDays;
        _fUiRate = Config.UiUpdateRateMs;
        _fHistWindow = Config.DefaultHistoryWindowMinutes;
        _fRollups = Config.RollupsEnabled;
        await ReloadSourcesAsync();
        await ReloadServersAsync();
    }

    private async Task ReloadSourcesAsync()
    {
        try
        {
            _sources = (await Sources.GetAllAsync()).ToList();
        }
        catch (Exception ex)
        {
            _error = "Could not load sources: " + ex.Message;
        }
    }

    private async Task ReloadServersAsync()
    {
        try
        {
            _physicalServers = (await Servers.GetAllAsync()).ToList();
        }
        catch (Exception ex)
        {
            _error = "Could not load physical servers: " + ex.Message;
        }
    }

    private void ResetLaunchFields(LaunchSpec? spec)
    {
        _launch = spec;
        _fImage = spec?.Image ?? "";
        _fEntrypoint = spec?.Entrypoint ?? "";
        _fServingPort = spec?.ServingPort;
        _fRestartPolicy = string.IsNullOrWhiteSpace(spec?.RestartPolicy) ? "unless-stopped" : spec!.RestartPolicy;
        _fHealthTimeout = spec?.HealthWaitTimeoutSeconds is > 0 ? spec!.HealthWaitTimeoutSeconds : 600;
        _fMemoryLimitGb = spec?.MemoryLimitMb is { } mb ? Math.Max(1, mb / 1024) : null;
        _fNetworkMode = string.IsNullOrWhiteSpace(spec?.NetworkMode) ? "bridge" : spec!.NetworkMode;
        _fIpcMode = spec?.IpcMode ?? "";
        _fPrivileged = spec?.Privileged ?? false;
        _fGpuOptions = spec?.GpuOptions ?? "";
        _fDevices = spec?.Devices.Select(d => new DeviceMapping { HostPath = d.HostPath, ContainerPath = d.ContainerPath }).ToList() ?? new();
        _fVolumes = spec?.Volumes.Select(v => new VolumeMapping { Host = v.Host, Container = v.Container, ReadOnly = v.ReadOnly }).ToList() ?? new();
        _fEnv = spec?.Env.Select(kv => new EnvRow { Key = kv.Key, Value = kv.Value }).ToList() ?? new();
        _fExtraRunArgs = spec?.ExtraRunArgs ?? "";
    }

    private void StartNewSource()
    {
        _isCreating = true;
        _editing = new SourceInfo
        {
            Id = Guid.NewGuid().ToString(),
            Type = SourceType.Vllm,
            ScrapeIntervalSeconds = 5,
            Active = true,
            SortOrder = _sources.Count,
        };
        _fLabel = "";
        _fSlug = "";
        _fType = "vllm";
        _fMetricsUrl = "";
        _fInferenceUrl = "";
        _fPhysicalServerId = "";
        _fContainerName = "";
        _fInterval = 5;
        _fActive = true;
        ResetLaunchFields(null);
        _error = null;
    }

    private async Task StartEditSourceAsync(SourceInfo s)
    {
        _isCreating = false;
        _editing = s;
        _fLabel = s.Label;
        _fSlug = s.Slug;
        _fType = s.Type.ToStorage();
        _fMetricsUrl = s.MetricsUrl;
        _fInferenceUrl = s.InferenceUrl;
        _fPhysicalServerId = s.PhysicalServerId ?? "";
        _fContainerName = s.ContainerName ?? "";
        _fInterval = s.ScrapeIntervalSeconds;
        _fActive = s.Active;
        _error = null;

        LaunchSpec? spec = null;
        try { spec = await LaunchSpecs.GetBySourceAsync(s.Id); }
        catch { /* leave defaults; edit form still usable */ }
        ResetLaunchFields(spec);
    }

    private void CancelEdit()
    {
        _editing = null;
    }

    private void StartNewPhysicalServer()
    {
        _isCreatingServer = true;
        _editingServer = new PhysicalServerInfo { Id = Guid.NewGuid().ToString() };
        _fsLabel = "";
        _fsDockerHost = "";
        _fsGpuVendor = GpuVendor.None;
        _fsGpuVramTotalGb = null;
        _fsHfCache = "";
        _fsHfToken = "";
        _serverTestResult = null;
        _error = null;
    }

    private void StartEditPhysicalServer(PhysicalServerInfo p)
    {
        _isCreatingServer = false;
        _editingServer = p;
        _fsLabel = p.Label;
        _fsDockerHost = p.DockerHost;
        _fsGpuVendor = p.GpuVendor;
        _fsGpuVramTotalGb = p.GpuVramTotalGb;
        _fsHfCache = p.HfCacheHostPath ?? "";
        _fsHfToken = p.HfToken ?? "";
        _serverTestResult = null;
        _error = null;
    }

    private void CancelEditServer()
    {
        _editingServer = null;
    }

    private async Task OnServerWizardSavedAsync(PhysicalServerInfo saved)
    {
        _serverWizardOpen = false;
        _message = "Created " + saved.Label;
        await ReloadServersAsync();
    }

    private async Task OnServerWizardSwitchToAdvancedAsync(PhysicalServerInfo saved)
    {
        _serverWizardOpen = false;
        await ReloadServersAsync();
        StartEditPhysicalServer(saved);
    }

    private async Task TestServerConnectionAsync()
    {
        _serverTesting = true;
        _serverTestResult = null;
        StateHasChanged();
        try
        {
            _serverTestResult = await Docker.TestDockerHostAsync(_fsDockerHost);
        }
        finally
        {
            _serverTesting = false;
        }
    }

    private async Task SubmitServerAsync()
    {
        if (_editingServer is null || _serverBusy) return;
        _serverBusy = true;
        _error = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_fsLabel))
            {
                _error = "Label is required.";
                return;
            }
            if (string.IsNullOrWhiteSpace(_fsDockerHost))
            {
                _error = "Docker host is required.";
                return;
            }
            var info = _editingServer with
            {
                Label = _fsLabel.Trim(),
                DockerHost = _fsDockerHost.Trim(),
                GpuVendor = _fsGpuVendor,
                GpuVramTotalGb = _fsGpuVramTotalGb is > 0 ? _fsGpuVramTotalGb : null,
                HfCacheHostPath = string.IsNullOrWhiteSpace(_fsHfCache) ? null : _fsHfCache.Trim(),
                HfToken = string.IsNullOrWhiteSpace(_fsHfToken) ? null : _fsHfToken.Trim(),
            };
            await (_isCreatingServer ? Servers.CreateAsync(info) : Servers.UpdateAsync(info));
            _message = (_isCreatingServer ? "Created " : "Updated ") + info.Label;
            _editingServer = null;
            await ReloadServersAsync();
        }
        catch (Exception ex)
        {
            _error = "Save failed: " + ex.Message;
        }
        finally
        {
            _serverBusy = false;
        }
    }

    private async Task DeletePhysicalServerAsync(PhysicalServerInfo p)
    {
        var inUse = _sources.Any(s => s.PhysicalServerId == p.Id);
        if (inUse)
        {
            _error = $"Can't delete '{p.Label}' — one or more sources still run on it. Reassign or delete those first.";
            return;
        }
        var ok = await Dialogs.ConfirmAsync($"Delete physical server '{p.Label}'?", confirmText: "Delete");
        if (!ok) return;
        try
        {
            await Servers.DeleteAsync(p.Id);
            _message = "Deleted " + p.Label;
            await ReloadServersAsync();
        }
        catch (Exception ex)
        {
            _error = "Delete failed: " + ex.Message;
        }
    }

    private async Task OnWizardSavedAsync(SourceInfo saved)
    {
        _wizardOpen = false;
        _message = "Created " + saved.Label;
        await ReloadSourcesAsync();
    }

